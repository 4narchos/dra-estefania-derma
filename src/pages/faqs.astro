---
import Layout from "../layouts/Layout.astro";
import { getWhatsAppUrl, whatsappPresets, agendaUrl, consultationPrice } from "../data/site.js";
import { getBaseUrl } from "../utils/baseUrl.js";
import PillMenu from "../components/PillMenu.astro";
import FAQsPreview from "../components/FAQsPreview.astro";

const base = getBaseUrl();

const moreFaqItems = [
  {
    title: "¿Cómo debo prepararme para la consulta?",
    content: [
      "Para aprovechar tu consulta al máximo, sugerimos seguir estas indicaciones:",
    ],
    bullets: [
      "Si el motivo de consulta es en el rostro, asiste con la piel completamente limpia, sin maquillaje ni otros productos, ya que dificultan la valoración de las lesiones.",
      "Lleva una lista de productos o medicamentos que uses o hayas usado.",
      "Anota tus preguntas para asegurar que todas tus inquietudes sean abordadas durante la consulta.",
      "Llega a la hora programada. Tenemos un margen máximo de tolerancia de 15 minutos para asegurar la calidad de atención de todos los pacientes.",
    ],
  },
  {
    title: "¿A partir de qué edad reciben pacientes?",
    content: ["Atendemos pacientes de todas las edades."],
  },
  {
    title: "¿Cuánto dura una consulta?",
    content: [
      "La visita dermatológica tiene una duración de 30 minutos.",
      "Valoramos el tiempo de todos nuestros pacientes, por eso es muy importante que las consultas comiencen de forma puntual.",
      "Los procedimientos quirúrgicos o estéticos suelen ser más tardados; la duración depende de cada caso.",
    ],
  },
  {
    title: "¿Puedo remover una lesión (quiste, lunar, verruga) el mismo día de la consulta?",
    content: [
      "Todo procedimiento dermatológico requiere una valoración inicial para determinar qué tratamiento se adapta mejor a tu caso.",
      "Algunos casos pueden tratarse durante la misma sesión. Sin embargo, si la lesión requiere una intervención más compleja, el procedimiento se programará para una fecha posterior.",
    ],
  },
  {
    title: "¿Cuál es el costo de la consulta?",
    content: [`La valoración de especialidad tiene un costo de ${consultationPrice}.`],
  },
  {
    title: "Consulté y me surgió una duda sobre mi tratamiento, ¿dónde puedo resolverlas?",
    content: ["Puedes enviarme un mensaje. Con gusto resolveré tus dudas."],
    cta: {
      label: "Enviar mensaje",
      href: getWhatsAppUrl(whatsappPresets.webFaqsTratamiento),
    },
  },
];

const menuItems = [
  { label: "Ubicacion", href: `${base}ubicacion` },
  { label: "Reservar cita", href: agendaUrl, external: true, highlighted: true },
  { label: "Enviar mensaje", href: getWhatsAppUrl(whatsappPresets.webFaqsBottom), external: true },
];
---

<Layout
  title="Preguntas frecuentes · Dra. Estefanía Borges"
  description="Resuelve tus dudas sobre dermatología en Mérida con la Dra. Estefanía Borges."
  pageSchema="none"
>
  <section class="faqs-page">
    <div class="container">
      <div class="faqs-content">
        <h1 class="faqs-headline">Resuelve tus dudas antes de la consulta</h1>

        <FAQsPreview />

        <details class="faqs-more">
          <summary class="faqs-more-summary">
            <span>Más preguntas</span>
            <span class="faqs-more-icon" aria-hidden="true">
              <span class="icon-bar icon-bar-h" />
              <span class="icon-bar icon-bar-v" />
            </span>
          </summary>

          <div class="faqs-more-content">
            <div class="faqs-accordion">
              {
                moreFaqItems.map((item, index) => (
                  <div class={`faqs-accordion-item ${index === 0 ? "is-open" : ""}`}>
                    <h3 class="faqs-accordion-heading">
                      <button
                        type="button"
                        class="faqs-accordion-trigger"
                        aria-expanded={index === 0 ? "true" : "false"}
                        aria-controls={`faqs-more-panel-${index}`}
                        id={`faqs-more-trigger-${index}`}
                      >
                        <span>{item.title}</span>
                        <span class="faqs-accordion-icon" aria-hidden="true">
                          <span class="icon-bar icon-bar-h" />
                          <span class="icon-bar icon-bar-v" />
                        </span>
                      </button>
                    </h3>
                    <div
                      class="faqs-accordion-panel"
                      id={`faqs-more-panel-${index}`}
                      role="region"
                      aria-labelledby={`faqs-more-trigger-${index}`}
                    >
                      <div class="faqs-accordion-body">
                        {item.content.map((paragraph) => (
                          <p>{paragraph}</p>
                        ))}
                        {item.bullets && (
                          <ul class="faqs-bullets">
                            {item.bullets.map((bullet) => (
                              <li>{bullet}</li>
                            ))}
                          </ul>
                        )}
                        {item.cta && (
                          <p>
                            <a
                              href={item.cta.href}
                              class="faqs-body-link"
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              {item.cta.label}
                            </a>
                          </p>
                        )}
                      </div>
                    </div>
                  </div>
                ))
              }
            </div>
          </div>
        </details>

        <div class="faqs-menu">
          <PillMenu variant="contact" items={menuItems} ariaLabel="Acciones principales" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  (function () {
    // Accordion para "Más preguntas"
    const moreItems = document.querySelectorAll(
      ".faqs-more-content .faqs-accordion-item"
    ) as NodeListOf<HTMLElement>;

    const openMoreItem = (target: HTMLElement) => {
      moreItems.forEach((i) => {
        i.classList.remove("is-open");
        const btn = i.querySelector(
          ".faqs-accordion-trigger"
        ) as HTMLButtonElement;
        btn.setAttribute("aria-expanded", "false");
      });

      target.classList.add("is-open");
      const trigger = target.querySelector(
        ".faqs-accordion-trigger"
      ) as HTMLButtonElement;
      trigger.setAttribute("aria-expanded", "true");
    };

    moreItems.forEach((item) => {
      const trigger = item.querySelector(
        ".faqs-accordion-trigger"
      ) as HTMLButtonElement;

      trigger.addEventListener("click", () => {
        if (item.classList.contains("is-open")) {
          item.classList.remove("is-open");
          trigger.setAttribute("aria-expanded", "false");
        } else {
          openMoreItem(item);
        }
      });

      if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
        item.addEventListener("mouseenter", () => openMoreItem(item));
      }
    });
  })();
</script>

<style>
  .faqs-page {
    padding: var(--space-20) 0;
    background: var(--color-midnight);
    color: var(--color-text-on-dark);
    min-height: 60vh;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .faqs-content {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .faqs-headline {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
    font-weight: 600;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-8) 0;
    text-align: center;
  }

  /* Más preguntas */
  .faqs-more {
    margin-top: var(--space-8);
    border-top: 1px solid var(--color-border-inverse);
  }

  .faqs-more-summary {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    background: transparent;
    border: none;
    color: var(--color-text-on-dark);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    text-align: left;
    cursor: pointer;
    transition: color var(--transition-fast);
    list-style: none;
  }

  .faqs-more-summary::-webkit-details-marker {
    display: none;
  }

  .faqs-more-summary:hover {
    color: var(--color-accent);
  }

  .faqs-more-icon {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .faqs-more-icon .icon-bar {
    position: absolute;
    background: currentColor;
    transition: transform var(--transition-base);
  }

  .faqs-more-icon .icon-bar-h {
    width: 100%;
    height: 2px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }

  .faqs-more-icon .icon-bar-v {
    width: 2px;
    height: 100%;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .faqs-more[open] .faqs-more-icon .icon-bar-v {
    transform: translateX(-50%) scaleY(0);
  }

  .faqs-more-content {
    padding-top: var(--space-2);
  }

  /* Accordion dentro de Más preguntas */
  .faqs-more-content .faqs-accordion {
    border-top: 1px solid var(--color-border-inverse);
  }

  .faqs-more-content .faqs-accordion-item {
    border-bottom: 1px solid var(--color-border-inverse);
  }

  .faqs-more-content .faqs-accordion-heading {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  .faqs-more-content .faqs-accordion-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    background: transparent;
    border: none;
    color: var(--color-text-on-dark);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    text-align: left;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .faqs-more-content .faqs-accordion-trigger:hover {
    color: var(--color-accent);
  }

  .faqs-more-content .faqs-accordion-trigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-md);
  }

  .faqs-more-content .faqs-accordion-icon {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .faqs-more-content .icon-bar {
    position: absolute;
    background: currentColor;
    transition: transform var(--transition-base);
  }

  .faqs-more-content .icon-bar-h {
    width: 100%;
    height: 2px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }

  .faqs-more-content .icon-bar-v {
    width: 2px;
    height: 100%;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .faqs-more-content .faqs-accordion-item.is-open .icon-bar-v {
    transform: translateX(-50%) scaleY(0);
  }

  .faqs-more-content .faqs-accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--transition-base);
  }

  .faqs-more-content .faqs-accordion-item.is-open .faqs-accordion-panel {
    grid-template-rows: 1fr;
  }

  .faqs-more-content .faqs-accordion-body {
    overflow: hidden;
  }

  .faqs-more-content .faqs-accordion-body p {
    padding-bottom: var(--space-5);
    color: rgba(245, 245, 240, 0.8);
    line-height: var(--leading-relaxed);
    min-height: 1.5em;
  }

  .faqs-more-content .faqs-accordion-body p:last-child {
    padding-bottom: 0;
  }

  .faqs-more-content .faqs-bullets {
    list-style: disc;
    padding-left: var(--space-6);
    margin: 0 0 var(--space-5);
    color: rgba(245, 245, 240, 0.8);
    line-height: var(--leading-relaxed);
  }

  .faqs-more-content .faqs-bullets li {
    padding-bottom: var(--space-3);
  }

  .faqs-more-content .faqs-bullets li:last-child {
    padding-bottom: 0;
  }

  .faqs-more-content .faqs-body-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .faqs-more-content .faqs-body-link:hover {
    color: #fff;
  }

  .faqs-menu {
    align-self: center;
    margin-top: var(--space-8);
  }

  @media (max-width: 640px) {
    .faqs-headline {
      font-size: var(--text-2xl);
    }

    .faqs-more-summary,
    .faqs-more-content .faqs-accordion-trigger {
      font-size: var(--text-base);
      padding: var(--space-4) 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faqs-more-content .faqs-accordion-panel,
    .faqs-more-content .icon-bar,
    .faqs-more-content .faqs-accordion-trigger,
    .faqs-more-icon .icon-bar {
      transition: none;
    }
  }
</style>
