---
import Layout from "../layouts/Layout.astro";
import { getWhatsAppUrl, doctoraliaUrl } from "../data/site.js";
import { getBaseUrl } from "../utils/baseUrl.js";
import PillMenu from "../components/PillMenu.astro";
import LocationWidgetMain from "../components/LocationWidgetMain.astro";

const base = getBaseUrl();

const faqItems = [
  {
    title: "¿Qué incluye la consulta?",
    content: [
      "La consulta incluye una valoración médica completa, y un plan de tratamiento entregado en una receta médica que el paciente puede surtir donde guste.",
    ],
  },
  {
    title: "¿Dónde está el consultorio?",
    content: [],
    widget: "location",
  },
  {
    title: "¿Dónde puedo surtir mi receta?",
    content: [
      "Puedes surtir tu receta donde tú prefieras.",
      "En la clínica también contamos con una farmacia si el paciente decide surtirla en ese momento.",
    ],
  },
  {
    title: "¿Cómo debo prepararme para ir a la consulta?",
    content: [
      "Lleva una lista de tus productos favoritos y los que utilizas, anota tus preguntas y si es posible lleva fotos previas de tus lesiones.",
      "Si tu problema de la piel es en la cara, usar maquillaje dificulta la valoración. Lléva tu piel libre de productos.",
    ],
  },
  {
    title: "¿Cuáles son los horarios de atención?",
    content: [
      "Atendemos de 10 a 7pm de lunes a viernes.",
      "Es necesario sacar una cita previamente.",
    ],
  },
  {
    title: "¿A partir de qué edad recibe pacientes?",
    content: ["Vemos pacientes de todas las edades."],
  },
  {
    title: "¿Cuánto dura una consulta?",
    content: [
      "La consulta dura 30 minutos.",
      "Valoramos el tiempo de todos nuestros pacientes por lo que para nosotros es muy importante que las consultas siempre empiecen de forma puntual.",
      "Sin embargo hay casos extraordinarios, como podría ser el suyo, que requieren un poco más del tiempo previsto y podrían retrasar un poco la agenda. Agradecemos su comprensión.",
    ],
  },
  {
    title: "¿Puedo quitarme un quiste, lunar o verruga el mismo día de la consulta?",
    content: [
      "Hay lesiones simples que se puede programar una cirugía desde la primer valoración.",
      "Sin embargo, algunas lesiones requieren una valoración previa.",
    ],
  },
  {
    title: "¿Si tengo una duda o problema con mi receta dónde puedo preguntar?",
    content: ["Puedes enviarme un mensaje. Estaré encantada de resolver tus dudas."],
    cta: {
      label: "Enviar mensaje",
      href: getWhatsAppUrl({ medium: "faqs_receta", campaign: "faqs" }),
    },
  },
];

const menuItems = [
  { label: "Ubicaciones", href: `${base}ubicaciones` },
  { label: "Reservar cita", href: doctoraliaUrl, external: true, highlighted: true },
  { label: "Enviar mensaje", href: getWhatsAppUrl({ medium: "faqs_bottom", campaign: "faqs" }), external: true },
];
---

<Layout
  title="Preguntas frecuentes · Dra. Estefanía Borges"
  description="Resuelve tus dudas sobre dermatología en Mérida con la Dra. Estefanía Borges."
  pageSchema="none"
>
  <section class="faqs-page">
    <div class="container">
      <div class="faqs-content">
        <h2 class="faqs-title">Preguntas frecuentes</h2>
        <p class="faqs-subtitle">Resuelve tus dudas antes de la consulta</p>

        <div class="faqs-accordion">
          {
            faqItems.map((item, index) => (
              <div class={`faqs-accordion-item ${index === 0 ? "is-open" : ""}`}>
                <h3 class="faqs-accordion-heading">
                  <button
                    type="button"
                    class="faqs-accordion-trigger"
                    aria-expanded={index === 0 ? "true" : "false"}
                    aria-controls={`faqs-panel-${index}`}
                    id={`faqs-trigger-${index}`}
                  >
                    <span>{item.title}</span>
                    <span class="faqs-accordion-icon" aria-hidden="true">
                      <span class="icon-bar icon-bar-h" />
                      <span class="icon-bar icon-bar-v" />
                    </span>
                  </button>
                </h3>
                <div
                  class="faqs-accordion-panel"
                  id={`faqs-panel-${index}`}
                  role="region"
                  aria-labelledby={`faqs-trigger-${index}`}
                >
                  <div class="faqs-accordion-body">
                    {item.content.map((paragraph) => (
                      <p>{paragraph}</p>
                    ))}
                    {item.widget === "location" && <LocationWidgetMain />}
                    {item.cta && (
                      <p>
                        <a
                          href={item.cta.href}
                          class="faqs-body-link"
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          {item.cta.label}
                        </a>
                      </p>
                    )}
                  </div>
                </div>
              </div>
            ))
          }
        </div>

        <div class="faqs-menu">
          <PillMenu variant="contact" items={menuItems} ariaLabel="Acciones principales" />
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const items = document.querySelectorAll(
    ".faqs-accordion-item"
  ) as NodeListOf<HTMLElement>;

  const openItem = (target: HTMLElement) => {
    items.forEach((i) => {
      i.classList.remove("is-open");
      const btn = i.querySelector(
        ".faqs-accordion-trigger"
      ) as HTMLButtonElement;
      btn.setAttribute("aria-expanded", "false");
    });

    target.classList.add("is-open");
    const trigger = target.querySelector(
      ".faqs-accordion-trigger"
    ) as HTMLButtonElement;
    trigger.setAttribute("aria-expanded", "true");
  };

  items.forEach((item) => {
    const trigger = item.querySelector(
      ".faqs-accordion-trigger"
    ) as HTMLButtonElement;

    trigger.addEventListener("click", () => {
      if (item.classList.contains("is-open")) {
        item.classList.remove("is-open");
        trigger.setAttribute("aria-expanded", "false");
      } else {
        openItem(item);
      }
    });

    item.addEventListener("mouseenter", () => openItem(item));
  });
</script>

<style>
  .faqs-page {
    padding: var(--space-20) 0;
    background: var(--color-midnight);
    color: var(--color-text-on-dark);
    min-height: 60vh;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .faqs-content {
    max-width: 560px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
  }

  .faqs-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(var(--text-3xl), 5vw, var(--text-4xl));
    font-weight: 600;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-3) 0;
    text-align: center;
  }

  .faqs-subtitle {
    font-size: var(--text-lg);
    color: rgba(245, 245, 240, 0.8);
    text-align: center;
    margin: 0 0 var(--space-8) 0;
  }

  .faqs-accordion {
    border-top: 1px solid var(--color-border-inverse);
    margin-bottom: var(--space-8);
  }

  .faqs-accordion-item {
    border-bottom: 1px solid var(--color-border-inverse);
  }

  .faqs-accordion-heading {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  .faqs-accordion-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    background: transparent;
    border: none;
    color: var(--color-text-on-dark);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    text-align: left;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .faqs-accordion-trigger:hover {
    color: var(--color-accent);
  }

  .faqs-accordion-trigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-md);
  }

  .faqs-accordion-icon {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .icon-bar {
    position: absolute;
    background: currentColor;
    transition: transform var(--transition-base);
  }

  .icon-bar-h {
    width: 100%;
    height: 2px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }

  .icon-bar-v {
    width: 2px;
    height: 100%;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .faqs-accordion-item.is-open .icon-bar-v {
    transform: translateX(-50%) scaleY(0);
  }

  .faqs-accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--transition-base);
  }

  .faqs-accordion-item.is-open .faqs-accordion-panel {
    grid-template-rows: 1fr;
  }

  .faqs-accordion-body {
    overflow: hidden;
  }

  .faqs-accordion-body p {
    padding-bottom: var(--space-5);
    color: rgba(245, 245, 240, 0.8);
    line-height: var(--leading-relaxed);
    min-height: 1.5em;
  }

  .faqs-accordion-body p:last-child {
    padding-bottom: 0;
  }

  .faqs-body-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .faqs-body-link:hover {
    color: #fff;
  }

  .faqs-menu {
    align-self: center;
  }

  @media (max-width: 640px) {
    .faqs-title {
      font-size: var(--text-2xl);
    }

    .faqs-subtitle {
      font-size: var(--text-base);
    }

    .faqs-accordion-trigger {
      font-size: var(--text-base);
      padding: var(--space-4) 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faqs-accordion-panel,
    .icon-bar,
    .faqs-accordion-trigger {
      transition: none;
    }
  }
</style>
