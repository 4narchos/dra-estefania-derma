---
import { getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Presentation from "../components/Presentation.astro";
import Credentials from "../components/Credentials.astro";
import ServicesSection from "../components/ServicesSection.astro";
// import Philosophy from "../components/_archive/Philosophy.astro"; // archived section
import HomeIntroScrollMobile from "../components/HomeIntroScrollMobile.astro";
import ValueProposition from "../components/ValueProposition.astro";
import ReviewsSection from "../components/ReviewsSection.astro";
import ContactSection from "../components/ContactSection.astro";

import heroMelasmaMobile from "../assets/images/hero-melasma-mobile.webp";
import heroAcneMobile from "../assets/images/hero-acne-mobile.webp";

import { getBaseUrl } from "../utils/baseUrl.js";

const baseUrl = getBaseUrl();

const title = "Dermatóloga en Mérida · Tu piel te habla, y yo te ayudo a entenderla ✨";
const description = "Dermatóloga en Mérida. Especialista en tricología, acné y dermatología estética. Tu salud con resultados estéticos y naturales. Agenda tu cita aquí.";

// Precargar sólo los recursos críticos above-the-fold en mobile.
// Las imágenes del centro del collage son las más visibles junto al título.
const [melasmaImg, acneImg] = await Promise.all([
  getImage({ src: heroMelasmaMobile, width: 300, height: 300 }),
  getImage({ src: heroAcneMobile, width: 300, height: 300 }),
]);

const criticalPreloads = [
  {
    href: `${baseUrl}images/header banner.webp`,
    as: "image",
    type: "image/webp",
    media: "(max-width: 768px)",
    fetchpriority: "high",
  },
  {
    href: `${baseUrl}images/header banner desktop.webp`,
    as: "image",
    type: "image/webp",
    media: "(min-width: 769px)",
    fetchpriority: "high",
  },
  {
    href: melasmaImg.src,
    as: "image",
    type: "image/webp",
    media: "(max-width: 768px)",
    fetchpriority: "high",
  },
  {
    href: acneImg.src,
    as: "image",
    type: "image/webp",
    media: "(max-width: 768px)",
    fetchpriority: "high",
  },
];
---

<Layout title={title} description={description} pageSchema="home" criticalPreloads={criticalPreloads}>
  <div class="page-home">
    <div class="home-intro-desktop">
      <Hero />
      <Presentation />
    </div>
    <HomeIntroScrollMobile />
    <Credentials />
    <ServicesSection />
    {/* <Philosophy /> */}
    <ValueProposition />
    <ReviewsSection />
    <ContactSection />
  </div>
</Layout>

<style is:global>
  .page-home :is(h1, h2, h3, h4, h5, h6) {
    font-family: 'Junicode', Georgia, serif !important;
  }

  @media (max-width: 768px) {
    .home-intro-desktop {
      display: none;
    }
  }

  @media (min-width: 769px) {
    .home-intro-scroll-mobile {
      display: none !important;
    }
  }
</style>
