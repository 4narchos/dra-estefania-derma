      "END:VCARD"
    ].join("\r\n");

    const blob = new Blob([vCard], { type: "text/vcard;charset=utf-8" });
    const ua = navigator.userAgent || "";
    const isInAppBrowser = /Instagram|FB_IAB|FBAN|FBIOS|FBBV/i.test(ua);

    if (isInAppBrowser) {
      const file = new File([blob], "Dra-Mariana-Estefania-Garcia-Borges.vcf", { type: "text/vcard" });
      if (navigator.canShare && navigator.canShare({ files: [file] })) {
        navigator.share({ files: [file], title: "Dra. Mariana Estefanía García Borges" });
      }
      return;
    }

    const url = URL.createObjectURL(blob);
    const link = document.createElement("a");
    link.href = url;
    link.download = "Dra-Mariana-Estefania-Garcia-Borges.vcf";
    document.body.appendChild(link);
    link.click();
