</style>

<script>
  (function () {
    const triggers = document.querySelectorAll("[data-doctoralia-trigger]");
    const modal = document.getElementById("doctoralia-modal");
    const closeButtons = document.querySelectorAll("[data-doctoralia-close]");
    let showTimeout;

    function loadDoctoraliaWidget() {
      if (document.getElementById("zl-widget-s")) return;
      const script = document.createElement("script");
      script.id = "zl-widget-s";
      script.src = "https://platform.docplanner.com/js/widget.js";
      script.async = true;
      document.body.appendChild(script);
    }

    // Precarga el widget después de 3 segundos para mejorar la apertura en hover
    setTimeout(loadDoctoraliaWidget, 3000);

    if (triggers.length && modal) {
      const openModal = () => {
        clearTimeout(showTimeout);
        modal.classList.add("is-open");
        modal.setAttribute("aria-hidden", "false");
        document.body.style.overflow = "hidden";
        loadDoctoraliaWidget();
      };

      const startHoverTimer = () => {
        showTimeout = setTimeout(openModal, 1000);
      };

      const cancelHoverTimer = () => {
        clearTimeout(showTimeout);
      };

      triggers.forEach((trigger) => {
        trigger.addEventListener("mouseenter", startHoverTimer);
        trigger.addEventListener("mouseleave", cancelHoverTimer);
        trigger.addEventListener("focus", startHoverTimer);
        trigger.addEventListener("blur", cancelHoverTimer);

        trigger.addEventListener("click", (e) => {
          cancelHoverTimer();
          // Si el trigger es un enlace, deja que la navegación nativa ocurra
          if (trigger.tagName === "A") return;
          e.preventDefault();
          openModal();
        });
      });

      closeButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          modal.classList.remove("is-open");
          modal.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        });
      });

      modal.addEventListener("click", (e) => {
        if (e.target === modal) {
          modal.classList.remove("is-open");
          modal.setAttribute("aria-hidden", "true");
          document.body.style.overflow = "";
        }
      });
    }
  })();
</script>

<script>
  (function () {
    const openBtn = document.querySelector("[data-intro-open]");
    const modal = document.getElementById("intro-modal");
    const closeTriggers = document.querySelectorAll("[data-intro-close]");

    if (!openBtn || !modal) return;

    const openModal = () => {
      modal.classList.add("is-open");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      modal.querySelector(".intro-modal-close")?.focus();
      if (!modal.classList.contains("has-opened")) {
        setTimeout(() => modal.classList.add("has-opened"), 600);
      }
      if (!modal.classList.contains("has-animated")) {
        setTimeout(() => modal.classList.add("has-animated"), 3000);
      }
    };

    const closeModal = () => {
      modal.classList.remove("is-open");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      openBtn.focus();
    };

    openBtn.addEventListener("click", openModal);

    closeTriggers.forEach((trigger) => {
      trigger.addEventListener("click", closeModal);
    });

    modal.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && modal.classList.contains("is-open")) {
        closeModal();
      }
    });
  })();
</script>

<script is:inline>
  (function () {
    const location = document.querySelector(".contact-location");
    const toggle = document.querySelector("[data-location-toggle]");
    const panel = toggle?.nextElementSibling;
    if (!location || !toggle || !panel) return;

    const open = () => {
      panel.classList.add("is-open");
      toggle.setAttribute("aria-expanded", "true");
    };

    const close = () => {
      panel.classList.remove("is-open");
      toggle.setAttribute("aria-expanded", "false");
    };

    toggle.addEventListener("click", (e) => {
      e.stopPropagation();
      if (panel.classList.contains("is-open")) {
        close();
      } else {
        open();
      }
    });

    document.addEventListener("click", (e) => {
      if (!location.contains(e.target)) close();
    });
  })();
</script>

<script>
  (function () {
    const tooltip = document.querySelector(".contact-handle-tooltip");
    const handle = tooltip?.querySelector(".contact-handle");
    if (!tooltip || !handle) return;

    const open = () => {
      tooltip.classList.add("is-open");
      handle.setAttribute("aria-expanded", "true");
    };

    const close = () => {
      tooltip.classList.remove("is-open");
      handle.setAttribute("aria-expanded", "false");
    };

    handle.addEventListener("click", (e) => {
      e.stopPropagation();
      if (tooltip.classList.contains("is-open")) {
        close();
      } else {
        open();
      }
    });

    document.addEventListener("click", (e) => {
      if (!tooltip.contains(e.target)) close();
    });
  })();
</script>

