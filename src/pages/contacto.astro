  }

  .doctoralia-modal-body {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 200px;
  }

  .doctoralia-modal-body .zl-url:empty::before {
    content: "Cargando calendario…";
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
  }

  .doctoralia-modal-body .zl-url {
    text-decoration: none;
  }

  .intro-modal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    padding-top: calc(var(--space-4) + env(safe-area-inset-top, 0px));
    height: 100vh;
    height: 100dvh;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-fast), visibility var(--transition-fast);
  }

  .intro-modal.is-open {
    opacity: 1;
    visibility: visible;
  }

  .intro-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
  }

  .intro-modal-content {
    position: relative;
    width: 100%;
    max-width: 680px;
    max-height: calc(100vh - 2rem);
    max-height: calc(100dvh - 2rem);
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
    overflow-y: auto;
    overflow-x: hidden;
    padding: var(--space-8) var(--space-6);
    z-index: 1;
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .intro-modal:not(.has-opened) .intro-modal-content {
    opacity: 0;
    transform: translateY(24px) scale(0.96);
  }

  .intro-modal.is-open .intro-modal-content {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .intro-modal-close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #F0EBE0;
    border: none;
    border-radius: 999px;
    cursor: pointer;
    color: var(--color-text-primary);
    transition: background var(--transition-fast);
    z-index: 10;
  }

  .intro-modal-close:hover {
    background: #E6E3DB;
  }

  .intro-modal-body {
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .intro-modal-text p {
    margin-bottom: var(--space-4);
  }

  .intro-modal.is-open:not(.has-animated) .intro-modal-text p:not(.lema-headline--modal) {
    opacity: 0;
    animation: intro-text-fade 0.4s ease-out forwards;
  }

  .intro-modal.is-open:not(.has-animated) .intro-modal-text p:not(.lema-headline--modal):nth-of-type(2) { animation-delay: 2.00s; }
  .intro-modal.is-open:not(.has-animated) .intro-modal-text p:not(.lema-headline--modal):nth-of-type(3) { animation-delay: 2.10s; }
  .intro-modal.is-open:not(.has-animated) .intro-modal-text p:not(.lema-headline--modal):nth-of-type(4) { animation-delay: 2.20s; }
  .intro-modal.is-open:not(.has-animated) .intro-modal-text p:not(.lema-headline--modal):nth-of-type(5) { animation-delay: 2.30s; }
  .intro-modal.is-open:not(.has-animated) .intro-modal-text p.intro-modal-closing { animation-delay: 2.40s; }

  .intro-modal.has-animated .intro-modal-text p:not(.lema-headline--modal) {
    opacity: 1;
  }

  @keyframes intro-text-fade {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
