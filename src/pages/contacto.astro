---
import Layout from "../layouts/Layout.astro";
import { whatsappBaseUrl } from "../data/links.js";
import { getBaseUrl } from "../utils/baseUrl.js";

const base = getBaseUrl();
const title = "Contacto | Dra. Estefanía";
const description = "Agenda tu consulta dermatológica con la Dra. Mariana Estefanía García Borges en Mérida, Izamal, Valladolid o Vaca. También disponible en Doctoralia.";

const whatsappUrl = `${whatsappBaseUrl}&utm_source=web&utm_medium=contacto_page&utm_campaign=agendar`;

const locationLinks = [
  {
    name: "Baca",
    url: `${whatsappBaseUrl}&utm_source=web&utm_medium=contacto_page&utm_campaign=baca`,
  },
  {
    name: "Izamal",
    url: `${whatsappBaseUrl}&utm_source=web&utm_medium=contacto_page&utm_campaign=izamal`,
  },
  {
    name: "Valladolid",
    url: `${whatsappBaseUrl}&utm_source=web&utm_medium=contacto_page&utm_campaign=valladolid`,
  },
];

const socialLinks = [
  {
    name: "Instagram",
    url: "https://instagram.com/dra.estefaniaderma",
    icon: "instagram",
    active: true,
  },
  {
    name: "Facebook",
    url: "#",
    icon: "facebook",
    active: false,
  },
  {
    name: "TikTok",
    url: "#",
    icon: "tiktok",
    active: false,
  },
  {
    name: "YouTube",
    url: "#",
    icon: "youtube",
    active: false,
  },
];
---

<Layout title={title} description={description} pageSchema="contact" showWhatsApp={false}>
  <section class="contact-page">
    <div class="contact-container">
      <div class="contact-profile">
        <div class="contact-avatar">
          <img
            src={`${base}images/dra-estefania.jpg`}
            alt="Dra. Mariana Estefanía García Borges"
            class="contact-avatar-img"
            loading="eager"
            width="96"
            height="96"
          />
        </div>
        <h1 class="contact-name">Dra. Estefanía Borges</h1>
        <p class="contact-handle">@dra.estefaniaderma</p>
        <p class="contact-bio">Dermatóloga · Yucatán · 4 ubicaciones</p>
      </div>

      {/* Sección Profesional */}
      <div class="contact-section">
        <h2 class="contact-section-title">Agendar consulta</h2>

        <a href={whatsappUrl} class="contact-link contact-link--primary" target="_blank" rel="noopener noreferrer">
          <span class="contact-link-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </span>
          <span class="contact-link-text">WhatsApp</span>
        </a>

        <div class="contact-subgroup">
          <p class="contact-subgroup-label">Otras ubicaciones</p>
          <div class="contact-subgroup-buttons">
            {locationLinks.map((loc) => (
              <a
                href={loc.url}
                class="contact-link contact-link--small"
                target="_blank"
                rel="noopener noreferrer"
              >
                {loc.name}
              </a>
            ))}
          </div>
        </div>

        <a
          href="https://www.doctoralia.com.mx/mariana-estefania-garcia-borges-2/dermatologo/yucatan"
          class="contact-link contact-link--secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="contact-link-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21V5a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5"/></svg>
          </span>
          <span class="contact-link-text">Doctoralia</span>
        </a>
      </div>

      {/* Sección Redes */}
      <div class="contact-section">
        <h2 class="contact-section-title">Redes sociales</h2>
        <div class="contact-social-grid">
          {socialLinks.map((social) => (
            <a
              href={social.url}
              class:list={["contact-social-link", !social.active && "contact-social-link--inactive"]}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="contact-social-icon">
                {social.icon === "instagram" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                )}
                {social.icon === "facebook" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                )}
                {social.icon === "tiktok" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
                )}
                {social.icon === "youtube" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.1C5.12 19.56 12 19.56 12 19.56s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
                )}
              </span>
              <span class="contact-social-name">{social.name}</span>
            </a>
          ))}
        </div>
      </div>

      <footer class="contact-footer">
        <p>Dra. Mariana Estefanía García Borges</p>
        <p class="contact-footer-small">Dermatóloga · Yucatán, México</p>
      </footer>
    </div>
  </section>
</Layout>

<style>
  .contact-page {
    min-height: 100vh;
    padding: var(--space-10) var(--space-4);
    background: var(--color-background);
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .contact-container {
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }

  .contact-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .contact-avatar {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 2px solid var(--color-border-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-3);
    overflow: hidden;
  }

  .contact-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-name {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
  }

  .contact-handle {
    font-size: var(--text-sm);
    color: var(--color-primary);
    font-weight: var(--weight-medium);
  }

  .contact-bio {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .contact-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-section-title {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-align: center;
    margin-bottom: var(--space-1);
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast), transform var(--transition-fast), background var(--transition-fast);
    font-weight: var(--weight-semibold);
    font-size: var(--text-base);
  }

  .contact-link:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  .contact-link--primary {
    background: var(--color-primary);
    border: 1px solid var(--color-primary);
    color: var(--color-text-on-primary);
  }

  .contact-link--primary:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }

  .contact-link--secondary {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
  }

  .contact-link--secondary:hover {
    border-color: var(--color-border-strong);
    background: var(--color-background);
  }

  .contact-link--small {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    color: var(--color-text-primary);
    padding: var(--space-3) var(--space-4);
    font-size: var(--text-sm);
    justify-content: center;
    flex: 1;
  }

  .contact-link--small:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .contact-link-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .contact-link-text {
    flex: 1;
  }

  .contact-subgroup {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .contact-subgroup-label {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }

  .contact-subgroup-buttons {
    display: flex;
    gap: var(--space-2);
  }

  .contact-social-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .contact-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-3);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--color-text-primary);
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .contact-social-link:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .contact-social-link--inactive {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .contact-social-link--inactive:hover {
    transform: none;
    border-color: var(--color-border);
  }

  .contact-social-icon {
    display: flex;
    align-items: center;
  }

  .contact-footer {
    text-align: center;
    padding-top: var(--space-6);
  }

  .contact-footer p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .contact-footer-small {
    margin-top: var(--space-1);
    opacity: 0.7;
  }
</style>
