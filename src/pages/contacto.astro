  .intro-modal.is-open:not(.has-animated) .lema-line--2 .lema-word:nth-child(1) { animation-delay: 1.10s; }
  .intro-modal.is-open:not(.has-animated) .lema-line--2 .lema-word:nth-child(2) { animation-delay: 1.18s; }
  .intro-modal.is-open:not(.has-animated) .lema-line--2 .lema-word:nth-child(3) { animation-delay: 1.26s; }
  .intro-modal.is-open:not(.has-animated) .lema-line--2 .lema-word:nth-child(4) { animation-delay: 1.34s; }
  .intro-modal.is-open:not(.has-animated) .lema-line--2 .lema-word:nth-child(5) { animation-delay: 1.42s; }
  .intro-modal.is-open:not(.has-animated) .lema-line--2 .lema-word:nth-child(6) { animation-delay: 1.50s; }

  @keyframes lema-blur-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: scale(1.02);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
