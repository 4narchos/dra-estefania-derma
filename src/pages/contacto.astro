---
import Layout from "../layouts/Layout.astro";
import { whatsappBaseUrl } from "../data/links.js";
import { getBaseUrl } from "../utils/baseUrl.js";

const base = getBaseUrl();
const title = "Contacto | Dra. Estefanía";
const description = "Agenda tu consulta dermatológica con la Dra. Mariana Estefanía García Borges en Mérida, Yucatán. También disponible en Doctoralia.";

const whatsappUrl = `${whatsappBaseUrl}&utm_source=web&utm_medium=contacto_page&utm_campaign=agendar`;

const socialLinks = [
  {
    name: "Instagram",
    url: "https://instagram.com/dra.estefaniaderma",
    icon: "instagram",
    active: true,
  },
  {
    name: "Facebook",
    url: "#",
    icon: "facebook",
    active: false,
  },
  {
    name: "TikTok",
    url: "#",
    icon: "tiktok",
    active: false,
  },
];
---

<Layout title={title} description={description} pageSchema="contact" showWhatsApp={false}>
  <section class="contact-page">
    <div class="contact-container">
      <div class="contact-profile">
        <div class="contact-avatar">
          <img
            src={`${base}images/dra-estefania-dermatoscopio.jpg`}
            alt="Dra. Mariana Estefanía García Borges"
            class="contact-avatar-img"
            loading="eager"
            width="96"
            height="96"
          />
        </div>
        <a href="https://instagram.com/dra.estefaniaderma" class="contact-handle" target="_blank" rel="noopener noreferrer">@dra.estefaniaderma</a>
        <p class="contact-bio">Dermatóloga en Yucatán 🧴</p>
        <p class="contact-motto">Tu piel te habla, yo te ayudo a entenderla ✨</p>
      </div>

      {/* Sección Profesional */}
      <div class="contact-section">
        <h2 class="contact-section-title">Agendar consulta</h2>

        <div class="contact-links-row">
          <a href={whatsappUrl} class="contact-link contact-link--primary" target="_blank" rel="noopener noreferrer">
            <span class="contact-link-icon">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path fill="#25D366" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </span>
            <span class="contact-link-text">WhatsApp</span>
          </a>

          <a
            href="https://www.doctoralia.com.mx/mariana-estefania-garcia-borges-2/dermatologo/yucatan"
            class="contact-link contact-link--secondary"
            target="_blank"
            rel="noopener noreferrer"
          >
            <img src={`${base}images/doctoralia-logo.png`} alt="Doctoralia" class="contact-link-logo" loading="lazy" height="24" />
          </a>
        </div>
      </div>

      {/* Sección Redes */}
      <div class="contact-section">
        <h2 class="contact-section-title">Redes sociales</h2>
        <div class="contact-social-grid">
          {socialLinks.map((social) => (
            social.active ? (
              <a
                href={social.url}
                class="contact-social-link"
                target="_blank"
                rel="noopener noreferrer"
              >
                <span class="contact-social-icon">
                  {social.icon === "instagram" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                  )}
                  {social.icon === "facebook" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                  )}
                  {social.icon === "tiktok" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
                  )}
                </span>
                <span class="contact-social-name">{social.name}</span>
              </a>
            ) : (
              <span class="contact-social-link contact-social-link--inactive">
                <span class="contact-social-icon">
                  {social.icon === "instagram" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
                  )}
                  {social.icon === "facebook" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                  )}
                  {social.icon === "tiktok" && (
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
                  )}
                </span>
                <span class="contact-social-name">Pronto</span>
              </span>
            )
          ))}
        </div>
      </div>

      <footer class="contact-footer">
        <p>Dra. Mariana Estefanía García Borges</p>
        <p class="contact-footer-small">Dermatóloga · Yucatán, México</p>
      </footer>
    </div>
  </section>
</Layout>

<style>
  .contact-page {
    min-height: 100vh;
    padding: var(--space-10) var(--space-4);
    background: var(--color-background);
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .contact-container {
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
    position: relative;
  }

  .contact-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
  }

  .contact-avatar {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 2px solid var(--color-border-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-3);
    overflow: hidden;
  }

  .contact-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .contact-handle {
    font-size: var(--text-sm);
    color: #1D5A8F;
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .contact-handle:hover {
    text-decoration: underline;
  }

  .contact-bio {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .contact-motto {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    font-style: italic;
    opacity: 0.85;
    margin-top: var(--space-1);
  }

  .contact-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact-section-title {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    text-align: center;
    margin-bottom: var(--space-1);
  }

  .contact-links-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    width: 100%;
  }

  .contact-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-2);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: border-color var(--transition-fast), transform var(--transition-fast), background var(--transition-fast);
    font-weight: var(--weight-semibold);
    font-size: var(--text-base);
    text-align: center;
    border: none;
    background: none;
    cursor: pointer;
    width: 100%;
    font-family: inherit;
  }

  .contact-link:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  .contact-link--primary {
    background: #000C1E;
    border: 1px solid #000C1E;
    color: #fff;
  }

  .contact-link--primary:hover {
    background: #00152E;
    border-color: #00152E;
  }

  .contact-link--primary .contact-link-text {
    font-size: 1.35rem;
  }

  .contact-link--secondary {
    background: #000C1E;
    border: 1px solid #000C1E;
    color: #fff;
  }

  .contact-link--secondary:hover {
    background: #00152E;
    border-color: #00152E;
  }

  .contact-link-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .contact-link-logo {
    height: 24px;
    width: auto;
    display: block;
  }

  .contact-social-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }

  .contact-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-3);
    background: #000C1E;
    border: 1px solid #000C1E;
    border-radius: var(--radius-md);
    text-decoration: none;
    color: #fff;
    font-weight: var(--weight-medium);
    font-size: var(--text-sm);
    transition: background var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
  }

  .contact-social-link:hover {
    background: #00152E;
    border-color: #00152E;
    transform: translateY(-1px);
    text-decoration: none;
  }

  .contact-social-link--inactive {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .contact-social-link--inactive:hover {
    transform: none;
    border-color: var(--color-border);
  }

  .contact-social-icon {
    display: flex;
    align-items: center;
  }

  .contact-footer {
    text-align: center;
    padding-top: var(--space-6);
  }

  .contact-footer p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .contact-footer-small {
    margin-top: var(--space-1);
    opacity: 0.7;
  }
</style>
