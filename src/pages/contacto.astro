  .intro-modal.is-open:not(.has-animated) .lema-line--1 .lema-word:nth-child(3) { animation-delay: 0.19s; }
  .intro-modal.is-open:not(.has-animated) .lema-line--1 .lema-word:nth-child(4) { animation-delay: 0.26s; }

  .intro-modal.is-open:not(.has-animated) .lema-line--2 .lema-word {
    animation: lema-blur-in 0.4s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
