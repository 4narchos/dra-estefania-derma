---
import Layout from "../layouts/Layout.astro";
import { links, whatsappBaseUrl } from "../data/links.js";

const title = "Contacto | Dra. Estefanía — Links";
const description = "Todos los links de contacto de la Dra. Mariana Estefanía García Borges. Agenda tu consulta por WhatsApp, Doctoralia, o directamente por teléfono.";

const highlightedLinks = links.filter((l) => l.highlighted);
const regularLinks = links.filter((l) => !l.highlighted);
---

<Layout title={title} description={description} pageSchema="contact" showWhatsApp={false}>
  <section class="linktree">
    <div class="linktree-container">
      <div class="linktree-profile">
        <div class="linktree-avatar">
          <span class="linktree-avatar-icon">🌿</span>
        </div>
        <h1 class="linktree-name">Dra. Mariana Estefanía</h1>
        <p class="linktree-handle">@dra.estefaniaderma</p>
        <p class="linktree-bio">Dermatóloga · Mérida, Yucatán · 4 ubicaciones</p>
      </div>

      <div class="linktree-links">
        {highlightedLinks.map((link) => (
          <a
            href={link.url}
            class="linktree-link linktree-link--highlight"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="linktree-link-icon">{link.icon}</span>
            <span class="linktree-link-text">
              <span class="linktree-link-title">{link.title}</span>
              <span class="linktree-link-desc">{link.description}</span>
            </span>
          </a>
        ))}

        {regularLinks.map((link) => (
          <a
            href={link.url}
            class="linktree-link"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="linktree-link-icon">{link.icon}</span>
            <span class="linktree-link-text">
              <span class="linktree-link-title">{link.title}</span>
              <span class="linktree-link-desc">{link.description}</span>
            </span>
          </a>
        ))}
      </div>

      <div class="linktree-phone">
        <a href={`tel:+52-999-221-3021`} class="linktree-phone-link">
          📞 999 221 3021
        </a>
      </div>

      <footer class="linktree-footer">
        <p>Dra. Mariana Estefanía García Borges</p>
        <p class="linktree-footer-small">Dermatóloga · Yucatán, México</p>
      </footer>
    </div>
  </section>
</Layout>

<style>
  .linktree {
    min-height: 100vh;
    padding: var(--space-10) var(--space-4);
    background: var(--color-background);
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .linktree-container {
    width: 100%;
    max-width: 480px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .linktree-profile {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .linktree-avatar {
    width: 96px;
    height: 96px;
    border-radius: var(--radius-full);
    background: var(--color-surface);
    border: 2px solid var(--color-border-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: var(--space-3);
  }

  .linktree-avatar-icon {
    font-size: var(--text-4xl);
  }

  .linktree-name {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
  }

  .linktree-handle {
    font-size: var(--text-sm);
    color: var(--color-accent);
    font-weight: var(--weight-medium);
  }

  .linktree-bio {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .linktree-links {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .linktree-link {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: border-color var(--transition-fast), transform var(--transition-fast);
  }

  .linktree-link:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .linktree-link--highlight {
    background: var(--color-primary);
    border-color: var(--color-primary);
  }

  .linktree-link--highlight:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
  }

  .linktree-link--highlight .linktree-link-title,
  .linktree-link--highlight .linktree-link-desc {
    color: var(--color-text-on-primary);
  }

  .linktree-link-icon {
    font-size: var(--text-xl);
    flex-shrink: 0;
  }

  .linktree-link-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .linktree-link-title {
    font-weight: var(--weight-semibold);
    font-size: var(--text-base);
    color: var(--color-text-primary);
  }

  .linktree-link-desc {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .linktree-phone {
    width: 100%;
    text-align: center;
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .linktree-phone-link {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    color: var(--color-accent);
  }

  .linktree-phone-link:hover {
    color: var(--color-accent-alt);
  }

  .linktree-footer {
    text-align: center;
    padding-top: var(--space-6);
  }

  .linktree-footer p {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .linktree-footer-small {
    margin-top: var(--space-1);
    opacity: 0.7;
  }
</style>
