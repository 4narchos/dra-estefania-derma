---
import Layout from "../layouts/Layout.astro";
import AgendaCard from "../components/AgendaCard.astro";

const title = "Agenda tu cita · Dra. Estefanía Borges";
const description = "Reserva tu consulta dermatológica con la Dra. Estefanía Borges en Mérida, Yucatán.";
---

<Layout title={title} description={description} pageSchema="contact" showWhatsApp={false}>
  <section class="agenda-page">
    <AgendaCard />
  </section>
</Layout>

<!-- Event snippet for Reservar cita conversion page -->
<script is:inline>
  if (typeof gtag === 'function') {
    gtag('event', 'conversion', {'send_to': 'AW-18382685612/elC7CPOOgeAcEKyLxr1E'});
  }
</script>

<style>
  .agenda-page {
    min-height: var(--viewport-minus-header);
    padding: var(--space-6) var(--space-4);
    background: var(--color-background);
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  @media (min-width: 641px) {
    .agenda-page {
      padding: var(--space-10) var(--space-6);
    }
  }
</style>
