---
import Layout from "../layouts/Layout.astro";
import DoctoraliaCalendarWidget from "../components/DoctoraliaCalendarWidget.astro";
import { getWhatsAppUrl, whatsappPresets } from "../data/site.js";

const title = "Agenda tu cita · Dra. Estefanía Borges";
const description = "Reserva tu consulta dermatológica con la Dra. Estefanía Borges en Mérida, Yucatán.";
const whatsappUrl = getWhatsAppUrl(whatsappPresets.webAgenda);
---

<Layout title={title} description={description} pageSchema="contact" showWhatsApp={false}>
  <section class="agenda-page">
    <div class="agenda-container">
      <h1 class="agenda-title">Agenda tu cita</h1>
      <p class="agenda-subtitle">Selecciona el horario que prefieras. Si tienes alguna duda o requieres asistencia, no dudes en enviarnos un <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="agenda-link">mensaje</a>.</p>
      <div class="agenda-widget">
        <DoctoraliaCalendarWidget />
      </div>
    </div>
  </section>
</Layout>

<style>
  .agenda-page {
    min-height: var(--viewport-minus-header);
    padding: var(--space-10) var(--space-4);
    background: var(--color-background);
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .agenda-container {
    width: 100%;
    max-width: 720px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .agenda-title {
    font-family: "Junicode", Georgia, serif;
    font-size: clamp(var(--text-2xl), 5vw, var(--text-3xl));
    font-weight: 600;
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    margin: 0;
    text-align: center;
  }

  .agenda-subtitle {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    text-align: center;
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .agenda-link {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-fast);
  }

  .agenda-link:hover {
    color: var(--color-primary-hover);
  }

  .agenda-widget {
    width: 100%;
    margin-top: var(--space-4);
    display: flex;
    justify-content: center;
  }
</style>
