---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { services } from "../data/services.js";

const title = "Servicios Dermatológicos | Dra. Estefanía";
const description = "Tratamientos dermatológicos personalizados en Mérida, Yucatán. Acné, melasma, rejuvenecimiento facial, Botox, peeling químico, Hydrafacial, depilación láser y dermatoscopía.";
---

<Layout title={title} description={description} pageSchema="services">
  <section class="services-hero">
    <div class="container">
      <span class="services-badge">Tratamientos</span>
      <h1 class="services-title">Servicios dermatológicos</h1>
      <p class="services-intro">
        Cada piel es diferente. Diseño protocolos personalizados basados en tu tipo de piel,
        condición y el clima específico de Yucatán.
      </p>
    </div>
  </section>

  <section class="services-list">
    <div class="container">
      <div class="services-grid">
        {services.map((service, index) => (
          <article class="service-card">
            <div class="service-header">
              <span class="service-number">{String(index + 1).padStart(2, "0")}</span>
              <span class="service-icon">{service.icon}</span>
            </div>
            <h2 class="service-name">{service.name}</h2>
            <p class="service-description">{service.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="services-cta">
    <div class="container">
      <div class="cta-box">
        <h2 class="cta-title">¿No sabes qué tratamiento necesitas?</h2>
        <p class="cta-text">
          Agenda una consulta de evaluación. Te ayudo a identificar la mejor opción para tu piel.
        </p>
        <a
          href={`${import.meta.env.BASE_URL}contacto`}
          class="btn btn-primary btn-large"
        >
          Agendar consulta
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .services-hero {
    padding: var(--space-20) 0 var(--space-12);
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .services-badge {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-text-on-accent);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    margin-bottom: var(--space-6);
  }

  .services-title {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .services-intro {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 36rem;
  }

  .services-list {
    padding: var(--space-20) 0;
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .service-card {
    background: var(--color-background);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    transition: border-color var(--transition-fast);
  }

  .service-card:hover {
    border-color: var(--color-border-strong);
  }

  .service-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }

  .service-number {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-text-muted);
    font-family: var(--font-heading);
  }

  .service-icon {
    font-size: var(--text-2xl);
  }

  .service-name {
    font-size: var(--text-xl);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .service-description {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .services-cta {
    padding: var(--space-20) 0;
    background: var(--color-background);
  }

  .cta-box {
    background: var(--color-surface);
    padding: var(--space-12) var(--space-8);
    border-radius: var(--radius-lg);
    text-align: center;
    border: 1px solid var(--color-border);
    max-width: 48rem;
    margin: 0 auto;
  }

  .cta-title {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .cta-text {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
    line-height: var(--leading-relaxed);
  }
</style>
