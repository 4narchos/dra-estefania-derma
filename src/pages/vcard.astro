---
const vcfUrl = "/dra-estefania-derma.vcf";
const homeUrl = "/";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Agregar contacto · Dra. Estefanía Borges</title>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: #f9f8f5;
        color: #4a4a4a;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        text-align: center;
      }
      a {
        color: #325c46;
      }
    </style>
  </head>
  <body>
    <div>
      <p>Abriendo tarjeta de contacto…</p>
      <p>
        <a href={vcfUrl} download="Agregar contacto.vcf" id="vcard-link">
          Si no se abre automáticamente, toca aquí.
        </a>
      </p>
    </div>
    <script define:vars={{ vcfUrl, homeUrl }}>
      (function () {
        function triggerDownload() {
          var link = document.createElement("a");
          link.href = vcfUrl;
          link.download = "Agregar contacto.vcf";
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        }

        function redirectHome() {
          window.location.href = homeUrl;
        }

        function downloadAndRedirect() {
          triggerDownload();
          setTimeout(redirectHome, 1500);
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", downloadAndRedirect);
        } else {
          downloadAndRedirect();
        }

        var fallback = document.getElementById("vcard-link");
        if (fallback) {
          fallback.addEventListener("click", function () {
            setTimeout(redirectHome, 1500);
          });
        }
      })();
    </script>
  </body>
</html>
