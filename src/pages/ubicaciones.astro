---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { locations } from "../data/locations.js";
---

<Layout
  title="Ubicaciones · Dra. Estefanía Borges"
  description="Consultorios de dermatología en Mérida, Valladolid, Izamal y Baca."
  pageSchema="none"
>
  <section class="locations-page">
    <div class="container">
      <SectionHeader
        title="Ubicaciones"
        subtitle="Encuentra el consultorio más cercano."
        align="center"
      />

      <div class="locations-grid">
        {
          locations.map((loc) => (
            <article class="cta-card">
              <h2 class="cta-card-title">{loc.name}</h2>

              <p class="cta-card-subtitle">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="cta-card-location-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                {loc.city}
              </p>

              <p class="location-detail">{loc.address}</p>
              <p class="location-detail location-detail--hours">{loc.hours}</p>

              <a
                href={`tel:${loc.phone.replace(/\s/g, "")}`}
                class="cta-card-footer location-footer"
              >
                <span class="cta-card-price">{loc.phone}</span>
                <span class="cta-card-button">Llamar</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>

<style>
  .locations-page {
    padding: var(--space-20) 0;
    background: var(--color-background);
    min-height: 60vh;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .locations-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-4);
    align-items: stretch;
  }

  @media (max-width: 1100px) {
    .locations-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .locations-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Same style as .contact-content-top / .cta-card */
  .cta-card {
    position: relative;
    width: 100%;
    padding: 1.5rem 1rem;
    background: #1a2332;
    border-radius: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    z-index: 20;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15),
      0 10px 10px -5px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .cta-card::after {
    content: "";
    position: absolute;
    height: 100%;
    width: 100%;
    inset: 0;
    background: #243447;
    z-index: -20;
    border-radius: 0.75rem;
    transform: translateY(100%);
    transition: all 0.5s ease;
  }

  .cta-card:hover::after {
    transform: translateY(0);
  }

  .cta-card-title {
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.03em;
    font-size: 1.0625rem;
    line-height: 1.25;
    margin: 0;
    text-align: center;
    transition: color 0.3s ease;
  }

  .cta-card-subtitle {
    font-weight: 600;
    color: #ffffff;
    font-size: 0.875rem;
    margin: 0;
    transition: color 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .cta-card-location-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .location-detail {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.8125rem;
    line-height: 1.5;
    margin: 0;
    text-align: center;
    white-space: pre-line;
  }

  .location-detail--hours {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.75rem;
  }

  .cta-card-footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: 0.5rem;
    gap: 0.5rem;
    text-decoration: none;
  }

  .cta-card-price {
    color: #abd373;
    font-weight: 700;
    font-size: 0.9375rem;
    margin: 0;
    transition: color 0.3s ease;
    white-space: nowrap;
  }

  .cta-card:hover .cta-card-price {
    color: #ffffff;
  }

  .cta-card-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #2d5e46;
    color: #ffffff;
    padding: 0.5rem 0.875rem;
    font-size: 0.8125rem;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .cta-card:hover .cta-card-button {
    background: #3a7a5a;
  }

  @media (max-width: 640px) {
    .cta-card {
      padding: 2rem 1.5rem;
      gap: 0.75rem;
    }

    .cta-card-title {
      font-size: 1.25rem;
    }

    .cta-card-subtitle {
      font-size: 0.9375rem;
      gap: 0.5rem;
    }

    .location-detail {
      font-size: 0.875rem;
    }

    .location-detail--hours {
      font-size: 0.8125rem;
    }

    .cta-card-footer {
      gap: 0.75rem;
      margin-top: 0.75rem;
    }

    .cta-card-price {
      font-size: 1rem;
    }

    .cta-card-button {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-card,
    .cta-card::after,
    .cta-card-title,
    .cta-card-subtitle,
    .cta-card-price,
    .cta-card-button {
      transition: none;
    }
  }
</style>
