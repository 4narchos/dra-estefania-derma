---
interface Props {
  src: string;
  title?: string;
}

const { src, title = "Ubicación en Google Maps" } = Astro.props;
---

<div class="map-widget">
  <iframe
    src={src}
    title={title}
    width="100%"
    height="100%"
    style="border:0;"
    allowfullscreen
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
  ></iframe>
</div>

<style>
  .map-widget {
    width: 100%;
    aspect-ratio: 4 / 3;
    min-height: 280px;
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
    border: 1px solid var(--color-border-strong, #DACE97);
    background: var(--color-surface, #fff);
  }

  .map-widget iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  @media (min-width: 640px) {
    .map-widget {
      aspect-ratio: 16 / 9;
      min-height: 360px;
    }
  }
</style>
