---
interface Props {
  src: string;
  title?: string;
  address?: string;
  googleMapsUrl?: string;
}

const {
  src,
  title = "Ubicación en Google Maps",
  address = "C. 20 No. 251, Calle 10 15-local 9, Morelos Oriente, Mérida, Yucatán",
  googleMapsUrl = "https://maps.google.com/?q=Dra.+Estefania+Borges+Dermat%C3%B3loga",
} = Astro.props;
---

<div class="map-widget" data-map-widget data-map-src={src} data-map-title={title}>
  {/* Facade: se muestra primero para no cargar scripts de Google hasta que el usuario decida */}
  <div class="map-facade" data-map-facade>
    <div class="map-facade__content">
      <svg
        class="map-facade__icon"
        xmlns="http://www.w3.org/2000/svg"
        width="48"
        height="48"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
        <circle cx="12" cy="10" r="3" />
      </svg>
      <p class="map-facade__address">{address}</p>
      <button
        type="button"
        class="map-facade__button"
        data-map-trigger
        aria-label={`Cargar ${title}`}
      >
        Ver mapa
      </button>
      <p class="map-facade__note">
        Al cargar el mapa aceptas los términos de Google Maps.
        También puedes <a href={googleMapsUrl} target="_blank" rel="noopener noreferrer">abrirlo en una nueva pestaña</a>.
      </p>
    </div>
  </div>

  {/* El iframe se inyecta solo después de la interacción del usuario */}
  <div class="map-frame" data-map-frame hidden></div>

  {/* Fallback para usuarios sin JavaScript */}
  <noscript>
    <iframe
      src={src}
      title={title}
      width="100%"
      height="100%"
      style="border:0;"
      allowfullscreen
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
    ></iframe>
  </noscript>
</div>

<script>
  (function initMapWidget() {
    const widgets = document.querySelectorAll<HTMLElement>("[data-map-widget]");

    widgets.forEach((widget) => {
      const trigger = widget.querySelector<HTMLButtonElement>("[data-map-trigger]");
      const facade = widget.querySelector<HTMLElement>("[data-map-facade]");
      const frameContainer = widget.querySelector<HTMLElement>("[data-map-frame]");
      const src = widget.dataset.mapSrc;

      if (!trigger || !facade || !frameContainer) return;

      trigger.addEventListener("click", () => {
        const iframe = document.createElement("iframe");
        iframe.src = src || "";
        iframe.title = widget.dataset.mapTitle || "Ubicación en Google Maps";
        iframe.width = "100%";
        iframe.height = "100%";
        iframe.style.border = "0";
        iframe.allowFullscreen = true;
        iframe.loading = "lazy";
        iframe.referrerPolicy = "no-referrer-when-downgrade";

        frameContainer.appendChild(iframe);
        frameContainer.hidden = false;
        facade.hidden = true;
      });
    });
  })();
</script>

<style>
  .map-widget {
    width: 100%;
    border-radius: var(--radius-md, 12px);
    overflow: hidden;
    border: 1px solid var(--color-border-strong, #DACE97);
    background: var(--color-surface, #fff);
  }

  .map-facade,
  .map-frame {
    aspect-ratio: 4 / 3;
    width: 100%;
    min-height: 280px;
  }

  .map-facade {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-6, 1.5rem);
    text-align: center;
    background: linear-gradient(135deg, var(--color-surface, #fff) 0%, var(--color-background, #F9F7F2) 100%);
  }

  .map-facade__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3, 0.75rem);
    max-width: 360px;
  }

  .map-facade__icon {
    color: var(--color-primary, #2D5E46);
  }

  .map-facade__address {
    font-size: var(--text-base, 1rem);
    color: var(--color-text-primary, #1A1A1A);
    line-height: var(--leading-normal, 1.5);
  }

  .map-facade__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2, 0.5rem);
    padding: var(--space-3, 0.75rem) var(--space-6, 1.5rem);
    border-radius: var(--radius-full, 9999px);
    background: var(--color-primary, #2D5E46);
    color: var(--color-text-on-primary, #fff);
    font-weight: var(--weight-semibold, 600);
    font-size: var(--text-base, 1rem);
    border: none;
    cursor: pointer;
    transition: background var(--transition-fast, 150ms ease);
  }

  .map-facade__button:hover {
    background: var(--color-primary-hover, #244A38);
  }

  .map-facade__button:focus-visible {
    outline: 2px solid var(--color-primary, #2D5E46);
    outline-offset: 2px;
  }

  .map-facade__note {
    font-size: var(--text-xs, 0.75rem);
    color: var(--color-text-muted, #6B6B6B);
    line-height: var(--leading-normal, 1.5);
  }

  .map-facade__note a {
    color: var(--color-primary, #2D5E46);
    text-decoration: underline;
  }

  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  @media (min-width: 640px) {
    .map-facade,
    .map-frame {
      aspect-ratio: 16 / 9;
      min-height: 360px;
    }
  }
</style>
