---
import { callNumber, getCallTelUrl } from "../data/site.js";
---

<a
  href={getCallTelUrl()}
  class="phone-sticky"
  aria-label="Llamar al consultorio"
  title={`Llamar: ${callNumber}`}
>
  <svg
    class="phone-icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
  </svg>
</a>

<style>
  /* Dorado profundo derivado de --color-accent (#C4B896): suficiente contraste
     con el icono blanco (~4.9:1) y claramente distinto del verde WhatsApp. */
  .phone-sticky {
    --phone-bg: #8c6d1f;
    --phone-bg-hover: #a07f26;

    position: fixed;
    /* Apilado sobre el botón .whatsapp-sticky para no superponerse */
    bottom: calc(var(--space-6) + 56px + var(--space-3));
    right: var(--space-6);
    z-index: 200;
    width: 56px;
    height: 56px;
    background: var(--phone-bg);
    color: #fff;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 12, 30, 0.18);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
  }

  .phone-sticky:hover {
    background: var(--phone-bg-hover);
    transform: scale(1.08);
  }

  .phone-sticky:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .phone-icon {
    width: 26px;
    height: 26px;
  }

  @media (max-width: 640px) {
    .phone-sticky {
      width: 48px;
      height: 48px;
      bottom: calc(var(--space-4) + 48px + var(--space-3));
      right: var(--space-4);
    }

    .phone-icon {
      width: 22px;
      height: 22px;
    }
  }
</style>
