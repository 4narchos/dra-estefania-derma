---
import { getWhatsAppUrl } from "../data/site.js";

interface Props {
  variant?: "desktop" | "mobile";
  href?: string;
}

const {
  variant = "desktop",
  href = getWhatsAppUrl({ medium: "header" }),
} = Astro.props;

const calendarIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M6 3a1 1 0 0 1 2 0v1h8V3a1 1 0 1 1 2 0v1h1a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1zM5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9zm2 3.5a1 1 0 1 1 2 0 1 1 0 0 1-2 0m4 0a1 1 0 1 1 2 0 1 1 0 0 1-2 0m5-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2M8 15a1 1 0 1 0 0 2 1 1 0 0 0 0-2m3 1a1 1 0 1 1 2 0 1 1 0 0 1-2 0m5-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2"/></svg>`;

const whatsappIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"><path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>`;
---

{
  variant === "desktop" && (
    <a
      href={href}
      class="agendar-button"
      data-agendar-trigger
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Agendar cita por WhatsApp"
      title="Agendar cita por WhatsApp"
    >
      <span class="agendar-button__layer agendar-button__layer--front">
        <i aria-hidden="true" class="agendar-button__icon" set:html={calendarIcon} />
        <span>Agendar</span>
      </span>
      <span class="agendar-button__layer agendar-button__layer--back" aria-hidden="true">
        <i aria-hidden="true" class="agendar-button__icon" set:html={whatsappIcon} />
        <span>Enviar mensaje</span>
      </span>
    </a>
  )
}

{
  variant === "mobile" && (
    <a
      href={href}
      class="agendar-button agendar-button--mobile"
      target="_blank"
      rel="noopener noreferrer"
    >
      <i aria-hidden="true" class="agendar-button__icon" set:html={calendarIcon} />
      <span>Agendar</span>
    </a>
  )
}

<script>
  (function () {
    document.querySelectorAll("[data-agendar-trigger]").forEach((trigger) => {
      let hoverTimer: number | undefined;

      const openDoctoralia = () => {
        window.dispatchEvent(new CustomEvent("open-doctoralia-modal"));
      };

      const startHoverTimer = () => {
        hoverTimer = window.setTimeout(openDoctoralia, 1000);
      };

      const cancelHoverTimer = () => {
        clearTimeout(hoverTimer);
      };

      trigger.addEventListener("mouseenter", startHoverTimer);
      trigger.addEventListener("mouseleave", cancelHoverTimer);
      trigger.addEventListener("focus", startHoverTimer);
      trigger.addEventListener("blur", cancelHoverTimer);
    });
  })();
</script>

<style is:global>
  .agendar-button {
    --cta-bg: #325C46;

    position: relative;
    display: inline-block;
    overflow: hidden;
    width: 10rem;
    height: 2.75rem;
    background: var(--cta-bg);
    color: #fff;
    border-radius: 999px;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
    transition: background var(--transition-fast);
    justify-self: end;
  }

  .agendar-button:hover {
    --cta-bg: #264839;
    text-decoration: none;
  }

  .agendar-button__layer {
    position: absolute;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    white-space: nowrap;
    transition: top 0.5s ease;
  }

  .agendar-button__layer--front {
    top: 0;
  }

  .agendar-button__layer--back {
    top: 100%;
    font-size: clamp(0.6875rem, 1.2vw, 0.8125rem);
  }

  .agendar-button:hover .agendar-button__layer--front,
  .agendar-button.is-active .agendar-button__layer--front {
    top: -100%;
  }

  .agendar-button:hover .agendar-button__layer--back,
  .agendar-button.is-active .agendar-button__layer--back {
    top: 0;
  }

  .agendar-button__icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
  }

  .agendar-button__icon svg {
    display: block;
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .agendar-button--mobile {
    display: none;
    width: auto;
    height: auto;
    background: #325C46;
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    border: none;
    border-radius: 999px;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0.5rem 0.75rem;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--transition-fast);
    justify-self: center;
  }

  .agendar-button--mobile:hover {
    background: #264839;
    text-decoration: none;
  }

  @media (max-width: 768px) {
    .agendar-button:not(.agendar-button--mobile) {
      display: none;
    }

    .agendar-button--mobile {
      display: inline-flex;
      padding: 0.375rem 0.625rem;
      min-height: 2rem;
      font-size: 0.8125rem;
    }
  }
</style>
