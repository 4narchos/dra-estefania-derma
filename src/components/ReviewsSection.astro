---
import SectionHeader from "./SectionHeader.astro";
import StarIcon from "./StarIcon.astro";

const reviews = [
  {
    avatar: "K",
    author: "K.G.",
    text: "Quedé muy satisfecha con mi consulta con la Dra. Estefania. Desde el primer momento fue muy amable, empática y profesional, tomándose el tiempo para escuchar mis inquietudes y explicarme todo de manera clara.<br><br>Me dio mucha confianza por su conocimiento y la forma en que personalizó mi tratamiento. La atención fue muy eficaz y salí con un plan claro.<br><br>Sin duda la recomiendo a cualquier persona que busque una dermatóloga comprometida, humana y altamente profesional. ¡Excelente experiencia!",
    date: "2026-06-26",
    dateLabel: "26 de junio de 2026",
    source: "Evoke Aging Journey & Dermatology · Visita Dermatología",
  },
  {
    avatar: "P",
    author: "P.",
    text: "Excelente servicio y atención. La doctora es muy servicial y te explica con claridad el tratamiento a seguir.",
    date: "2026-06-26",
    dateLabel: "26 de junio de 2026",
    source: "Evoke Aging Journey & Dermatology · Hydrafacial",
  },
  {
    avatar: "C",
    author: "C.G.",
    text: "La Dra fue muy clara al explicarnos el tratamiento y los cuidados necesarios.",
    date: "2026-06-24",
    dateLabel: "24 de junio de 2026",
    source: "Evoke Aging Journey & Dermatology · Visita Dermatología",
  },
  {
    avatar: "L",
    author: "L.V.",
    text: "Excelente servicio! Muy recomendable para dermatología, me siento mucho más tranquila.",
    date: "2026-06-24",
    dateLabel: "24 de junio de 2026",
    source: "Evoke Aging Journey & Dermatology · Primera visita Dermatología",
  },
  {
    avatar: "M",
    author: "M.C.",
    text: "La forma como me atendió y la explicación que me dio.",
    date: "2026-06-23",
    dateLabel: "23 de junio de 2026",
    source: "Evoke Aging Journey & Dermatology · Primera visita Dermatología",
  },
  {
    avatar: "J",
    author: "J.R.",
    text: "Muy profesional, agradable y simpático. Recomiendo.",
    date: "2026-06-23",
    dateLabel: "23 de junio de 2026",
    source: "Evoke Aging Journey & Dermatology · Visita Dermatología",
  },
  {
    avatar: "L",
    author: "L.",
    text: "Todo fue muy práctico, excelente forma de explicar.",
    date: "2026-06-19",
    dateLabel: "19 de junio de 2026",
    source: "Evoke Aging Journey & Dermatology · Primera visita Dermatología",
  },
  {
    avatar: "C",
    author: "C.A.",
    text: "La atención de la Dra. Estefanía fue excelente de principio a fin. Es muy precisa y asertiva al momento de explicar el diagnóstico y tratamiento a seguir, así como para aclarar dudas.",
    date: "2026-06-05",
    dateLabel: "5 de junio de 2026",
    source: "Evoke Aging Journey & Dermatology · Primera visita Dermatología",
  },
];

---

<section class="reviews" id="opiniones">
  <div class="container">
    <SectionHeader
      title="Opiniones de pacientes"
      subtitle="Gracias por confiar en mi para cuidar su piel 🫰🏻"
    />

    <div class="reviews-marquee" aria-label="Opiniones de pacientes">
      <div class="reviews-track">
        {reviews.map((review) => (
          <article class="reviews-item">
            <header class="reviews-item-header">
              <span class="reviews-avatar">{review.avatar}</span>
              <div class="reviews-item-meta">
                <h3 class="reviews-author">{review.author}</h3>

              </div>
              <div class="reviews-item-stars" aria-label="5 estrellas">
                <StarIcon />
                <StarIcon />
                <StarIcon />
                <StarIcon />
                <StarIcon />
              </div>
            </header>
            <blockquote class="reviews-text" set:html={review.text} />
            <footer class="reviews-item-footer">
              <time datetime={review.date}>{review.dateLabel}</time>
              {review.source && <span>{review.source}</span>}
            </footer>
          </article>
        ))}
        {reviews.map((review) => (
          <article class="reviews-item" aria-hidden="true">
            <header class="reviews-item-header">
              <span class="reviews-avatar">{review.avatar}</span>
              <div class="reviews-item-meta">
                <h3 class="reviews-author">{review.author}</h3>

              </div>
              <div class="reviews-item-stars" aria-label="5 estrellas">
                <StarIcon />
                <StarIcon />
                <StarIcon />
                <StarIcon />
                <StarIcon />
              </div>
            </header>
            <blockquote class="reviews-text" set:html={review.text} />
            <footer class="reviews-item-footer">
              <time datetime={review.date}>{review.dateLabel}</time>
              {review.source && <span>{review.source}</span>}
            </footer>
          </article>
        ))}
      </div>
    </div>

    <p class="reviews-source">
      <a
        href="https://www.doctoralia.com.mx/mariana-estefania-garcia-borges-2/dermatologo/yucatan"
        target="_blank"
        rel="noopener noreferrer"
      >
        Ver todas las opiniones en Doctoralia →
      </a>
    </p>
  </div>
</section>

<style>
  .reviews {
    padding: var(--space-20) 0;
    background: var(--color-background);
    border-top: 1px solid var(--color-border);
    overflow: hidden;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .reviews-marquee {
    overflow: hidden;
    width: calc(100% + (var(--space-6) * 2));
    margin-left: calc(var(--space-6) * -1);
    margin-right: calc(var(--space-6) * -1);
    cursor: default;
  }

  .reviews-track {
    display: flex;
    align-items: stretch;
    gap: var(--space-6);
    width: max-content;
    padding: 0 var(--space-6);
    animation: reviewsMarquee 80s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews-track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      justify-content: center;
    }
  }

  .reviews-marquee:hover .reviews-track {
    animation-play-state: paused;
  }

  @keyframes reviewsMarquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .reviews-item {
    flex: 0 0 420px;
    width: 420px;
    background: var(--color-surface);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .reviews-item {
      flex: 0 0 560px;
      width: 560px;
    }
  }

  .reviews-item-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .reviews-avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    flex-shrink: 0;
  }

  .reviews-item-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
    min-width: 0;
  }

  .reviews-author {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
    margin: 0;
  }

  .reviews-verified {
    font-size: var(--text-xs);
    color: #325c46;
    font-weight: var(--weight-medium);
  }

  .reviews-item-stars {
    display: flex;
    gap: 2px;
    color: #f5b800;
    flex-shrink: 0;
  }

  .reviews-item-stars svg {
    width: 16px;
    height: 16px;
  }

  .reviews-text {
    font-size: var(--text-base);
    color: var(--color-text-primary);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-4) 0;
    padding: 0;
    border: none;
  }

  .reviews-item-footer {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: auto;
  }

  .reviews-source {
    text-align: center;
    margin-top: var(--space-8);
    padding: 0 var(--space-6);
  }

  .reviews-source a {
    color: #1d5a8f;
    font-size: var(--text-base);
    font-weight: var(--weight-medium);
    text-decoration: none;
  }

  .reviews-source a:hover {
    text-decoration: underline;
  }

  @media (max-width: 899px) {
    .reviews {
      height: 100dvh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      padding: var(--space-8) 0;
    }

    .container {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      width: 100%;
      min-width: 0;
      margin: 0;
      padding: 0 var(--space-4);
    }

    .reviews-marquee {
      flex: 1;
      width: calc(100% + (var(--space-4) * 2));
      margin-left: calc(var(--space-4) * -1);
      margin-right: calc(var(--space-4) * -1);
      min-height: 0;
      overflow: hidden;
    }

    .reviews-track {
      height: 100%;
      align-items: stretch;
      padding: 0 var(--space-4);
    }

    .reviews-item {
      flex: 0 0 85vw;
      width: 85vw;
      overflow: hidden;
    }

    .reviews-text {
      flex: 1 1 auto;
      font-size: var(--text-base);
      overflow-y: auto;
    }

    .reviews-author {
      font-size: var(--text-base);
    }

    .reviews-item-footer {
      font-size: var(--text-sm);
    }

    .reviews-source {
      margin-top: var(--space-4);
    }

    .reviews :global(.section-header-title) {
      width: 100%;
    }

    .reviews :global(.section-header-subtitle) {
      max-width: none;
    }
  }
</style>
