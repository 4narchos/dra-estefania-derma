---
import { Image } from "astro:assets";
import draContact from "../assets/images/dra-estefania-pijama-negra-guantes-rosas.webp";
import ContactCTA from "./ContactCTA.astro";
---

<section class="contact" id="contacto">
  <div class="container">
    <h2 class="contact-section-title">¡Nos vemos en el consultorio!</h2>
    <div class="contact-visual">
      <Image
        src={draContact}
        alt="Dra. Estefanía Borges de pie con pijama quirúrgica azul sosteniendo un dermatoscopio"
        width={560}
        height={700}
        densities={[1, 2]}
        loading="lazy"
        decoding="async"
      />
    </div>

    <ContactCTA />
  </div>
</section>

<style>
  .contact {
    padding: 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    min-height: auto;
  }

  @media (min-width: 768px) {
    .container {
      grid-template-columns: 1fr 1fr;
      min-height: 80vh;
    }
  }

  .contact-visual {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    min-height: 50vh;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .contact-visual {
      min-height: 100%;
      height: 100%;
    }
  }

  .contact-visual img {
    width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: bottom center;
    display: block;
  }

  .contact-section-title {
    grid-column: 1 / -1;
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(var(--text-4xl), 6vw, 4.5rem);
    font-weight: 600;
    line-height: var(--leading-tight);
    color: #152B52;
    margin: 0;
    padding: var(--space-12) var(--space-6);
    text-align: center;
    letter-spacing: -0.03em;
  }

  @media (max-width: 767px) {
    .contact {
      height: var(--viewport-minus-header);
      min-height: var(--viewport-minus-header);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .container {
      flex: 1;
      display: grid;
      grid-template-rows: auto 1fr auto;
      grid-template-areas:
        "title"
        "card"
        "menu";
      gap: var(--space-3);
      min-height: 0;
      padding: var(--space-5) var(--space-4) var(--space-5);
    }

    .contact-visual {
      display: none;
    }

    .contact-section-title {
      grid-area: title;
      align-self: start;
      justify-self: center;
      width: 100%;
      font-size: clamp(2.25rem, 8vw, 3.25rem);
      padding: 0;
      margin: 0;
    }

    .contact-content-top {
      grid-area: card;
      align-self: center;
      justify-self: center;
      width: 100%;
      min-width: 0;
      padding: 0;
      display: flex;
      justify-content: center;
    }

    .contact-content-bottom {
      grid-area: menu;
      align-self: end;
      justify-self: center;
      width: 100%;
      min-width: 0;
      padding: 0;
    }
  }
</style>
