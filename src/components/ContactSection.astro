---
import { getBaseUrl } from "../utils/baseUrl.js";
import { whatsappBaseUrl } from "../data/links.js";
const base = getBaseUrl();

const doctoraliaUrl = "https://www.doctoralia.com.mx/mariana-estefania-garcia-borges-2/dermatologo/yucatan";
const whatsappUrl = `${whatsappBaseUrl}&utm_source=web&utm_medium=contact_section&utm_campaign=agendar`;

const menuItems = [
  { label: "Ver las ubicaciones", href: `${base}ubicaciones` },
  { label: "Enviar un mensaje", href: whatsappUrl, external: true },
  { label: "Resuelve tus dudas", href: `${base}faqs` },
];
---

<section class="contact" id="contacto">
  <div class="container">
    <div class="contact-visual">
      <img
        src={`${base}images/dra-estefania-pijama-azul-sin-fondo.png`}
        alt="Dra. Estefanía Borges de pie con pijama quirúrgica azul sosteniendo un dermatoscopio"
        width="560"
        height="700"
        loading="eager"
      />
    </div>

    <div class="contact-content">
      <div class="contact-content-top">
        <div class="cta-card group">
          <img
            src={`${base}images/clinic-2.jpg`}
            alt="Consultorio dermatológico en Mérida"
            class="cta-card-img"
            width="460"
            height="260"
            loading="eager"
          />

          <p class="cta-card-title">¡Nos vemos en tu consulta!</p>
          <p class="cta-card-subtitle">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="cta-card-location-icon"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            Mérida
          </p>

          <div class="cta-card-footer">
            <p class="cta-card-price">$1,100 MXN</p>
            <a
              href={doctoraliaUrl}
              class="cta-card-button"
              target="_blank"
              rel="noopener noreferrer"
            >
              Agendar Ahora
            </a>
          </div>
        </div>
      </div>

      <div class="contact-content-bottom">
        <nav class="contact-menu" aria-label="Acciones de contacto">
          {menuItems.map((item) => (
            <a
              href={item.href}
              class="contact-menu-item"
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
            >
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    min-height: auto;
  }

  @media (min-width: 768px) {
    .container {
      grid-template-columns: 1fr 1fr;
      min-height: 80vh;
    }
  }

  .contact-visual {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    min-height: 50vh;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .contact-visual {
      min-height: 100%;
      height: 100%;
    }
  }

  .contact-visual img {
    width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: contain;
    object-position: bottom center;
    display: block;
  }

  .contact-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-6);
    width: 100%;
    height: 100%;
  }

  .contact-content-top {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .contact-content-bottom {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    border-top: none;
  }

  /* Uiverse card */
  .cta-card {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin: 0.5rem;
    padding: 3rem;
    background: #1a2332;
    border-radius: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    z-index: 20;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 10px 10px -5px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .cta-card::after {
    content: "";
    position: absolute;
    height: 100%;
    width: 100%;
    inset: 0;
    background: #243447;
    z-index: -20;
    border-radius: 0.75rem;
    transform: translateY(100%);
    transition: all 0.5s ease;
  }

  .cta-card:hover::after {
    transform: translateY(0);
  }

  .cta-card-img {
    width: 220px;
    height: 220px;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    transition: transform 0.3s ease;
  }

  .cta-card:hover .cta-card-img {
    transform: translateY(-0.25rem);
  }

  .cta-card-title {
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.05em;
    font-size: 1.5rem;
    margin: 0;
    transition: color 0.3s ease;
  }

  .cta-card-subtitle {
    font-weight: 600;
    color: rgba(255, 255, 255, 0.85);
    font-size: 1rem;
    margin: 0;
    transition: color 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cta-card-location-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .cta-card:hover .cta-card-subtitle {
    color: #ffffff;
  }

  .cta-card-footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: 0.75rem;
    gap: 1rem;
  }

  .cta-card-price {
    color: #abd373;
    font-weight: 700;
    font-size: 1.125rem;
    margin: 0;
    transition: color 0.3s ease;
  }

  .cta-card:hover .cta-card-price {
    color: #ffffff;
  }

  .cta-card-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #2D5E46;
    color: #ffffff;
    padding: 0.625rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  .cta-card:hover .cta-card-button {
    background: #3a7a5a;
    color: #ffffff;
  }

  /* Pill menu anchored in the lower third of the right column */
  .contact-menu {
    display: inline-flex;
    flex-wrap: nowrap;
    justify-content: center;
    gap: 4px;
    background: rgba(0, 0, 0, 0.45);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    padding: 4px;
    backdrop-filter: blur(8px);
    max-width: 100%;
  }

  .contact-menu-item {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 24px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 500;
    color: #ffffff;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .contact-menu-item:hover {
    background-color: #ffffff;
    color: #000000;
  }

  @media (max-width: 640px) {
    .contact-content {
      padding: var(--space-8) var(--space-5);
      gap: var(--space-3);
    }

    .contact-content-top,
    .contact-content-bottom {
      padding: 0;
    }

    .contact-menu {
      flex-wrap: nowrap;
      overflow-x: auto;
      max-width: 100%;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .contact-menu::-webkit-scrollbar {
      display: none;
    }

    .contact-menu-item {
      padding: 10px 18px;
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-card,
    .cta-card::after,
    .cta-card-img,
    .cta-card-title,
    .cta-card-subtitle,
    .cta-card-price,
    .cta-card-button,
    .contact-menu-item {
      transition: none;
    }
  }
</style>
