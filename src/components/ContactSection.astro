---
import SectionHeader from "./SectionHeader.astro";
import { whatsappBaseUrl } from "../data/links.js";

const whatsappUrl = `${whatsappBaseUrl}&utm_source=web&utm_medium=contact_section&utm_campaign=agendar`;

const contactItems = [
  {
    title: "Ubicaciones",
    content: [
      "Mérida — Evoke, C. 20 No. 251. Martes/viernes 4–7:30 p.m., miércoles 10 a.m.–3 p.m.",
      "Izamal — Sábados (horarios variables)",
      "Valladolid — Sábados y domingos 10 a.m.–4 p.m.",
      "Vaca — Sábados 9:30 a.m.–4 p.m.",
    ],
  },
  {
    title: "Contacto",
    content: ["WhatsApp", "Teléfono"],
  },
  {
    title: "Formas de pago",
    content: ["Efectivo, tarjeta de crédito y débito"],
  },
  {
    title: "Idiomas",
    content: ["Español e inglés"],
  },
];
---

<section class="contact" id="contacto">
  <div class="container">
    <SectionHeader
      title="Agenda tu consulta"
      subtitle="Primera consulta dermatológica disponible. Atención personalizada, solo pacientes privados."
    />
    <div class="contact-grid">
      <div class="contact-info">
        {contactItems.map((item) => (
          <div class="contact-item">
            <div>
              <strong>{item.title}</strong>
              <div class="contact-item-content">
                {item.content.map((line) => (
                  <p>{line}</p>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
      <div class="contact-cta">
        <a href={whatsappUrl} class="btn btn-primary btn-large" target="_blank" rel="noopener noreferrer">
          Escribir por WhatsApp
        </a>
        <p class="contact-note">
          Respuesta en horario de consulta.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: var(--space-20) 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 768px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contact-item {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .contact-item strong {
    display: block;
    color: var(--color-text-primary);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-2);
    font-size: var(--text-sm);
  }

  .contact-item-content p {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    margin-bottom: var(--space-1);
    line-height: var(--leading-relaxed);
  }

  .contact-item-content p:last-child {
    margin-bottom: 0;
  }

  .contact-cta {
    text-align: center;
    padding: var(--space-10);
    background: var(--color-background);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
  }

  .contact-note {
    margin-top: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
