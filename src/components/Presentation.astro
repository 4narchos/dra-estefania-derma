---
import { getBaseUrl } from "../utils/baseUrl.js";
import { getWhatsAppUrl, doctoraliaUrl } from "../data/site.js";
import PillMenu from "./PillMenu.astro";
const base = getBaseUrl();

const menuItems = [
  { label: "Ubicaciones", href: `${base}contacto` },
  { label: "Reservar cita", href: doctoraliaUrl, external: true, highlighted: true },
  { label: "Enviar mensaje", href: getWhatsAppUrl({ medium: "presentation_button", campaign: "inicio" }), external: true },
];
---

<section class="presentation" id="presentacion">
  <div class="presentation-visual">
    <img
      src={`${base}images/dra-estefania-pijama-azul-sin-fondo.png`}
      alt="Dra. Estefanía Borges con dermatoscopio"
      width="600"
      height="900"
      loading="eager"
    />
  </div>

  <div class="presentation-overlay" aria-hidden="true"></div>

  <div class="presentation-text">
    <h2 class="presentation-title">
      <span class="presentation-word">Yo</span>
      <span class="presentation-word">te</span>
      <span class="presentation-word">ayudo</span>
      <span class="presentation-word">a</span>
      <em class="presentation-word">entenderla</em>
    </h2>
  </div>

  <div class="signature-block">
    <span class="signature-name" data-signature="Dra. Estefanía Borges">Dra. Estefanía Borges</span>
    <span class="signature-title">DERMATÓLOGA</span>
  </div>

  <div class="presentation-content">
    <PillMenu variant="presentation" items={menuItems} ariaLabel="Acciones principales" />
  </div>
</section>

<style>
  .presentation {
    position: relative;
    background: #fafafa;
    min-height: var(--viewport-minus-header);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
  }

  .presentation-visual {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }

  .presentation-visual img {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: bottom center;
    display: block;
  }

  .presentation-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: transparent;
    pointer-events: none;
  }

  .presentation-text {
    position: relative;
    z-index: 3;
    text-align: center;
    padding-top: calc(var(--header-height) + var(--space-8));
    margin-bottom: var(--space-8);
    pointer-events: none;
  }

  .presentation-content {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-8);
  }

  .presentation-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(4rem, 15vw, 11rem);
    font-weight: 600;
    line-height: 0.88;
    color: #3A3A3A;
    letter-spacing: -0.05em;
    margin: 0;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
  }

  .presentation-title em {
    font-style: italic;
    color: #C4B896;
  }

  .presentation-word {
    display: inline-block;
    opacity: 0;
    filter: blur(10px);
    transform: scale(1.02);
  }

  .presentation-title.is-visible .presentation-word {
    animation: presentation-blur-in 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
  }

  .presentation-title.is-visible .presentation-word:nth-child(1) { animation-delay: 0.1s; }
  .presentation-title.is-visible .presentation-word:nth-child(2) { animation-delay: 0.2s; }
  .presentation-title.is-visible .presentation-word:nth-child(3) { animation-delay: 0.3s; }
  .presentation-title.is-visible .presentation-word:nth-child(4) { animation-delay: 0.4s; }
  .presentation-title.is-visible .presentation-word:nth-child(5) { animation-delay: 0.5s; }

  @keyframes presentation-blur-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: scale(1.02);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
  }

  /* Signature on the right side */
  .signature-block {
    position: absolute;
    right: var(--space-10);
    top: 50%;
    transform: translateY(-50%);
    z-index: 4;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    text-align: right;
    pointer-events: none;
  }

  .signature-name {
    font-family: 'Great Vibes', cursive;
    font-size: clamp(3rem, 5.5vw, 5rem);
    font-weight: 400;
    line-height: 1.35;
    padding: 0.15em 0;
    color: #F8E9A1;
    background: linear-gradient(
      135deg,
      #F8E9A1 0%,
      #FFF8D6 30%,
      #F8E9A1 50%,
      #E6D48A 70%,
      #F8E9A1 100%
    );
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter:
      drop-shadow(0 2px 2px rgba(0, 0, 0, 0.35))
      drop-shadow(0 0 18px rgba(0, 0, 0, 0.25));
    animation: metalShine 4s ease-in-out infinite;
  }

  @keyframes metalShine {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  .signature-char {
    display: inline-block;
    opacity: 0;
    transform: translateY(8px);
  }

  .signature-title {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(1rem, 1.8vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #F8E9A1;
    background: linear-gradient(
      135deg,
      #F8E9A1 0%,
      #FFF8D6 30%,
      #F8E9A1 50%,
      #E6D48A 70%,
      #F8E9A1 100%
    );
    background-size: 200% 200%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter:
      drop-shadow(0 2px 2px rgba(0, 0, 0, 0.35))
      drop-shadow(0 0 18px rgba(0, 0, 0, 0.25));
    animation: metalShine 4s ease-in-out infinite;
    margin-top: var(--space-2);
    opacity: 0;
    transform: translateY(8px);
  }

  @media (max-width: 900px) {
    .signature-block {
      position: relative;
      right: auto;
      top: auto;
      transform: none;
      align-items: center;
      text-align: center;
      margin-top: var(--space-6);
      pointer-events: none;
    }
  }

  @media (max-width: 640px) {
    .presentation {
      align-items: stretch;
      min-height: calc(100svh - var(--header-height));
    }

    .presentation-visual {
      position: absolute;
      inset: auto 0 0 0;
      top: 30%;
      min-height: auto;
      z-index: 1;
      display: flex;
      align-items: flex-end;
      justify-content: center;
    }

    .presentation-visual img {
      height: 100%;
      width: auto;
      max-width: 100%;
      min-height: auto;
      object-fit: contain;
      object-position: bottom center;
    }

    .presentation-text {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
      max-width: none;
      padding: 0 var(--space-4);
      margin: 0;
      z-index: 5;
      opacity: 0;
    }

    .presentation-title {
      width: 100%;
      font-size: clamp(2rem, 10vw, 3.5rem);
      line-height: 1;
    }

    .presentation-word {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }

    .signature-block {
      position: absolute;
      top: calc(var(--header-height) + var(--space-4));
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      margin-top: 0;
      z-index: 6;
      align-items: center;
      text-align: center;
      opacity: 0;
    }

    .signature-name {
      font-size: clamp(2.5rem, 12vw, 4rem);
      line-height: 1.2;
    }

    .signature-title {
      font-size: clamp(0.875rem, 4vw, 1.25rem);
    }

    .presentation-content {
      justify-content: flex-end;
      align-items: center;
      width: 100%;
      height: 100%;
      min-height: calc(100svh - var(--header-height));
      padding: 0 var(--space-4) var(--space-6);
      gap: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .presentation-word {
      animation: none !important;
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
  }
</style>

<script>
  import { gsap } from "../utils/animations.js";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!prefersReducedMotion) {
    const section = document.querySelector(".presentation");

    // Signature typewriter setup
    const nameEl = document.querySelector(".signature-name") as HTMLElement | null;
    const titleEl = document.querySelector(".signature-title") as HTMLElement | null;
    const titleContainer = document.querySelector(".presentation-title") as HTMLElement | null;
    let chars: NodeListOf<Element> | null = null;

    if (nameEl && titleEl) {
      const text = nameEl.dataset.signature || nameEl.textContent || "";
      nameEl.innerHTML = text
        .split("")
        .map((char, i) => `<span class="signature-char" style="--i:${i}">${char === " " ? "&nbsp;" : char}</span>`)
        .join("");
      chars = nameEl.querySelectorAll(".signature-char");
    }

    const isMobile = window.matchMedia("(max-width: 640px)").matches;

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: "top 80%",
        toggleActions: "play none none reverse",
      },
    });

    if (isMobile) {
      const textEl = document.querySelector(".presentation-text") as HTMLElement | null;
      const signatureEl = document.querySelector(".signature-block") as HTMLElement | null;

      // Measure vertical distance between centered text and final signature position
      let moveDistance = -120;
      if (textEl && signatureEl && section) {
        const textRect = textEl.getBoundingClientRect();
        const sigRect = signatureEl.getBoundingClientRect();
        const sectionRect = section.getBoundingClientRect();
        const textCenterY = textRect.top + textRect.height / 2 - sectionRect.top;
        const sigCenterY = sigRect.top + sigRect.height / 2 - sectionRect.top;
        moveDistance = sigCenterY - textCenterY;
      }

      // 1. "Yo te ayudo a entenderla" fades in at center and holds
      tl.fromTo(
        ".presentation-text",
        { opacity: 0, y: 30 },
        { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" }
      ).to({}, { duration: 1.1 });

      // 2. Doctor image zooms+fades in while text moves up to the top edge
      tl.fromTo(
        ".presentation-visual img",
        { scale: 0.85, opacity: 0 },
        { scale: 1, opacity: 1, duration: 1.2, ease: "power2.out" },
        "moveUp"
      ).to(
        ".presentation-text",
        { y: moveDistance, duration: 1.2, ease: "power2.out" },
        "moveUp"
      );

      // 3. Text fades out and signature replaces it at the top; menu rises from bottom
      if (chars && titleEl) {
        tl.to(".presentation-text", { opacity: 0, duration: 0.4, ease: "power2.inOut" }, "swap")
          .fromTo(
            ".signature-block",
            { opacity: 0 },
            { opacity: 1, duration: 0.4, ease: "power2.inOut" },
            "swap"
          )
          .fromTo(
            chars,
            { opacity: 0, y: 8 },
            { opacity: 1, y: 0, duration: 0.05, stagger: 0.06, ease: "power1.out" },
            "swap+=0.15"
          )
          .fromTo(
            titleEl,
            { opacity: 0, y: 8 },
            { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
            "swap+=0.3"
          )
          .from(
            ".pill-menu",
            { y: 30, opacity: 0, duration: 0.8, ease: "power2.out" },
            "swap"
          );
      }
    } else {
      // Desktop animation sequence
      // 1. Title fades in at dead center and holds for 1s
      tl.call(() => titleContainer?.classList.add("is-visible"))
        .fromTo(
          ".presentation-title",
          { y: "-50vh", opacity: 0 },
          { y: "-50vh", opacity: 1, duration: 0.6, ease: "power2.out" }
        )
        .to({}, { duration: 1 });

      // 2. Title moves to final position while doctor image zooms+fades in
      tl.fromTo(
        ".presentation-title",
        { y: "-50vh" },
        { y: 0, duration: 1.2, ease: "power2.out" },
        "image"
      ).fromTo(
        ".presentation-visual img",
        { scale: 0.85, opacity: 0 },
        { scale: 1, opacity: 1, duration: 1.2, ease: "power2.out" },
        "image"
      );

      // 3. Signature and menu appear
      if (chars && titleEl) {
        tl.fromTo(
          chars,
          { opacity: 0, y: 8 },
          { opacity: 1, y: 0, duration: 0.05, stagger: 0.06, ease: "power1.out" },
          "-=0.4"
        ).fromTo(
          titleEl,
          { opacity: 0, y: 8 },
          { opacity: 1, y: 0, duration: 0.6, ease: "power2.out" },
          "+=0.2"
        );
      }

      tl.from(".pill-menu", {
        y: 30,
        opacity: 0,
        duration: 0.8,
        ease: "power2.out",
      }, "-=0.4");
    }
  }
</script>
