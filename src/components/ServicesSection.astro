---
import { links } from "../data/links.js";
import { getBaseUrl } from "../utils/baseUrl.js";
import TopicMarquee from "./TopicMarquee.astro";

const base = getBaseUrl();
const doctoraliaUrl =
  links.find((l) => l.title === "Doctoralia")?.url ||
  "https://www.doctoralia.com.mx/mariana-estefania-garcia-borges-2/dermatologo/yucatan";

const services = [
  {
    category: "Dermatología Clínica",
    description:
      "Diagnóstico y tratamiento médico de las patologías de la piel, pelo y uñas.",
    items: [
      "Acné",
      "Manchas y piel pigmentada",
      "Rosacea",
      "Psoriasis",
      "Cáncer de piel y lesiones pre malignas",
      "Vitiligo",
      "Onicomicosis",
      "Sudoración excesiva",
      "Nevos (Lunares)",
      "Infecciones de la piel por hongos",
      "Dermatitis atópica",
      "Dermatitis por contacto",
    ],
    color: "#E8F4F8",
    textColor: "#1F1F1F",
    image: `${base}images/clinica.png`,
  },
  {
    category: "Tricología",
    description:
      "Diagnóstico y tratamiento avanzado de problemas del cabello y la piel cabelluda.",
    items: [
      "Dermatitis seborréica (Caspa)",
      "Alopecia androgenética (Calvicie en hombres)",
      "Caída de cabello en mujeres",
      "Hirsutismo (Vello excesivo)",
    ],
    color: "#E8F5E9",
    textColor: "#1F1F1F",
    image: `${base}images/trico.png`,
  },
  {
    category: "Dermatología Estética",
    description:
      "Procedimientos dermatológicos de vanguardia para mejorar la estética y rejuvenecer la piel.",
    items: [
      "Skincare",
      "Bótox",
      "Peeling facial",
      "Ojeras",
      "Microneedling",
      "Mesoterapia",
      "Terapia de luz pulsada",
      "Terapia laser",
    ],
    color: "#FFF8E7",
    textColor: "#1F1F1F",
    image: `${base}images/estetica.png`,
  },
  {
    category: "Cirugía menor Dermatológica",
    description:
      "Procedimientos con anestesia local para diagnosticar y ó extirpar lesiones cutáneas.",
    items: [
      "Biopsia de piel",
      "Reseccion de tumores",
      "Lipomas",
      "Quistes",
      "Crioterapia",
      "Electrocirugía",
    ],
    color: "#C4B896",
    textColor: "#1F1F1F",
    image: `${base}images/cirugia.png`,
  },
];
---

<section class="services" id="servicios">
  <TopicMarquee />
  <div class="services-inner">
    <header class="services-header">
      <h2 class="services-title">
        <span class="services-title-prefix">Experta en</span>
      </h2>
    </header>

    <div class="services-carousel-wrapper">
      <div class="services-nav">
        <button
          class="services-nav-btn services-nav-btn--prev"
          type="button"
          aria-label="Anterior"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M6.9 10.996h11.596a.75.75 0 0 1 0 1.5H6.9l4.377 4.377a.75.75 0 0 1-1.061 1.06l-4.95-4.95a1.75 1.75 0 0 1 0-2.474l4.95-4.95a.75.75 0 1 1 1.06 1.06L6.9 10.996z"
              fill="currentColor"
            ></path>
          </svg>
        </button>
        <button
          class="services-nav-btn services-nav-btn--next"
          type="button"
          aria-label="Siguiente"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              d="M17.1 13.004H5.504a.75.75 0 0 1 0-1.5H17.1l-4.377-4.377a.75.75 0 0 1 1.061-1.06l4.95 4.95a1.75 1.75 0 0 1 0 2.474l-4.95 4.95a.75.75 0 1 1-1.06-1.06l4.376-4.377z"
              fill="currentColor"
            ></path>
          </svg>
        </button>
      </div>

      <div class="services-carousel" role="region" aria-label="Servicios">
      <div class="services-carousel-track">
        {
          services.map((service, index) => (
            <article
              class="service-card"
              style={`--card-bg: ${service.color}; --card-text: ${service.textColor};`}
            >
              <div class="service-card-header">
                <h3 class="service-card-title">{service.category}</h3>
                <p class="service-card-description">{service.description}</p>
              </div>
              <div class="service-card-body">
                <div class="service-card-visual" aria-hidden="true">
                  <img
                    class="service-card-image"
                    src={service.image}
                    alt={service.category}
                    width="180"
                    height="180"
                    loading="lazy"
                  />
                </div>
                <div class="service-card-info">
                  <ul class="service-card-list" role="list">
                    {service.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              </div>
              <a
                href={doctoraliaUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="service-card-button"
              >
                Agendar
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    background: #141E2A;
    color: #ffffff;
    overflow: hidden;
  }

  .services-inner {
    max-width: none;
    margin: 0 auto;
    padding: 64px 76px 160px;
  }

  .services-header {
    display: block;
    padding: 24px 0 80px;
    text-align: center;
  }

  .services-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 80px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: normal;
    color: #ffffff;
    margin: 0;
    text-align: center;
  }

  .services-title-prefix {
    display: block;
  }

  .services-carousel-wrapper {
    position: relative;
    padding: 0 80px;
  }

  .services-nav {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
    z-index: 10;
  }

  .services-nav-btn {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    padding: 0;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(4px);
    color: #ffffff;
    cursor: pointer;
    transition: background 150ms ease, border-color 150ms ease, transform 150ms ease;
  }

  .services-nav-btn:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.45);
    transform: scale(1.08);
  }

  .services-nav-btn:disabled {
    color: rgba(255, 255, 255, 0.35);
    border-color: rgba(255, 255, 255, 0.1);
    cursor: default;
  }

  .services-nav-btn svg {
    flex-shrink: 0;
  }

  .services-carousel {
    overflow: hidden;
    touch-action: pan-y;
  }

  .services-carousel-track {
    display: flex;
    gap: 24px;
    will-change: transform;
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .service-card {
    position: relative;
    flex: 0 0 420px;
    width: 420px;
    min-height: 760px;
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    color: var(--card-text);
    border-radius: 24px;
    padding: 0 0 80px;
    overflow: hidden;
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.04),
      0 2px 2px rgba(0, 0, 0, 0.04),
      0 4px 4px rgba(0, 0, 0, 0.04),
      0 8px 8px rgba(0, 0, 0, 0.04),
      0 16px 16px rgba(0, 0, 0, 0.04);
    transition: transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94),
                box-shadow 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  .service-card:hover {
    transform: translateY(-10px);
    box-shadow:
      0 2px 2px rgba(0, 0, 0, 0.06),
      0 4px 4px rgba(0, 0, 0, 0.06),
      0 8px 8px rgba(0, 0, 0, 0.06),
      0 16px 16px rgba(0, 0, 0, 0.06),
      0 32px 32px rgba(0, 0, 0, 0.06),
      0 64px 64px rgba(0, 0, 0, 0.06);
  }

  .service-card-button {
    position: absolute;
    left: 50%;
    bottom: 24px;
    transform: translate(-50%, 0);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 140px;
    border-radius: 1rem;
    border: none;
    background: var(--card-text);
    color: var(--card-bg);
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
    opacity: 1;
    transition: transform 0.25s ease-out, opacity 0.25s ease-out;
  }

  .service-card-header {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 8px;
    height: 250px;
    padding: 28px 32px;
    background: rgba(0, 0, 0, 0.12);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    overflow: hidden;
  }

  .service-card-title {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 42px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: normal;
    color: var(--card-text);
    margin: 0;
  }

  .service-card-body {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 32px;
    overflow: hidden;
  }

  .service-card-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    transition: transform 0.35s ease-out, opacity 0.35s ease-out;
  }

  .service-card-image {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
    background: rgba(0, 0, 0, 0.08);
    transition: transform 0.35s ease-out;
  }

  .service-card-info {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 16px;
    opacity: 1;
    transform: none;
    transition: opacity 0.35s ease-out, transform 0.35s ease-out;
  }

  .service-card-description {
    font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", Roboto, sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.55;
    color: var(--card-text);
    margin: 0;
    opacity: 0.85;
    transition: opacity 0.4s ease-out;
  }

  .service-card-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 8px;
  }

  .service-card-list li {
    position: relative;
    padding-left: 20px;
    font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", Roboto, sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 24px;
    color: var(--card-text);
  }

  .service-card-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: currentColor;
    opacity: 0.7;
  }

  /* Efecto de despliegue en hover: la imagen se corre a la derecha
     y la lista aparece desde la izquierda (solo en dispositivos con hover) */
  @media (hover: hover) and (pointer: fine) {
    .service-card-body {
      display: grid;
      grid-template-columns: 1fr;
      align-items: center;
      gap: 0;
    }

    .service-card-visual {
      position: absolute;
      inset: 0;
      transform: translateX(0);
    }

    .service-card-info {
      opacity: 0;
      transform: translateX(-30px);
    }

    .service-card-button {
      opacity: 0;
      transform: translate(-50%, 20px);
    }

    .service-card:hover .service-card-visual {
      transform: translateX(45%);
      opacity: 0.35;
    }

    .service-card:hover .service-card-image {
      transform: scale(0.85);
    }

    .service-card:hover .service-card-info {
      opacity: 1;
      transform: translateX(0);
    }

    .service-card:hover .service-card-button {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  @media (max-width: 1280px) {
    .services-inner {
      padding: 48px 32px 120px;
    }

    .services-header {
      padding: 20px 0 64px;
    }

    .services-carousel-wrapper {
      padding: 0 64px;
    }

    .services-title {
      font-size: clamp(48px, 6vw, 80px);
      line-height: 1.05;
    }

    .service-card {
      flex: 0 0 380px;
      width: 380px;
      min-height: 700px;
    }

    .service-card-header {
      height: 230px;
      padding: 24px 28px;
    }

    .service-card-title {
      font-size: 36px;
      line-height: 1.05;
    }

    .service-card-image {
      width: 260px;
      height: 260px;
    }
  }

  @media (max-width: 900px) {
    .services-carousel-wrapper {
      padding: 0 56px;
    }

    .service-card {
      flex: 0 0 calc(100vw - 140px);
      width: calc(100vw - 140px);
      min-height: 720px;
      padding: 0 0 40px;
    }

    .service-card-header {
      height: 230px;
      padding: 24px 28px;
      gap: 6px;
    }

    .service-card-title {
      font-size: clamp(32px, 6vw, 48px);
      line-height: 1.05;
    }

    .service-card-description {
      font-size: 14px;
      line-height: 1.5;
    }

    /* Forzar layout legible en pantallas táctiles pequeñas,
       independientemente de lo que reporte la media query hover */
    .service-card-body {
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding: 24px;
      flex: none;
    }

    .service-card-visual {
      position: static;
      transform: none;
      opacity: 1;
    }

    .service-card-info {
      opacity: 1;
      transform: none;
    }

    .service-card-button {
      position: relative;
      left: auto;
      bottom: auto;
      transform: none;
      align-self: center;
      margin-top: 16px;
      opacity: 1;
    }
  }

  @media (max-width: 640px) {
    .services-inner {
      padding: 48px 16px 100px;
    }

    .services-header {
      padding: 16px 0 48px;
    }

    .services-carousel-wrapper {
      padding: 0 48px;
    }

    .services-title {
      font-size: 40px;
      line-height: 1.05;
    }

    .services-nav-btn {
      width: 44px;
      height: 44px;
    }

    .service-card {
      flex: 0 0 calc(100vw - 96px);
      width: calc(100vw - 96px);
      min-height: 640px;
      padding: 0 0 48px;
    }

    .service-card-header {
      height: 220px;
      padding: 20px 24px;
      gap: 6px;
    }

    .service-card-title {
      font-size: 32px;
      line-height: 1.05;
    }

    .service-card-body {
      gap: 12px;
      padding: 20px;
      flex: none;
    }

    .service-card-image {
      width: 180px;
      height: 180px;
    }

    .service-card-description {
      font-size: 12.5px;
      line-height: 1.45;
    }

    .service-card-list {
      gap: 3px;
    }

    .service-card-list li {
      font-size: 12.5px;
      line-height: 1.4;
    }
  }

  @media (max-width: 380px) {
    .service-card-header {
      height: 220px;
    }

    .service-card-title {
      font-size: 28px;
    }

    .service-card-description {
      font-size: 11.5px;
      line-height: 1.4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .services-carousel-track {
      transition: none !important;
    }

    .service-card {
      transition: none;
    }

    .service-card:hover {
      filter: none;
      box-shadow: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from "../utils/animations.js";

  (function () {
    const track = document.querySelector(
      ".services-carousel-track"
    ) as HTMLElement | null;
    const prevBtn = document.querySelector(
      ".services-nav-btn--prev"
    ) as HTMLButtonElement | null;
    const nextBtn = document.querySelector(
      ".services-nav-btn--next"
    ) as HTMLButtonElement | null;

    if (!track || !prevBtn || !nextBtn) return;

    const cards = Array.from(track.children) as HTMLElement[];
    if (cards.length < 2) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    let visualIndex = 0;
    let isTransitioning = false;

    function getStep() {
      const card = cards[0];
      const trackStyle = window.getComputedStyle(track);
      const gap = parseFloat(trackStyle.gap) || 24;
      return card.getBoundingClientRect().width + gap;
    }

    function setTransition(enabled: boolean) {
      track.style.transition = enabled && !prefersReducedMotion ? "" : "none";
    }

    function moveTo(index: number, animate = true) {
      setTransition(animate && !prefersReducedMotion);
      const step = getStep();
      track.style.transform = `translate3d(${-index * step}px, 0, 0)`;
    }

    function updateButtons() {
      prevBtn.disabled = visualIndex <= 0;
      nextBtn.disabled = visualIndex >= cards.length - 1;
    }

    function afterTransition(callback: () => void) {
      if (prefersReducedMotion) {
        callback();
        return;
      }
      let done = false;
      const handler = () => {
        if (done) return;
        done = true;
        track.removeEventListener("transitionend", handler);
        callback();
      };
      track.addEventListener("transitionend", handler);
    }

    function handleNext() {
      if (isTransitioning || visualIndex >= cards.length - 1) return;
      isTransitioning = true;
      visualIndex += 1;
      updateButtons();
      moveTo(visualIndex, true);
      afterTransition(() => {
        isTransitioning = false;
      });
    }

    function handlePrev() {
      if (isTransitioning || visualIndex <= 0) return;
      isTransitioning = true;
      visualIndex -= 1;
      updateButtons();
      moveTo(visualIndex, true);
      afterTransition(() => {
        isTransitioning = false;
      });
    }

    prevBtn.addEventListener("click", handlePrev);
    nextBtn.addEventListener("click", handleNext);

    // Swipe táctil básico para móvil
    let touchStartX = 0;
    track.addEventListener(
      "touchstart",
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
      },
      { passive: true }
    );
    track.addEventListener(
      "touchend",
      (e) => {
        const touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) handleNext();
          else handlePrev();
        }
      },
      { passive: true }
    );

    window.addEventListener("resize", () => {
      isTransitioning = false;
      moveTo(visualIndex, false);
    });

    // Inicializar
    updateButtons();
    moveTo(visualIndex, false);

    // Animación de entrada: primero el título, luego las cards.
    if (!prefersReducedMotion) {
      gsap
        .timeline({
          scrollTrigger: {
            trigger: ".services-header",
            start: "top 85%",
            toggleActions: "play none none none",
          },
          defaults: { ease: "power3.out" },
        })
        .from(".services-title-prefix", {
          y: 50,
          opacity: 0,
          duration: 0.8,
          clearProps: "transform,opacity",
        })
        .from(
          ".service-card",
          {
            y: 60,
            opacity: 0,
            duration: 0.7,
            stagger: 0.15,
            clearProps: "transform,opacity",
          },
          "-=0.3"
        );
    }
  })();
</script>
