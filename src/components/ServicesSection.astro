---
import SectionHeader from "./SectionHeader.astro";
import { services } from "../data/services.js";
import { locations } from "../data/locations.js";
import { getBaseUrl } from "../utils/baseUrl.js";
---

<section class="services" id="servicios">
  <div class="container">
    <SectionHeader
      title="Servicios dermatológicos"
      subtitle="Tratamientos personalizados para las condiciones de piel más comunes en el clima de Yucatán"
    />
    <div class="services-grid">
      {services.map((service) => (
        <a href={`${getBaseUrl()}servicios`} class="service-card">
          <h3 class="service-name">{service.name}</h3>
        </a>
      ))}
    </div>
    <div class="services-note">
      <h3 class="services-note-title">Consultorios de atención</h3>
      <div class="locations-grid">
        {locations.map((loc) => (
          <div class="location-item">
            <strong class="location-name">{loc.name}</strong>
            <span class="location-city">{loc.city}</span>
            <span class="location-hours">{loc.hours}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .services {
    padding: var(--space-20) 0;
    background: var(--color-surface);
    border-top: 1px solid var(--color-border);
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
    width: 100%;
  }

  @media (min-width: 480px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .service-card {
    background: var(--color-background);
    padding: var(--space-6);
    border-radius: var(--radius-md);
    text-align: center;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
    border: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .service-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
    text-decoration: none;
  }

  .service-name {
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    color: var(--color-text-primary);
  }

  .services-note {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .services-note-title {
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    text-align: center;
    margin-bottom: var(--space-6);
    color: var(--color-text-primary);
  }

  .locations-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    max-width: 60rem;
    margin: 0 auto;
  }

  @media (min-width: 640px) {
    .locations-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .locations-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .location-item {
    background: var(--color-background);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-align: center;
    border: 1px solid var(--color-border);
  }

  .location-name {
    font-size: var(--text-sm);
    color: var(--color-text-primary);
  }

  .location-city {
    font-size: var(--text-sm);
    color: var(--color-primary);
    font-weight: var(--weight-semibold);
  }

  .location-hours {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    white-space: pre-line;
  }
</style>
