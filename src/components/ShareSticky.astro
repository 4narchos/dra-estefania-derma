---
const shareText = 'Dra. Estefanía Borges — Dermatóloga en Yucatán';
---

<button type="button" class="share-sticky" aria-label="Compartir página" id="share-sticky-trigger">
  <svg class="share-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/>
    <polyline points="16 6 12 2 8 6"/>
    <line x1="12" y1="2" x2="12" y2="15"/>
  </svg>
</button>

<div class="share-overlay" id="share-sticky-overlay" aria-hidden="true">
  <div class="share-modal" role="dialog" aria-modal="true" aria-labelledby="share-sticky-title">
    <div class="share-modal-header">
      <div class="share-modal-title-wrapper">
        <h3 class="share-modal-title" id="share-sticky-title">Compartir</h3>
      </div>
      <button type="button" class="share-modal-close" aria-label="Cerrar" id="share-sticky-close">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M13.354 3.354 13.707 3 13 2.293l-.354.353zM2.647 12.647 2.293 13l.707.707.354-.353zm.707-10L3 2.292 2.293 3l.354.354zm9.293 10.707.353.353.707-.707-.353-.354zm0-10.708-10 10 .707.708 10-10zm-10 .708 10 10 .707-.707-10-10z" fill="currentColor"/></svg>
      </button>
    </div>

    <div class="share-modal-preview">
      <div class="share-avatar">
        <img src="/images/dra-estefania-dermatoscopio.jpg" alt="Dra. Estefanía Borges" class="share-avatar-img" loading="lazy" width="80" height="80" />
      </div>
    </div>

    <div class="share-modal-body">
      <div class="share-scroll" id="share-sticky-scroll">
        <button type="button" class="share-item" data-share="copy">
          <div class="share-item-icon" style="background:var(--color-surface); border:1px solid var(--color-border)">
            <svg viewBox="0 0 24 24" width="22" height="22" stroke="var(--color-primary)" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </div>
          <span class="share-item-label">Copiar enlace</span>
        </button>

        <a class="share-item" data-share="whatsapp" target="_blank" rel="noopener noreferrer">
          <div class="share-item-icon" style="background:#00E676">
            <svg viewBox="0 0 24 24" width="26" height="26"><circle cx="50%" cy="50%" r="50%" fill="#00E676"/><path d="M16.201 7.746a5.9 5.9 0 0 0-4.205-1.745c-3.276 0-5.945 2.669-5.948 5.945 0 1.049.274 2.07.793 2.973L6 18.001l3.153-.826a5.95 5.95 0 0 0 2.843.724h.003c3.275 0 5.944-2.669 5.947-5.948A5.92 5.92 0 0 0 16.2 7.746m-4.205 9.146c-.89 0-1.76-.24-2.518-.69l-.18-.108-1.87.49.5-1.824-.118-.188a4.9 4.9 0 0 1-.755-2.63 4.95 4.95 0 0 1 4.944-4.937c1.32 0 2.56.516 3.495 1.448a4.92 4.92 0 0 1 1.445 3.496 4.95 4.95 0 0 1-4.943 4.943m2.711-3.7a27 27 0 0 0-1.015-.485c-.137-.049-.236-.074-.334.074-.1.148-.384.485-.47.582-.085.1-.174.11-.322.037s-.627-.231-1.195-.739a4.5 4.5 0 0 1-.827-1.029c-.085-.148-.008-.228.066-.302.066-.066.148-.174.223-.26.074-.085.1-.148.148-.248s.025-.185-.012-.259-.333-.807-.459-1.103c-.12-.291-.242-.251-.333-.254C10.09 9.2 9.99 9.2 9.892 9.2c-.1 0-.26.037-.397.185-.136.149-.519.508-.519 1.24 0 .733.534 1.438.608 1.537.074.1 1.046 1.6 2.537 2.244.354.154.63.245.847.314.356.114.678.097.935.06.285-.043.878-.36 1.004-.707.122-.348.122-.645.085-.707-.037-.063-.137-.1-.285-.174" fill="#fff"/></svg>
          </div>
          <span class="share-item-label">WhatsApp</span>
        </a>

        <button type="button" class="share-item" data-share="instagram">
          <div class="share-item-icon" style="background: linear-gradient(135deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%)">
            <svg viewBox="0 0 24 24" width="26" height="26"><rect x="5" y="5" width="14" height="14" rx="4" stroke="#fff" stroke-width="1.8" fill="none"/><circle cx="12" cy="12" r="3.2" stroke="#fff" stroke-width="1.8" fill="none"/><circle cx="17.5" cy="6.5" r="1" fill="#fff"/></svg>
          </div>
          <span class="share-item-label">Instagram</span>
        </button>

        <a class="share-item" data-share="telegram" target="_blank" rel="noopener noreferrer">
          <div class="share-item-icon" style="background:#0088CC">
            <svg viewBox="0 0 24 24" width="26" height="26"><circle cx="50%" cy="50%" r="50%" fill="#0088CC"/><path d="M5.491 11.74c4.23-1.84 7.055-3.055 8.475-3.645 4.04-1.68 4.88-1.972 5.43-1.983.12-.002.39.028.56.17.147.12.188.283.207.397.02.113.044.37.025.57-.22 2.36-1.172 8.09-1.657 10.73-.205 1.1-.607 1.47-.996 1.506-.847.078-1.49-.56-2.31-1.098-1.284-.841-2.01-1.364-3.255-2.183-1.44-.949-.507-1.471.314-2.323.215-.222 3.955-3.625 4.027-3.937a.33.33 0 0 0-.077-.268c-.088-.084-.218-.055-.312-.032-.133.033-2.255 1.433-6.365 4.2-.602.413-1.148.614-1.637.603-.54-.012-1.577-.304-2.35-.553-.946-.308-1.698-.471-1.633-.995.034-.272.408-.55 1.12-.833z" fill="#fff"/></svg>
          </div>
          <span class="share-item-label">Telegram</span>
        </a>

        <a class="share-item" data-share="sms">
          <div class="share-item-icon" style="background:#34B7F1">
            <svg viewBox="0 0 24 24" width="26" height="26"><circle cx="50%" cy="50%" r="50%" fill="#34B7F1"/><path d="M7 7h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-2l-3 3-3-3H7a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2z" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <span class="share-item-label">Mensaje</span>
        </a>

        <a class="share-item" data-share="messenger" target="_blank" rel="noopener noreferrer">
          <div class="share-item-icon" style="background: linear-gradient(135deg, #0099FF 0%, #A033FF 50%, #FF5280 100%)">
            <svg viewBox="0 0 24 24" width="22" height="22"><path d="M12 2C6.48 2 2 6.03 2 11c0 1.68.52 3.24 1.42 4.56L2 22l6.67-1.75A9.96 9.96 0 0 0 12 20c5.52 0 10-4.03 10-9s-4.48-9-10-9zm-1.2 11.75l-2.55 1.44.68-2.55a.5.5 0 0 0-.14-.47C7.06 10.93 6.5 9.55 6.5 8.5c0-2.2 2.02-4 4.5-4s4.5 1.8 4.5 4-2.02 4-4.5 4c-.57 0-1.11-.1-1.61-.27a.5.5 0 0 0-.47.06l-.12.46z" fill="#fff"/></svg>
          </div>
          <span class="share-item-label">Messenger</span>
        </a>

        <a class="share-item" data-share="email">
          <div class="share-item-icon" style="background:#60696C">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          </div>
          <span class="share-item-label">Correo</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    const trigger = document.getElementById('share-sticky-trigger');
    const overlay = document.getElementById('share-sticky-overlay');
    const closeBtn = document.getElementById('share-sticky-close');
    if (!trigger || !overlay || !closeBtn) return;

    const shareText = 'Dra. Estefanía Borges — Dermatóloga en Yucatán';
    const shareUrl = window.location.href;

    function openModal() {
      overlay.classList.add('is-open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      overlay.classList.remove('is-open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    trigger.addEventListener('click', openModal);
    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', function(e) {
      if (e.target === overlay) closeModal();
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && overlay.classList.contains('is-open')) closeModal();
    });

    // URLs dinámicas
    const whatsappLink = overlay.querySelector('[data-share="whatsapp"]');
    if (whatsappLink) {
      whatsappLink.href = 'https://api.whatsapp.com/send?text=' + encodeURIComponent(shareText + ' ' + shareUrl);
    }

    const telegramLink = overlay.querySelector('[data-share="telegram"]');
    if (telegramLink) {
      telegramLink.href = 'https://t.me/share/url?url=' + encodeURIComponent(shareUrl) + '&text=' + encodeURIComponent(shareText);
    }

    const smsLink = overlay.querySelector('[data-share="sms"]');
    if (smsLink) {
      smsLink.href = 'sms:?body=' + encodeURIComponent(shareText + ' ' + shareUrl);
    }

    const emailLink = overlay.querySelector('[data-share="email"]');
    if (emailLink) {
      emailLink.href = 'mailto:?subject=' + encodeURIComponent('Dra. Estefanía Borges — Dermatóloga en Yucatán') + '&body=' + encodeURIComponent(shareText + ' ' + shareUrl);
    }

    // Instagram — intentar Web Share API primero
    const instagramBtn = overlay.querySelector('[data-share="instagram"]');
    if (instagramBtn) {
      instagramBtn.addEventListener('click', function() {
        if (navigator.share) {
          navigator.share({
            title: document.title,
            text: shareText,
            url: shareUrl,
          }).catch(() => {});
        } else {
          copyToClipboard('Enlace copiado. Pégalo en Instagram');
        }
        closeModal();
      });
    }

    // Copiar enlace
    const copyBtn = overlay.querySelector('[data-share="copy"]');
    if (copyBtn) {
      copyBtn.addEventListener('click', function() {
        copyToClipboard('Enlace copiado');
        closeModal();
      });
    }

    async function copyToClipboard(feedbackText) {
      if (navigator.clipboard) {
        try {
          await navigator.clipboard.writeText(shareText + ' ' + shareUrl);
          showCopyFeedback(feedbackText);
        } catch (err) {}
      }
    }

    function showCopyFeedback(text) {
      const copyLabel = overlay.querySelector('[data-share="copy"] .share-item-label');
      if (copyLabel) {
        const original = copyLabel.textContent;
        copyLabel.textContent = text;
        setTimeout(() => { copyLabel.textContent = original; }, 2000);
      }
    }
  })();
</script>

<style>
.share-sticky {
    position: fixed;
    top: 5rem;
    right: var(--space-6);
    z-index: 200;
    width: 40px;
    height: 40px;
    background: #F5F0E6;
    color: #7A6F5B;
    border: 1px solid #E8DFC8;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 1px 4px rgba(0,0,0,0.06);
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
  }

  .share-sticky:hover {
    transform: scale(1.08);
    background: #EDE6D6;
  }

  .share-sticky:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .share-icon {
    width: 18px;
    height: 18px;
  }

  @media (max-width: 640px) {
    .share-sticky {
      width: 36px;
      height: 36px;
      top: 4.5rem;
      right: var(--space-4);
    }

    .share-icon {
      width: 16px;
      height: 16px;
    }
  }

  /* Modal styles */
  .share-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 12, 30, 0.35);
    backdrop-filter: blur(3px);
    z-index: 300;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    opacity: 0;
    visibility: hidden;
    transition: opacity 250ms ease, visibility 250ms ease;
  }

  .share-overlay.is-open {
    opacity: 1;
    visibility: visible;
  }

  .share-modal {
    background: var(--color-background);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 380px;
    box-shadow: 0 20px 60px rgba(0, 12, 30, 0.18);
    transform: translateY(12px) scale(0.98);
    transition: transform 250ms ease;
    overflow: hidden;
  }

  .share-overlay.is-open .share-modal {
    transform: translateY(0) scale(1);
  }

  .share-modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-5) var(--space-5) var(--space-3);
    position: relative;
  }

  .share-modal-title-wrapper {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .share-modal-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-primary);
    margin: 0;
    letter-spacing: -0.01em;
  }

  .share-modal-close {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    border: none;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .share-modal-close:hover {
    background: var(--color-surface);
    color: var(--color-text-primary);
  }

  .share-modal-preview {
    padding: var(--space-2) var(--space-5) var(--space-3);
    display: flex;
    justify-content: center;
  }

  .share-avatar {
    width: 80px;
    height: 80px;
    border-radius: var(--radius-full);
    overflow: hidden;
    border: 2px solid var(--color-border-strong);
    background: var(--color-surface);
  }

  .share-avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .share-modal-body {
    padding: var(--space-3) var(--space-2) var(--space-6);
  }

  .share-scroll {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding: var(--space-1) var(--space-3) var(--space-2);
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .share-scroll::-webkit-scrollbar {
    display: none;
  }

  .share-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    min-width: 72px;
    padding: var(--space-1) 2px;
    border: none;
    background: none;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    font-family: inherit;
    border-radius: var(--radius-md);
    transition: background var(--transition-fast);
  }

  .share-item:hover {
    background: var(--color-surface);
  }

  .share-item-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  .share-item-icon svg {
    display: block;
  }

  .share-item-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    color: var(--color-text-secondary);
    text-align: center;
    white-space: nowrap;
  }
</style>
