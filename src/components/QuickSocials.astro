---
import { socialLinks } from "../data/socialLinks.js";

interface SocialLink {
  name: string;
  url: string;
  icon: string;
  active?: boolean;
  handle?: string;
}

interface Props {
  handle?: string;
  socials?: SocialLink[];
}

const { socials = socialLinks, handle } = Astro.props;
const activeSocial = socials.find((s) => s.active && s.handle);
const displayHandle = handle ?? activeSocial?.handle ?? "";
---

<div class="quick-socials">
  <button
    type="button"
    class="quick-socials-handle"
    aria-label="Ver redes sociales"
    aria-expanded="false"
  >
    <svg class="quick-socials-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <title>Link icon</title>
      <path d="m9.726 5.123 1.228-1.228a6.47 6.47 0 0 1 9.15 9.152l-1.227 1.227m-4.603 4.603-1.228 1.228a6.47 6.47 0 0 1-9.15-9.152l1.227-1.227"/>
      <line x1="8.471" x2="15.529" y1="15.529" y2="8.471"/>
    </svg>
    <span>{displayHandle}</span>
  </button>
  <div class="quick-socials-icons">
    {socials.map((social) => (
      <a
        href={social.url}
        class={`quick-socials-icon quick-socials-icon--${social.icon}`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={social.name}
        title={social.name}
      >
        {social.icon === "instagram" && (
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        )}
        {social.icon === "facebook" && (
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        )}
        {social.icon === "tiktok" && (
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/></svg>
        )}
      </a>
    ))}
  </div>
</div>

<script>
  (function () {
    const tooltip = document.querySelector(".quick-socials");
    const handle = tooltip?.querySelector(".quick-socials-handle");
    if (!tooltip || !handle) return;

    const open = () => {
      tooltip.classList.add("is-open");
      handle.setAttribute("aria-expanded", "true");
    };

    const close = () => {
      tooltip.classList.remove("is-open");
      handle.setAttribute("aria-expanded", "false");
    };

    handle.addEventListener("click", (e) => {
      e.stopPropagation();
      if (tooltip.classList.contains("is-open")) {
        close();
      } else {
        open();
      }
    });

    document.addEventListener("click", (e) => {
      if (!tooltip.contains(e.target as Node)) close();
    });
  })();
</script>

<style>
  .quick-socials {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
  }

  .quick-socials-handle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-1);
    width: 100%;
    padding: 2px var(--space-1);
    margin: 0 calc(var(--space-1) * -1);
    font-size: var(--text-sm);
    font-family: inherit;
    font-weight: var(--weight-medium);
    color: #1D5A8F;
    text-decoration: none;
    background: transparent;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: color var(--transition-fast), background var(--transition-fast);
  }

  .quick-socials-handle:hover,
  .quick-socials:hover .quick-socials-handle {
    color: #14496F;
  }

  .quick-socials-chevron {
    flex-shrink: 0;
    width: 1em;
    height: 1em;
    color: currentColor;
    transition: transform var(--transition-fast);
  }

  .quick-socials:hover .quick-socials-chevron,
  .quick-socials.is-open .quick-socials-chevron {
    transform: scale(1.15) translateY(-1px);
  }

  .quick-socials-icons {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    min-width: max-content;
    transform: scale(0.85);
    transform-origin: top center;
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    padding: 6px var(--space-2) var(--space-2);
    background: #fff;
    border-radius: 999px;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease;
    z-index: 10;
  }

  .quick-socials:hover .quick-socials-icons,
  .quick-socials.is-open .quick-socials-icons {
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    pointer-events: auto;
  }

  .quick-socials-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #f5f5f5;
    color: #333;
    transition: transform 0.2s ease, background 0.2s ease, color 0.2s ease;
  }

  .quick-socials-icon:hover {
    transform: translateY(-3px) scale(1.1);
  }

  .quick-socials-icon--instagram:hover {
    background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    color: #fff;
  }

  .quick-socials-icon--facebook:hover {
    background: #1877f2;
    color: #fff;
  }

  .quick-socials-icon--tiktok:hover {
    background: #000;
    color: #fff;
  }
</style>
