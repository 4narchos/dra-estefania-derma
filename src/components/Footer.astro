---
import LocationWidgetMain from "./LocationWidgetMain.astro";
import { getWhatsAppUrl, whatsappPresets, getTelUrl, credentialUrl, mapsLinkMain, agendaUrl } from "../data/site.js";
import { locations } from "../data/locations.js";
import { socialLinks } from "../data/socialLinks.js";
import { getBaseUrl } from "../utils/baseUrl.js";

const base = getBaseUrl();
const currentYear = new Date().getFullYear();

const mainLocation = locations[0];

const navLinks = [
  { label: "Inicio", href: `${base}` },
  { label: "Acerca", href: `${base}acerca` },
  { label: "Servicios", href: `${base}servicios` },
  { label: "Contacto", href: `${base}contacto` },
];

const credentialLink = {
  label: "Consejo Mexicano de Dermatología",
  href: credentialUrl,
};
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      {/* Ubicación: dirección + mapa */}
      <div class="footer-block footer-block--location">
        <h3 class="footer-block-title">Ubicación</h3>
        <LocationWidgetMain dark />
      </div>

      {/* Contacto: CTA, teléfono, WhatsApp y horarios */}
      <div class="footer-block footer-block--contact">
        <h3 class="footer-block-title">Contacto</h3>
        <a
          href={agendaUrl}
          class="footer-cta"
          target="_blank"
          rel="noopener noreferrer"
        >
          Agendar cita
        </a>
        <ul class="footer-link-list footer-link-list--inline footer-link-list--contact">
          <li>
            <a
              href={getWhatsAppUrl(whatsappPresets.webFooter)}
              class="footer-contact-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp
            </a>
          </li>
          <li>
            <a href={getTelUrl(mainLocation.phone)} class="footer-contact-link">
              {mainLocation.phone}
            </a>
          </li>
        </ul>
        <p class="footer-hours">Lunes a viernes · 10:00 a.m. – 7:00 p.m.</p>
      </div>

      {/* Navegación */}
      <div class="footer-block">
        <h3 class="footer-block-title">Navegación</h3>
        <nav aria-label="Navegación del pie">
          <ul class="footer-link-list">
            {navLinks.map((link) => (
              <li><a href={link.href} class="footer-link">{link.label}</a></li>
            ))}
          </ul>
        </nav>
      </div>

      {/* Credenciales + redes */}
      <div class="footer-block">
        <h3 class="footer-block-title">Credenciales</h3>
        <ul class="footer-link-list">
          <li>
            <a href={credentialLink.href} class="footer-link" target="_blank" rel="noopener noreferrer">
              {credentialLink.label}
            </a>
          </li>
        </ul>

        <h3 class="footer-block-title footer-block-title--secondary">Redes</h3>
        <ul class="footer-link-list footer-link-list--inline">
          {socialLinks.filter((link) => link.active).map((link) => (
            <li>
              <a href={link.url} class="footer-link" target="_blank" rel="noopener noreferrer">
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div class="footer-legal">
        <span class="footer-copyright">
          &copy; {currentYear} Dra. Mariana Estefanía García Borges. Todos los derechos reservados.
        </span>
      </div>
      <p class="footer-disclaimer">
        La información de este sitio no sustituye una consulta médica personalizada.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-midnight);
    border-top: 1px solid var(--color-border-inverse);
    padding: var(--space-16) 0 var(--space-8);
  }

  .footer-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (min-width: 1024px) {
    .footer-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .footer-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

.footer-block {
    align-items: center;
    text-align: center;
  }

  @media (min-width: 640px) {
    .footer-block {
      align-items: flex-start;
      text-align: left;
    }
  }

  @media (max-width: 639px) {
    .footer-block .footer-link-list {
      align-items: center;
    }
  }

  .footer-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-full);
    background: var(--color-primary);
    color: var(--color-text-on-primary);
    font-weight: var(--weight-semibold);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: background var(--transition-fast);
  }

  .footer-cta:hover {
    background: var(--color-primary-hover);
  }

  .footer-hours {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    white-space: pre-line;
  }

  .footer-block-title {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    margin-bottom: var(--space-2);
  }

  .footer-block-title--secondary {
    margin-top: var(--space-4);
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-style: normal;
  }

  .footer-contact-link {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-fast);
    line-height: var(--leading-normal);
  }

  .footer-contact-link:hover {
    color: var(--color-text-on-dark);
  }

  .footer-contact-link--address {
    margin-top: 0;
  }

  .footer-map {
    margin-top: var(--space-2);
  }

  .footer-link-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer-link-list--inline {
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-link {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-link:hover {
    color: var(--color-text-on-dark);
  }

  .footer-bottom {
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border-inverse);
    text-align: center;
  }

  .footer-legal {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  @media (min-width: 640px) {
    .footer-legal {
      flex-direction: row;
      justify-content: center;
      gap: var(--space-2);
    }
  }

  .footer-legal-link {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .footer-legal-link:hover {
    color: var(--color-text-on-dark);
  }

  .footer-legal-separator {
    color: var(--color-text-muted);
    opacity: 0.5;
    display: none;
  }

  @media (min-width: 640px) {
    .footer-legal-separator {
      display: inline;
    }
  }

  .footer-copyright {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .footer-disclaimer {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    opacity: 0.7;
    max-width: 48rem;
    margin: 0 auto;
  }
</style>
