---
import { whatsappBaseUrl } from "../data/links.js";
import { getBaseUrl } from "../utils/baseUrl.js";
const base = getBaseUrl();

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navLinks = [
  { label: "Inicio", href: `${base}`, path: `${base}` },
  { label: "Acerca", href: `${base}acerca`, path: `${base}acerca` },
  { label: "Servicios", href: `${base}servicios`, path: `${base}servicios` },
  { label: "Contacto", href: `${base}contacto`, path: `${base}contacto` },
];

function isActive(linkPath: string): boolean {
  // Normalize paths for comparison
  const normalizedCurrent = currentPath.replace(/\/$/, "").replace(new RegExp(`^${base.replace(/\/$/, "")}`), "") || "/";
  const normalizedLink = linkPath.replace(/\/$/, "").replace(new RegExp(`^${base.replace(/\/$/, "")}`), "") || "/";

  if (normalizedLink === "/") {
    return normalizedCurrent === "/";
  }
  return normalizedCurrent.startsWith(normalizedLink);
}
---

<header class="site-header">
  <nav class="nav-container" aria-label="Navegación principal">
    <a href={base} class="nav-logo" aria-label="Dra. Estefanía Borges — Dermatóloga — Inicio">
      <img src={`${base}images/header-logo-v2.png`} alt="Dra. Estefanía Borges — Dermatóloga" class="nav-logo-img" loading="eager" width="300" height="96" />
    </a>

    <div class="nav-actions">
      <a
        href={`${whatsappBaseUrl}&utm_source=web&utm_medium=header&utm_campaign=agendar`}
        class="nav-cta-mobile"
        target="_blank"
        rel="noopener noreferrer"
      >
        Agendar
        <span class="icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </span>
      </a>

      <button
        class="nav-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="nav-menu"
        type="button"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>

    <ul class="nav-menu" id="nav-menu" role="menubar">
      {navLinks.map((link) => (
        <li role="none">
          <a
            href={link.href}
            class:list={["nav-link", isActive(link.path) && "is-active"]}
            role="menuitem"
            aria-current={isActive(link.path) ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li role="none">
        <a
          href={`${whatsappBaseUrl}&utm_source=web&utm_medium=header&utm_campaign=agendar`}
          class="nav-cta"
          role="menuitem"
          target="_blank"
          rel="noopener noreferrer"
        >
          Agendar
          <span class="icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #DACE97;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    --header-height: 96px;
  }

  .nav-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-4);
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .nav-logo {
    height: 100%;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    text-decoration: none;
    margin: 0;
    padding: 0;
  }

  .nav-logo:hover {
    text-decoration: none;
  }

  .nav-logo-img {
    height: 100%;
    width: auto;
    max-width: none;
    display: block;
    object-fit: contain;
    mix-blend-mode: multiply;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
  }

  .nav-link {
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    text-decoration: none;
    transition: color var(--transition-fast);
    padding: var(--space-2) 0;
    position: relative;
  }

  .nav-link:hover,
  .nav-link:focus {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width var(--transition-base);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    width: 100%;
  }

  .nav-link.is-active {
    color: var(--color-text-primary);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .nav-cta,
  .nav-cta-mobile {
    background: #000C1E;
    color: white;
    font-family: inherit;
    padding: 0.35em;
    padding-left: 1.2em;
    font-size: 17px;
    font-weight: 500;
    border-radius: 0.9em;
    border: none;
    letter-spacing: 0.05em;
    display: inline-flex;
    align-items: center;
    box-shadow: inset 0 0 1.6em -0.6em #00152E;
    overflow: hidden;
    position: relative;
    height: 2.8em;
    padding-right: 3.3em;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-cta:hover,
  .nav-cta-mobile:hover {
    text-decoration: none;
  }

  .nav-cta .icon,
  .nav-cta-mobile .icon {
    background: white;
    margin-left: 1em;
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 2.2em;
    width: 2.2em;
    border-radius: 0.7em;
    box-shadow: 0.1em 0.1em 0.6em 0.2em #000C1E;
    right: 0.3em;
    transition: all 0.3s;
  }

  .nav-cta:hover .icon,
  .nav-cta-mobile:hover .icon {
    width: calc(100% - 0.6em);
  }

  .nav-cta .icon svg,
  .nav-cta-mobile .icon svg {
    width: 1.1em;
    transition: transform 0.3s;
    color: #000C1E;
  }

  .nav-cta:hover .icon svg,
  .nav-cta-mobile:hover .icon svg {
    transform: translateX(0.1em);
  }

  .nav-cta:active .icon,
  .nav-cta-mobile:active .icon {
    transform: scale(0.95);
  }

  .nav-cta-mobile {
    display: none;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
  }

  .nav-toggle-bar {
    width: 22px;
    height: 2px;
    background: var(--color-text-primary);
    border-radius: 1px;
    transition: all 0.25s ease;
  }

  @media (max-width: 640px) {
    .site-header {
      --header-height: 64px;
    }

    .nav-logo-img {
      max-width: 58vw;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-cta-mobile {
      display: inline-flex;
    }

    .nav-menu {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--color-background);
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-6);
      gap: var(--space-2);
      transform: translateX(100%);
      transition: transform var(--transition-base);
    }

    .nav-menu.is-open {
      transform: translateX(0);
    }

    .nav-menu li {
      width: 100%;
    }

    .nav-link {
      display: block;
      width: 100%;
      padding: var(--space-3) 0;
      font-size: var(--text-base);
    }

    .nav-cta {
      display: none;
    }
  }
</style>

<script>
  (function () {
    const toggle = document.querySelector(".nav-toggle");
    const menu = document.querySelector(".nav-menu");
    if (!toggle || !menu) return;

    toggle.addEventListener("click", () => {
      const isOpen = menu.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
    });

    menu.querySelectorAll(".nav-link, .nav-cta").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Abrir menú");
      });
    });
  })();
</script>
