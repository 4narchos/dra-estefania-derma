---
import { whatsappBaseUrl } from "../data/links.js";
import { getBaseUrl } from "../utils/baseUrl.js";
const base = getBaseUrl();

interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;

const navLinks = [
  { label: "Inicio", href: `${base}`, path: `${base}` },
  { label: "Acerca", href: `${base}acerca`, path: `${base}acerca` },
  { label: "Servicios", href: `${base}servicios`, path: `${base}servicios` },
  { label: "Contacto", href: `${base}contacto`, path: `${base}contacto` },
];

function isActive(linkPath: string): boolean {
  // Normalize paths for comparison
  const normalizedCurrent = currentPath.replace(/\/$/, "").replace(new RegExp(`^${base.replace(/\/$/, "")}`), "") || "/";
  const normalizedLink = linkPath.replace(/\/$/, "").replace(new RegExp(`^${base.replace(/\/$/, "")}`), "") || "/";

  if (normalizedLink === "/") {
    return normalizedCurrent === "/";
  }
  return normalizedCurrent.startsWith(normalizedLink);
}
---

<header class="site-header">
  <nav class="nav-container" aria-label="Navegación principal">
    <div class="nav-brand" aria-label="Logo">
      <a href={`${base}`} class="nav-brand-link">
        <img
          src={`${base}images/logo-icon-desktop.png`}
          srcset={`${base}images/logo-icon-mobile.png 96w, ${base}images/logo-icon-desktop.png 160w`}
          sizes="(max-width: 640px) 48px, 40px"
          alt=""
          class="nav-brand-icon"
          width="40"
          height="40"
          loading="eager"
        />
        <div class="nav-brand-text">
          <span class="nav-brand-title">Dra. Estefanía Borges</span>
          <span class="nav-brand-subtitle">DERMATÓLOGA</span>
        </div>
      </a>
    </div>

    <div class="nav-actions">
      <a
        href={`${whatsappBaseUrl}&utm_source=web&utm_medium=header&utm_campaign=agendar`}
        class="nav-cta-mobile"
        target="_blank"
        rel="noopener noreferrer"
      >
        <i aria-hidden="true" class="nav-cta-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M6 3a1 1 0 0 1 2 0v1h8V3a1 1 0 1 1 2 0v1h1a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1zM5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9zm2 3.5a1 1 0 1 1 2 0 1 1 0 0 1-2 0m4 0a1 1 0 1 1 2 0 1 1 0 0 1-2 0m5-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2M8 15a1 1 0 1 0 0 2 1 1 0 0 0 0-2m3 1a1 1 0 1 1 2 0 1 1 0 0 1-2 0m5-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2"/></svg>
        </i>
        <span>Agendar</span>
      </a>

      <button
        class="nav-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="nav-menu"
        type="button"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>

    <ul class="nav-menu" id="nav-menu" role="menubar">
      {navLinks.map((link) => (
        <li role="none">
          <a
            href={link.href}
            class:list={["nav-link", isActive(link.path) && "is-active"]}
            role="menuitem"
            aria-current={isActive(link.path) ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
      <li role="none">
        <a
          href={`${whatsappBaseUrl}&utm_source=web&utm_medium=header&utm_campaign=agendar`}
          class="nav-cta"
          role="menuitem"
          target="_blank"
          rel="noopener noreferrer"
        >
          <i aria-hidden="true" class="nav-cta-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path d="M6 3a1 1 0 0 1 2 0v1h8V3a1 1 0 1 1 2 0v1h1a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h1zM5 9v10a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V9zm2 3.5a1 1 0 1 1 2 0 1 1 0 0 1-2 0m4 0a1 1 0 1 1 2 0 1 1 0 0 1-2 0m5-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2M8 15a1 1 0 1 0 0 2 1 1 0 0 0 0-2m3 1a1 1 0 1 1 2 0 1 1 0 0 1-2 0m5-1a1 1 0 1 0 0 2 1 1 0 0 0 0-2"/></svg>
          </i>
          <span>Agendar</span>
        </a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #DACE97;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  .nav-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-4);
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-4);
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  .nav-brand-icon {
    display: block;
    width: 40px;
    height: 40px;
    object-fit: contain;
  }

  .nav-brand-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .nav-brand-title {
    font-family: 'Apple Chancery', 'Zapfino', cursive;
    font-size: 1.125rem;
    line-height: 1.1;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .nav-brand-subtitle {
    font-family: 'Optima', 'Segoe UI', sans-serif;
    font-weight: 700;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    line-height: 1;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    list-style: none;
    margin-left: auto;
  }

  .nav-link {
    color: var(--color-text-secondary);
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
    font-size: 1rem;
    font-weight: 450;
    line-height: 1.5;
    text-decoration: none;
    transition: color var(--transition-fast);
    padding: var(--space-2) var(--space-2);
    position: relative;
  }

  .nav-link:hover,
  .nav-link:focus {
    color: var(--color-text-primary);
    text-decoration: none;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    transition: width var(--transition-base);
  }

  .nav-link:hover::after,
  .nav-link.is-active::after {
    width: 100%;
  }

  .nav-link.is-active {
    color: var(--color-text-primary);
  }

  .nav-actions {
    display: none;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
  }

  .nav-cta,
  .nav-cta-mobile {
    background: #325C46;
    color: #fff;
    font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    border: none;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.625rem 1rem;
    cursor: pointer;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--transition-fast);
  }

  .nav-cta:hover,
  .nav-cta-mobile:hover {
    background: #264839;
    text-decoration: none;
  }

  .nav-cta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .nav-cta-icon svg {
    display: block;
    fill: currentColor;
  }

  .nav-cta-mobile {
    display: none;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: var(--space-2);
  }

  .nav-toggle-bar {
    width: 22px;
    height: 2px;
    background: var(--color-text-primary);
    border-radius: 1px;
    transition: all 0.25s ease;
  }

  @media (max-width: 640px) {
    .nav-brand-link {
      gap: var(--space-2);
    }

    .nav-brand-icon {
      width: 48px;
      height: 48px;
    }

    .nav-brand-title {
      font-size: 0.625rem;
    }

    .nav-brand-subtitle {
      font-size: 0.4375rem;
      letter-spacing: 0.08em;
    }

    .nav-actions {
      display: flex;
    }

    .nav-toggle {
      display: flex;
    }

    .nav-cta-mobile {
      display: inline-flex;
    }

    .nav-menu {
      position: fixed;
      top: var(--header-height);
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--color-background);
      flex-direction: column;
      align-items: flex-start;
      padding: var(--space-6);
      gap: var(--space-2);
      transform: translateX(100%);
      transition: transform var(--transition-base);
    }

    .nav-menu.is-open {
      transform: translateX(0);
    }

    .nav-menu li {
      width: 100%;
    }

    .nav-link {
      display: block;
      width: 100%;
      padding: var(--space-3) 0;
      font-size: var(--text-base);
    }

    .nav-cta {
      display: none;
    }
  }
</style>

<script>
  (function () {
    const toggle = document.querySelector(".nav-toggle");
    const menu = document.querySelector(".nav-menu");
    if (!toggle || !menu) return;

    toggle.addEventListener("click", () => {
      const isOpen = menu.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Cerrar menú" : "Abrir menú");
    });

    menu.querySelectorAll(".nav-link, .nav-cta").forEach((link) => {
      link.addEventListener("click", () => {
        menu.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Abrir menú");
      });
    });
  })();
</script>
