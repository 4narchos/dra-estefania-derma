---
import { Image } from "astro:assets";
import LocationWidgetMain from "./LocationWidgetMain.astro";
import { consultationPrice } from "../data/site.js";
import { getBaseUrl } from "../utils/baseUrl.js";
import evoeImg from "../assets/images/evoe.jpg";

interface Props {
  dark?: boolean;
}

const { dark = true } = Astro.props;
const base = getBaseUrl();
---

<div class:list={["faqs-preview", { "faqs-preview--light": !dark }]}>
  <div class="faqs-accordion">
    <div class="faqs-accordion-item">
      <h3 class="faqs-accordion-heading">
        <button
          type="button"
          class="faqs-accordion-trigger"
          aria-expanded="false"
          aria-controls="faqs-preview-panel-0"
          id="faqs-preview-trigger-0"
        >
          <span>¿Cuáles son los horarios de atención?</span>
          <span class="faqs-accordion-icon" aria-hidden="true">
            <span class="icon-bar icon-bar-h" />
            <span class="icon-bar icon-bar-v" />
          </span>
        </button>
      </h3>
      <div
        class="faqs-accordion-panel"
        id="faqs-preview-panel-0"
        role="region"
        aria-labelledby="faqs-preview-trigger-0"
      >
        <div class="faqs-accordion-body">
          <p>Atendemos de Martes a Sábado con cita previa, en los siguientes horarios:</p>
          <p>Martes, Jueves y Viernes 3:30 a 7:30 p. m.</p>
          <p>Miércoles de 10:00 a. m. a 1:30 p. m.</p>
          <p>Sábados 10:30 a. m. a 12:30 p. m.</p>
        </div>
      </div>
    </div>

    <div class="faqs-accordion-item">
      <h3 class="faqs-accordion-heading">
        <button
          type="button"
          class="faqs-accordion-trigger"
          aria-expanded="false"
          aria-controls="faqs-preview-panel-1"
          id="faqs-preview-trigger-1"
        >
          <span>¿Dónde está el consultorio?</span>
          <span class="faqs-accordion-icon" aria-hidden="true">
            <span class="icon-bar icon-bar-h" />
            <span class="icon-bar icon-bar-v" />
          </span>
        </button>
      </h3>
      <div
        class="faqs-accordion-panel"
        id="faqs-preview-panel-1"
        role="region"
        aria-labelledby="faqs-preview-trigger-1"
      >
        <div class="faqs-accordion-body">
          <LocationWidgetMain dark={dark} />
        </div>
      </div>
    </div>

    <div class="faqs-accordion-item">
      <h3 class="faqs-accordion-heading">
        <button
          type="button"
          class="faqs-accordion-trigger"
          aria-expanded="false"
          aria-controls="faqs-preview-panel-2"
          id="faqs-preview-trigger-2"
        >
          <span>¿Qué incluye la consulta?</span>
          <span class="faqs-accordion-icon" aria-hidden="true">
            <span class="icon-bar icon-bar-h" />
            <span class="icon-bar icon-bar-v" />
          </span>
        </button>
      </h3>
      <div
        class="faqs-accordion-panel"
        id="faqs-preview-panel-2"
        role="region"
        aria-labelledby="faqs-preview-trigger-2"
      >
        <div class="faqs-accordion-body">
          <p>La consulta incluye una valoración dermatológica especializada en donde identificamos las causas y factores desencadenantes de tu padecimiento e indicamos un tratamiento personalizado acorde a tus necesidades.</p>
        </div>
      </div>
    </div>

    <div class="faqs-accordion-item">
      <h3 class="faqs-accordion-heading">
        <button
          type="button"
          class="faqs-accordion-trigger"
          aria-expanded="false"
          aria-controls="faqs-preview-panel-3"
          id="faqs-preview-trigger-3"
        >
          <span>¿Cuánto vale la consulta?</span>
          <span class="faqs-accordion-icon" aria-hidden="true">
            <span class="icon-bar icon-bar-h" />
            <span class="icon-bar icon-bar-v" />
          </span>
        </button>
      </h3>
      <div
        class="faqs-accordion-panel"
        id="faqs-preview-panel-3"
        role="region"
        aria-labelledby="faqs-preview-trigger-3"
      >
        <div class="faqs-accordion-body">
          <p>La consulta dermatológica tiene un valor de {consultationPrice}.</p>
        </div>
      </div>
    </div>

    <div class="faqs-accordion-item">
      <h3 class="faqs-accordion-heading">
        <button
          type="button"
          class="faqs-accordion-trigger"
          aria-expanded="false"
          aria-controls="faqs-preview-panel-4"
          id="faqs-preview-trigger-4"
        >
          <span>¿Qué servicios manejan?</span>
          <span class="faqs-accordion-icon" aria-hidden="true">
            <span class="icon-bar icon-bar-h" />
            <span class="icon-bar icon-bar-v" />
          </span>
        </button>
      </h3>
      <div
        class="faqs-accordion-panel"
        id="faqs-preview-panel-4"
        role="region"
        aria-labelledby="faqs-preview-trigger-4"
      >
        <div class="faqs-accordion-body">
          <p>Contamos con servicio de dermatología clínica, tricología, dermatología estética, aparatología y dermatología quirúrgica.</p>
          <p>
            <a href={`${base}servicios`} class="faqs-body-link">Ver todos los servicios</a>
          </p>
        </div>
      </div>
    </div>

    <div class="faqs-accordion-item">
      <h3 class="faqs-accordion-heading">
        <button
          type="button"
          class="faqs-accordion-trigger"
          aria-expanded="false"
          aria-controls="faqs-preview-panel-5"
          id="faqs-preview-trigger-5"
        >
          <span>¿Cómo es la clínica?</span>
          <span class="faqs-accordion-icon" aria-hidden="true">
            <span class="icon-bar icon-bar-h" />
            <span class="icon-bar icon-bar-v" />
          </span>
        </button>
      </h3>
      <div
        class="faqs-accordion-panel"
        id="faqs-preview-panel-5"
        role="region"
        aria-labelledby="faqs-preview-trigger-5"
      >
        <div class="faqs-accordion-body">
          <div class="faqs-clinic-image">
            <Image
              src={evoeImg}
              alt="Clínica especializada en Dermatología"
              width={600}
              height={400}
              densities={[1, 2]}
              loading="lazy"
              decoding="async"
            />
          </div>
          <p>Clínica especializada en Dermatología, con instalaciones modernas y aparatos de vanguardia.</p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const container = document.querySelector(".faqs-preview");
    if (!container) return;

    const items = container.querySelectorAll(".faqs-accordion-item");

    const openItem = (target) => {
      items.forEach((i) => {
        i.classList.remove("is-open");
        const btn = i.querySelector(".faqs-accordion-trigger");
        btn.setAttribute("aria-expanded", "false");
      });

      target.classList.add("is-open");
      const trigger = target.querySelector(".faqs-accordion-trigger");
      trigger.setAttribute("aria-expanded", "true");
    };

    items.forEach((item) => {
      const trigger = item.querySelector(".faqs-accordion-trigger");

      trigger.addEventListener("click", () => {
        if (item.classList.contains("is-open")) {
          item.classList.remove("is-open");
          trigger.setAttribute("aria-expanded", "false");
        } else {
          openItem(item);
        }
      });

      if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
        item.addEventListener("mouseenter", () => openItem(item));
      }
    });
  })();
</script>

<style>
  .faqs-preview .faqs-accordion {
    border-top: 1px solid var(--color-border-inverse);
  }

  .faqs-preview .faqs-accordion-item {
    border-bottom: 1px solid var(--color-border-inverse);
  }

  .faqs-preview .faqs-accordion-heading {
    margin: 0;
    font-size: inherit;
    font-weight: inherit;
  }

  .faqs-preview .faqs-accordion-trigger {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) 0;
    background: transparent;
    border: none;
    color: var(--color-text-on-dark);
    font-family: var(--font-body);
    font-size: var(--text-lg);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    text-align: left;
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .faqs-preview .faqs-accordion-trigger:hover {
    color: var(--color-accent);
  }

  .faqs-preview .faqs-accordion-trigger:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
    border-radius: var(--radius-md);
  }

  .faqs-preview .faqs-accordion-icon {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .faqs-preview .icon-bar {
    position: absolute;
    background: currentColor;
    transition: transform var(--transition-base);
  }

  .faqs-preview .icon-bar-h {
    width: 100%;
    height: 2px;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
  }

  .faqs-preview .icon-bar-v {
    width: 2px;
    height: 100%;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
  }

  .faqs-preview .faqs-accordion-item.is-open .icon-bar-v {
    transform: translateX(-50%) scaleY(0);
  }

  .faqs-preview .faqs-accordion-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--transition-base);
  }

  .faqs-preview .faqs-accordion-item.is-open .faqs-accordion-panel {
    grid-template-rows: 1fr;
  }

  .faqs-preview .faqs-accordion-body {
    overflow: hidden;
  }

  .faqs-preview .faqs-accordion-body p {
    padding-bottom: var(--space-5);
    color: rgba(245, 245, 240, 0.8);
    line-height: var(--leading-relaxed);
    min-height: 1.5em;
  }

  .faqs-preview .faqs-accordion-body p:last-child {
    padding-bottom: 0;
  }

  .faqs-preview .faqs-body-link {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .faqs-preview .faqs-body-link:hover {
    color: #fff;
  }

  .faqs-clinic-image {
    margin-bottom: var(--space-3);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .faqs-clinic-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 640px) {
    .faqs-preview .faqs-accordion-trigger {
      font-size: var(--text-base);
      padding: var(--space-4) 0;
    }
  }

  /* Light variant for light backgrounds */
  .faqs-preview--light .faqs-accordion {
    border-top-color: #E6E3DB;
  }

  .faqs-preview--light .faqs-accordion-item {
    border-bottom-color: #E6E3DB;
  }

  .faqs-preview--light .faqs-accordion-trigger {
    color: var(--color-text-primary);
  }

  .faqs-preview--light .faqs-accordion-trigger:hover {
    color: var(--color-primary);
  }

  .faqs-preview--light .faqs-accordion-body p {
    color: var(--color-text-secondary);
  }

  .faqs-preview--light .faqs-body-link {
    color: var(--color-primary);
  }

  .faqs-preview--light .faqs-body-link:hover {
    color: var(--color-primary-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .faqs-preview .faqs-accordion-panel,
    .faqs-preview .icon-bar,
    .faqs-preview .faqs-accordion-trigger {
      transition: none;
    }
  }
</style>
