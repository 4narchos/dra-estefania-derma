---
import MapWidget from "./MapWidget.astro";
import { googleMapsEmbedSrc, mapsLinkMain, mainAddress } from "../data/site.js";

interface Props {
  src?: string;
  title?: string;
  compact?: boolean;
  href?: string;
  address?: string;
  dark?: boolean;
}

const {
  src = googleMapsEmbedSrc,
  title = "Ubicación del consultorio",
  compact = true,
  href = mapsLinkMain,
  address = mainAddress,
  dark = false,
} = Astro.props;
---

<div class:list={["location-widget-main", { "location-widget-main--dark": dark }]}>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Ver dirección en Google Maps"
    class="location-widget-address-link"
  >
    <p class="location-widget-address">{address}</p>
  </a>
  <a
    href={href}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Ver ubicación en Google Maps"
    class="location-widget-main-link"
  >
    <MapWidget {src} {title} {compact} />
  </a>
</div>

<style>
  .location-widget-main {
    margin-top: var(--space-2);
  }

  .location-widget-address {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: inherit;
    margin: 0 0 var(--space-3);
    text-align: center;
  }

  .location-widget-address-link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .location-widget-address-link:hover .location-widget-address {
    text-decoration: underline;
  }

  .location-widget-main--dark .location-widget-address {
    color: var(--color-text-on-dark);
  }

  .location-widget-main-link {
    display: block;
    text-decoration: none;
  }

  .location-widget-main-link:hover .map-widget {
    box-shadow: 0 0 0 2px var(--color-primary);
  }
</style>
