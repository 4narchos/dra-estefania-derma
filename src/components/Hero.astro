---
import { whatsappBaseUrl } from "../data/links.js";
const base = import.meta.env.BASE_URL || "/";

const whatsappUrl = `${whatsappBaseUrl}&utm_source=web&utm_medium=hero_button&utm_campaign=inicio`;
---

<section class="hero" id="inicio">
  <div class="hero-content">
    <span class="hero-badge">Tu piel te habla. Yo te ayudo a entenderla.</span>
    <h1 class="hero-title">
      Dra. Mariana Estefanía<br />
      <span class="hero-accent">García Borges</span>
    </h1>
    <p class="hero-subtitle">Dermatóloga en Mérida, Izamal, Valladolid y Vaca</p>
    <p class="hero-description">
      Especialista en dermatología clínica, estética y quirúrgica.
      Formación de vanguardia del Instituto Dermatológico de Jalisco (2026).
    </p>
    <div class="hero-actions">
      <a href={whatsappUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
        Agendar consulta por WhatsApp
      </a>
      <a href={`${base}#servicios`} class="btn btn-secondary">Ver servicios</a>
    </div>
  </div>
  <div class="hero-image">
    <div class="hero-photo-placeholder">
      <span>Foto Dra. Estefanía</span>
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    padding: var(--space-16) var(--space-6);
    max-width: var(--max-width);
    margin: 0 auto;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      padding: var(--space-20) var(--space-6);
    }
  }

  .hero-badge {
    display: inline-block;
    background: var(--color-accent);
    color: var(--color-text-on-accent);
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    margin-bottom: var(--space-6);
  }

  .hero-title {
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .hero-accent {
    color: var(--color-primary);
  }

  .hero-subtitle {
    font-size: var(--text-xl);
    color: var(--color-primary);
    font-weight: var(--weight-semibold);
    margin-bottom: var(--space-3);
  }

  .hero-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
    max-width: 32rem;
    line-height: var(--leading-relaxed);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero-photo-placeholder {
    width: 100%;
    aspect-ratio: 3/4;
    max-width: 400px;
    margin: 0 auto;
    background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-verde) 100%);
    border-radius: var(--radius-lg);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-size: var(--text-lg);
    border: 1px solid var(--color-border);
  }
</style>
