---
import { Image } from "astro:assets";

import heroAlopecia from "../assets/images/hero-alopecia.webp";
import heroCaspa from "../assets/images/hero-caspa.webp";
import heroMelasma from "../assets/images/hero-melasma.webp";
import heroAcne from "../assets/images/hero-acne.webp";
import heroArrugas from "../assets/images/hero-arrugas.webp";

import heroAlopeciaMobile from "../assets/images/hero-alopecia-mobile.webp";
import heroMelasmaMobile from "../assets/images/hero-melasma-mobile.webp";
import heroCaspaMobile from "../assets/images/hero-caspa-mobile.webp";
import heroArrugasMobile from "../assets/images/hero-arrugas-mobile.webp";
import heroAcneMobile from "../assets/images/hero-acne-mobile.webp";
import heroRosaceaMobile from "../assets/images/hero-rosacea-mobile.webp";

const conditions = [
  { label: "Caída de cabello", image: heroAlopecia },
  { label: "Caspa", image: heroCaspa },
  { label: "Melasma", image: heroMelasma },
  { label: "Acné", image: heroAcne },
  { label: "Arrugas", image: heroArrugas },
];

const mobileTop = [
  { label: "Caída de cabello", image: heroAlopeciaMobile },
  { label: "Melasma", image: heroMelasmaMobile },
  { label: "Caspa", image: heroCaspaMobile },
];

const mobileBottom = [
  { label: "Arrugas", image: heroArrugasMobile },
  { label: "Acné", image: heroAcneMobile },
  { label: "Rosácea", image: heroRosaceaMobile },
];
---

<section class="hero" id="inicio">
  <div class="hero-title-wrapper">
    <h1 class="hero-title">
      <span class="hero-title-line hero-title-line--1">
        <span class="hero-word">Tu</span>
        <span class="hero-word">piel</span>
      </span>
      <span class="hero-title-line hero-title-line--2 hero-title-line--accent">
        <span class="hero-word">te</span>
        <span class="hero-word">habla</span>
      </span>
    </h1>
  </div>

  <div class="hero-collage-wrap">
    <div class="hero-collage hero-collage--desktop" aria-label="Condiciones dermatológicas tratadas">
      {conditions.map((condition, index) => (
        <div class={`collage-item collage-item--${index + 1}`}>
          <Image
            class="collage-image"
            src={condition.image}
            alt={condition.label}
            width={400}
            height={400}
            densities={[1, 2]}
            loading="eager"
            decoding="async"
          />
        </div>
      ))}
    </div>

    <div class="hero-collage hero-collage--mobile" aria-label="Condiciones dermatológicas tratadas">
      <div class="collage-row collage-row--top">
        {mobileTop.map((condition, index) => (
          <div class={`collage-item collage-item--${index === 1 ? "center" : "side"}`}>
            <Image
              class="collage-image"
              src={condition.image}
              alt={condition.label}
              width={300}
              height={300}
              loading="eager"
              decoding="async"
              fetchpriority={index === 1 ? "high" : "auto"}
            />
          </div>
        ))}
      </div>

      <div class="collage-row collage-row--bottom">
        {mobileBottom.map((condition, index) => (
          <div class={`collage-item collage-item--${index === 1 ? "center" : "side"}`}>
            <Image
              class="collage-image"
              src={condition.image}
              alt={condition.label}
              width={300}
              height={300}
              loading="eager"
              decoding="async"
              fetchpriority={index === 1 ? "high" : "auto"}
            />
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="mouse-btn" aria-hidden="true">
    <span class="mouse-scroll"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-midnight);
    color: var(--color-text-on-dark);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 20%, rgba(196, 184, 150, 0.12) 0%, transparent 45%),
      radial-gradient(circle at 85% 80%, rgba(45, 94, 70, 0.25) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-title-wrapper {
    position: relative;
    z-index: 10;
    text-align: center;
    pointer-events: none;
    margin-bottom: var(--space-8);
  }

  .hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(4rem, 15vw, 11rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    margin: 0;
  }

  .hero-title-line {
    display: block;
  }

  .hero-title-line--accent {
    font-style: italic;
    color: var(--color-accent);
  }

  .hero-word {
    display: inline-block;
    opacity: 0;
    filter: blur(10px);
    transform: scale(1.02);
  }

  html.is-loaded .hero-word {
    animation: hero-blur-in 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
  }

  html.is-loaded .hero-title-line--1 .hero-word:nth-child(1) { animation-delay: 0.2s; }
  html.is-loaded .hero-title-line--1 .hero-word:nth-child(2) { animation-delay: 0.35s; }

  html.is-loaded .hero-title-line--2 .hero-word:nth-child(1) { animation-delay: 1.0s; }
  html.is-loaded .hero-title-line--2 .hero-word:nth-child(2) { animation-delay: 1.15s; }

  @keyframes hero-blur-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: scale(1.02);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
  }

  .hero-collage-wrap {
    position: absolute;
    bottom: var(--space-2);
    left: 0;
    z-index: 1;
    display: flex;
    justify-content: center;
    width: 100%;
    padding-bottom: var(--space-8);
  }

  .hero-collage {
    position: relative;
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    perspective: 1200px;
  }

  .hero-collage--mobile {
    display: none;
  }

  .collage-item {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 -1.5%;
    transition: transform 0.5s ease, z-index 0s;
  }

  .collage-item--1,
  .collage-item--5 {
    width: 18%;
    min-width: 150px;
    z-index: 1;
    transform: scale(0.78);
    margin-bottom: 5%;
  }

  .collage-item--2,
  .collage-item--4 {
    width: 22%;
    min-width: 180px;
    z-index: 3;
    transform: scale(0.95);
    margin-bottom: 2.5%;
  }

  .collage-item--3 {
    width: 26%;
    min-width: 220px;
    z-index: 5;
    transform: scale(1.15);
    margin-bottom: 0;
  }

  .collage-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    object-fit: cover;
    display: block;
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.4);
    opacity: 0;
    transform: scale(0.88);
  }

  html.is-loaded .collage-image {
    animation: collage-image-enter 0.7s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
  }

  @keyframes collage-image-enter {
    from {
      opacity: 0;
      transform: scale(0.88);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Stagger de entrada: desde el centro hacia los lados */
  html.is-loaded .hero-collage--desktop .collage-item--3 .collage-image { animation-delay: 1.35s; }
  html.is-loaded .hero-collage--desktop .collage-item--2 .collage-image,
  html.is-loaded .hero-collage--desktop .collage-item--4 .collage-image { animation-delay: 1.48s; }
  html.is-loaded .hero-collage--desktop .collage-item--1 .collage-image,
  html.is-loaded .hero-collage--desktop .collage-item--5 .collage-image { animation-delay: 1.6s; }

  html.is-loaded .collage-row--top .collage-item--center .collage-image { animation-delay: 1.35s; }
  html.is-loaded .collage-row--bottom .collage-item--center .collage-image { animation-delay: 1.45s; }
  html.is-loaded .collage-row--top .collage-item--side:nth-child(1) .collage-image { animation-delay: 1.55s; }
  html.is-loaded .collage-row--top .collage-item--side:nth-child(3) .collage-image { animation-delay: 1.62s; }
  html.is-loaded .collage-row--bottom .collage-item--side:nth-child(1) .collage-image { animation-delay: 1.68s; }
  html.is-loaded .collage-row--bottom .collage-item--side:nth-child(3) .collage-image { animation-delay: 1.75s; }

  .mouse-btn {
    position: relative;
    z-index: 3;
    margin: 0 auto;
    width: 32px;
    height: 64px;
    border: 2px solid rgba(245, 245, 240, 0.55);
    border-radius: 16px;
    display: flex;
  }

  .mouse-scroll {
    display: block;
    width: 16px;
    height: 16px;
    background: linear-gradient(170deg, rgba(245, 245, 240, 0.7), rgba(245, 245, 240, 0.9));
    border-radius: 50%;
    margin: auto;
    animation: scrolling13 2.5s linear infinite;
  }

  @keyframes scrolling13 {
    0% {
      opacity: 0;
      transform: translateY(-16px);
    }
    100% {
      opacity: 1;
      transform: translateY(16px);
    }
  }

  @media (min-width: 769px) {
    .hero-title-wrapper {
      margin-bottom: 0;
      margin-top: -6vh;
      padding-bottom: var(--space-6);
    }
  }

  @media (min-width: 1440px) {
    .hero-stage {
      padding-bottom: 22%;
    }

    .collage-item {
      margin: 0 -1.2%;
    }

    .collage-item--1,
    .collage-item--5 {
      width: 18%;
      margin-bottom: 5%;
    }

    .collage-item--2,
    .collage-item--4 {
      width: 22%;
      margin-bottom: 2.5%;
    }

    .collage-item--3 {
      width: 26%;
    }
  }

  @media (max-width: 900px) {
    .hero-collage-wrap {
      padding-bottom: 6%;
    }

    .collage-item {
      margin: 0 -1.2%;
    }

    .collage-item--1,
    .collage-item--5 {
      width: 18%;
      min-width: 110px;
      margin-bottom: 5%;
    }

    .collage-item--2,
    .collage-item--4 {
      width: 22%;
      min-width: 140px;
      margin-bottom: 2.5%;
    }

    .collage-item--3 {
      width: 26%;
      min-width: 170px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: var(--viewport-minus-header);
      display: block;
    }

    .hero-title-wrapper {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0 var(--space-4);
      z-index: 10;
    }

    .hero-title {
      font-size: clamp(3.5rem, 15vw, 6.5rem);
      line-height: 1;
    }

    .mouse-btn {
      display: flex;
      position: absolute;
      bottom: var(--space-6);
      left: 50%;
      transform: translateX(-50%);
      z-index: 10;
      margin: 0;
    }

    .hero-collage-wrap {
      position: absolute;
      inset: var(--space-2);
      z-index: 1;
      padding: 0;
    }

    .hero-collage--desktop {
      display: none;
    }

    .hero-collage--mobile {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: clamp(3rem, 14vh, 7rem);
      width: 100%;
      height: 100%;
      padding: 0 var(--space-4);
    }

    .collage-row {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      width: 100%;
    }

    .hero-collage--mobile .collage-item {
      position: relative;
      width: 29vmin;
      height: 29vmin;
      min-width: 110px;
      min-height: 110px;
      max-width: 170px;
      max-height: 170px;
      margin: 0;
      flex: none;
      border-radius: 50%;
      transition: none;
    }

    .collage-item--empty {
      visibility: hidden;
    }

    /* Semiluna superior e inferior simétricas respecto al texto */
    .collage-row--top .collage-item--center {
      transform: translateY(-2.75rem);
    }

    .collage-row--top .collage-item--side {
      transform: translateY(-1rem);
    }

    .collage-row--bottom .collage-item--center {
      transform: translateY(2.75rem);
    }

    .collage-row--bottom .collage-item--side {
      transform: translateY(1rem);
    }

    .hero-collage--mobile .collage-image {
      width: 100%;
      height: 100%;
      aspect-ratio: 1 / 1;
      object-fit: cover;
      border-radius: 50%;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      animation: none;
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }

    .collage-image {
      animation: none;
      opacity: 1;
      transform: scale(1);
    }

    .mouse-scroll {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  (() => {
    const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const isMobile = window.matchMedia("(max-width: 768px)").matches;

    if (prefersReducedMotion || isMobile) return;

    // El texto y el collage tienen animación de entrada con CSS puro para evitar parpadeo.
    // GSAP solo se carga bajo demanda para el parallax del título en desktop.
    const loadParallax = async () => {
      const { gsap } = await import("../utils/animations.js");
      const hero = document.querySelector(".hero");
      if (!hero) return;

      gsap.to(".hero-title-wrapper", {
        scrollTrigger: {
          trigger: hero,
          start: "top top",
          end: "bottom top",
          scrub: true,
        },
        opacity: 0,
        scale: 0.98,
        y: -30,
        ease: "none",
      });
    };

    if ("IntersectionObserver" in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            obs.disconnect();
            loadParallax();
          }
        },
        { rootMargin: "0px", threshold: 0 }
      );
      obs.observe(document.querySelector(".hero"));
    } else {
      loadParallax();
    }

    // Indicador de scroll: animación CSS existente, sin depender de GSAP
    const mouseBtn = document.querySelector(".mouse-btn");
    if (mouseBtn) {
      mouseBtn.style.opacity = "0";
      const showMouseBtn = () => {
        mouseBtn.style.transition = "opacity 0.6s ease";
        mouseBtn.style.opacity = "1";
      };
      if (document.readyState === "complete") {
        setTimeout(showMouseBtn, 3000);
      } else {
        window.addEventListener("load", () => setTimeout(showMouseBtn, 3000));
      }
    }
  })();
</script>
