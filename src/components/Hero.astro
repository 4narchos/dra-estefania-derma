---
import { whatsappBaseUrl } from "../data/links.js";
import { getBaseUrl } from "../utils/baseUrl.js";
const base = getBaseUrl();

const whatsappUrl = `${whatsappBaseUrl}&utm_source=web&utm_medium=hero_button&utm_campaign=inicio`;
---

<section class="hero" id="inicio">
  <div class="hero-content">
    <p class="hero-lema">Tu piel te habla. Yo te ayudo a entenderla.</p>
    <h1 class="hero-title">
      Dra. Estefanía <span class="hero-accent">Borges</span>
    </h1>
    <p class="hero-subtitle">Dermatóloga en Yucatán</p>
    <div class="hero-actions">
      <a href={whatsappUrl} class="btn btn-primary" target="_blank" rel="noopener noreferrer">
        Agendar consulta
      </a>
      <a href={`${base}#servicios`} class="btn btn-secondary">Ver servicios</a>
    </div>
  </div>
  <div class="hero-image">
    <img
      src={`${base}images/dra-estefania.jpg`}
      alt="Dra. Mariana Estefanía García Borges — Dermatóloga"
      class="hero-photo"
      loading="eager"
      width="400"
      height="600"
    />
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    padding: var(--space-16) var(--space-6);
    max-width: var(--max-width);
    margin: 0 auto;
    align-items: center;
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 1fr 1fr;
      padding: var(--space-20) var(--space-6);
    }
  }

  .hero-lema {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(var(--text-3xl), 5vw, var(--text-5xl));
    font-weight: 600;
    color: var(--color-primary);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-6);
    letter-spacing: -0.02em;
  }

  .hero-title {
    font-size: clamp(var(--text-xl), 3vw, var(--text-2xl));
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .hero-accent {
    color: var(--color-primary);
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    font-weight: var(--weight-medium);
    margin-bottom: var(--space-8);
  }

  .hero-description {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
    max-width: 32rem;
    line-height: var(--leading-relaxed);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .hero-photo {
    width: 100%;
    aspect-ratio: 3/4;
    max-width: 400px;
    margin: 0 auto;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    display: block;
  }
</style>
