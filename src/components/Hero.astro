---
import { getBaseUrl } from "../utils/baseUrl.js";
const base = getBaseUrl();

const conditions = [
  { label: "Caída de cabello", image: `${base}images/hero-alopecia.jpg?v=1` },
  { label: "Caspa", image: `${base}images/hero-caspa.jpg?v=1` },
  { label: "Melasma", image: `${base}images/hero-melasma.jpg?v=1` },
  { label: "Acné", image: `${base}images/hero-acne.jpg?v=1` },
  { label: "Arrugas", image: `${base}images/hero-arrugas.jpg?v=1` },
];
---

<section class="hero" id="inicio">
  <div class="hero-stage">
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-title-line hero-title-line--1">
          <span class="hero-word">Tu</span>
          <span class="hero-word">piel</span>
        </span>
        <span class="hero-title-line hero-title-line--2 hero-title-line--accent">
          <span class="hero-word">te</span>
          <span class="hero-word">habla</span>
        </span>
      </h1>

      <div class="mouse-btn" aria-hidden="true">
        <span class="mouse-scroll"></span>
      </div>
    </div>
  </div>

  <div class="hero-collage-wrap">
    <div class="hero-collage" aria-label="Condiciones dermatológicas tratadas">
      {conditions.map((condition, index) => (
        <div class={`collage-item collage-item--${index + 1}`}>
          <img
            class="collage-image"
            src={condition.image}
            alt={condition.label}
            width="400"
            height="400"
            loading="eager"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-midnight);
    color: var(--color-text-on-dark);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 20%, rgba(196, 184, 150, 0.12) 0%, transparent 45%),
      radial-gradient(circle at 85% 80%, rgba(45, 94, 70, 0.25) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-stage {
    position: relative;
    z-index: 2;
    flex: 1;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: calc(var(--header-height) + var(--space-4)) var(--space-6) 300px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    text-align: center;
  }

  .hero-content {
    padding-top: var(--space-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(4rem, 15vw, 11rem);
    font-weight: 600;
    line-height: 0.88;
    letter-spacing: -0.05em;
    margin: 0;
  }

  .hero-title-line {
    display: block;
  }

  .hero-title-line--accent {
    font-style: italic;
    color: var(--color-accent);
  }

  .hero-word {
    display: inline-block;
    opacity: 0;
    filter: blur(10px);
    transform: scale(1.02);
    animation: hero-blur-in 0.6s cubic-bezier(0.25, 0.1, 0.25, 1) forwards;
  }

  .hero-title-line--1 .hero-word:nth-child(1) { animation-delay: 0.2s; }
  .hero-title-line--1 .hero-word:nth-child(2) { animation-delay: 0.35s; }

  .hero-title-line--2 .hero-word:nth-child(1) { animation-delay: 1.0s; }
  .hero-title-line--2 .hero-word:nth-child(2) { animation-delay: 1.15s; }

  @keyframes hero-blur-in {
    from {
      opacity: 0;
      filter: blur(10px);
      transform: scale(1.02);
    }
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
  }

  .hero-collage-wrap {
    position: absolute;
    bottom: var(--space-2);
    left: 0;
    z-index: 1;
    display: flex;
    justify-content: center;
    width: 100%;
    padding-bottom: var(--space-8);
  }

  .hero-collage {
    position: relative;
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    perspective: 1200px;
  }

  .collage-item {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0 -1.5%;
    transition: transform 0.5s ease, z-index 0s;
  }

  .collage-item--1,
  .collage-item--5 {
    width: 18%;
    min-width: 150px;
    z-index: 1;
    transform: scale(0.78);
    margin-bottom: 5%;
  }

  .collage-item--2,
  .collage-item--4 {
    width: 22%;
    min-width: 180px;
    z-index: 3;
    transform: scale(0.95);
    margin-bottom: 2.5%;
  }

  .collage-item--3 {
    width: 26%;
    min-width: 220px;
    z-index: 5;
    transform: scale(1.15);
    margin-bottom: 0;
  }

  .collage-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    object-fit: cover;
    display: block;
    box-shadow: 0 16px 50px rgba(0, 0, 0, 0.4);
  }

  @media (min-width: 1440px) {
    .hero-stage {
      padding-bottom: 22%;
    }

    .collage-item {
      margin: 0 -1.2%;
    }

    .collage-item--1,
    .collage-item--5 {
      width: 18%;
      margin-bottom: 5%;
    }

    .collage-item--2,
    .collage-item--4 {
      width: 22%;
      margin-bottom: 2.5%;
    }

    .collage-item--3 {
      width: 26%;
    }
  }

  @media (max-width: 900px) {
    .hero-stage {
      padding-bottom: 30%;
    }

    .collage-item {
      margin: 0 -1.2%;
    }

    .collage-item--1,
    .collage-item--5 {
      width: 18%;
      min-width: 110px;
      margin-bottom: 5%;
    }

    .collage-item--2,
    .collage-item--4 {
      width: 22%;
      min-width: 140px;
      margin-bottom: 2.5%;
    }

    .collage-item--3 {
      width: 26%;
      min-width: 170px;
    }
  }

  @media (max-width: 768px) {
    .hero {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      position: relative;
    }

    .hero-stage {
      position: relative;
      top: auto;
      left: auto;
      transform: none;
      z-index: 10;
      width: 100%;
      max-width: none;
      margin: 0;
      padding: 0 var(--space-4);
    }

    .hero-content {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 0;
      gap: 0;
    }

    .hero-title {
      width: 100%;
      padding: 0;
      text-align: center;
      line-height: 0.9;
    }

    .hero-word {
      animation: none;
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }

    .mouse-btn {
      display: none;
    }

    .mouse-scroll {
      animation: none;
      opacity: 1;
    }

    .hero-collage-wrap {
      position: absolute;
      inset: var(--space-2);
      z-index: 1;
      padding: 0;
    }

    .hero-collage {
      position: relative;
      width: 100%;
      height: 100%;
      padding: 0;
    }

    .collage-item {
      position: absolute;
      margin: 0;
      flex: none;
      transform-origin: center center;
      z-index: 1;
      transition: none;
    }

    .collage-item--1 {
      /* Alopecia - izquierda */
      top: 50%;
      left: 0;
      width: 20vmin;
      height: 20vmin;
      min-width: 76px;
      min-height: 76px;
      transform: translateY(-50%);
    }

    .collage-item--2 {
      /* Caspa - derecha */
      top: 50%;
      right: 0;
      width: 20vmin;
      height: 20vmin;
      min-width: 76px;
      min-height: 76px;
      transform: translateY(-50%);
    }

    .collage-item--3 {
      /* Melasma - arriba */
      top: 10%;
      left: 50%;
      width: 36vmin;
      height: 36vmin;
      min-width: 120px;
      min-height: 120px;
      transform: translateX(-50%);
    }

    .collage-item--4 {
      /* Acné - abajo izquierda */
      bottom: 12%;
      left: 10%;
      width: 34vmin;
      height: 34vmin;
      min-width: 110px;
      min-height: 110px;
    }

    .collage-item--5 {
      /* Arrugas - abajo derecha */
      bottom: 12%;
      right: 10%;
      width: 34vmin;
      height: 34vmin;
      min-width: 110px;
      min-height: 110px;
    }

    .collage-image {
      width: 100%;
      height: 100%;
      aspect-ratio: 1 / 1;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    }
  }

  @media (max-width: 380px) {
    .collage-image {
      border-radius: var(--radius-sm);
    }
  }

  .mouse-btn {
    position: relative;
    z-index: 3;
    margin: 0 auto;
    width: 32px;
    height: 64px;
    border: 2px solid rgba(245, 245, 240, 0.55);
    border-radius: 16px;
    display: flex;
  }

  .mouse-scroll {
    display: block;
    width: 16px;
    height: 16px;
    background: linear-gradient(170deg, rgba(245, 245, 240, 0.7), rgba(245, 245, 240, 0.9));
    border-radius: 50%;
    margin: auto;
    animation: scrolling13 2.5s linear infinite;
  }

  @keyframes scrolling13 {
    0% {
      opacity: 0;
      transform: translateY(-16px);
    }
    100% {
      opacity: 1;
      transform: translateY(16px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-word {
      animation: none;
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }

    .mouse-scroll {
      animation: none;
      opacity: 1;
    }
  }
</style>

<script>
  import { gsap } from "../utils/animations.js";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const isMobile = window.matchMedia("(max-width: 768px)").matches;
  if (!prefersReducedMotion && !isMobile) {
    const hero = document.querySelector(".hero");

    const entrance = gsap.timeline({ defaults: { ease: "power3.out" } });
    entrance
      .from(".hero-collage-wrap", { opacity: 0, y: 60, duration: 1 }, 0)
      .from(".collage-item", { opacity: 0, duration: 1, stagger: { each: 0.12, from: "center" } }, "<")
      .from(".mouse-btn", { opacity: 0, duration: 0.6 }, "+=2");

    gsap.to(".hero-stage", {
      scrollTrigger: {
        trigger: hero,
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
      opacity: 0,
      scale: 0.98,
      y: -30,
      ease: "none",
    });
  }
</script>
