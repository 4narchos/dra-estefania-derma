---
import { getBaseUrl } from "../utils/baseUrl.js";
const base = getBaseUrl();

const conditions = [
  { label: "Acné", image: `${base}images/hero-acne.png` },
  { label: "Caspa", image: `${base}images/hero-caspa.jpg` },
  { label: "Melasma", image: `${base}images/hero-melasma.png` },
  { label: "Caída de cabello", image: `${base}images/hero-alopecia.jpg` },
  { label: "Arrugas", image: `${base}images/hero-arrugas.jpg` },
];
---

<section class="hero" id="inicio">
  <div class="hero-stage">
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-title-line">Tu piel</span>
        <span class="hero-title-line hero-title-line--accent">te habla</span>
      </h1>
    </div>

    <div class="hero-collage" aria-label="Condiciones dermatológicas tratadas">
      {conditions.map((condition, index) => (
        <div class={`collage-item collage-item--${index + 1}`}>
          <img
            class="collage-image"
            src={condition.image}
            alt={condition.label}
            width="400"
            height="400"
            loading="eager"
          />
        </div>
      ))}
    </div>

    <div class="hero-scroll-hint" aria-hidden="true">
      <div class="hero-scroll-mouse">
        <div class="hero-scroll-wheel"></div>
      </div>
      <span class="hero-scroll-label">Sigue bajando</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-midnight);
    color: var(--color-text-on-dark);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 20%, rgba(196, 184, 150, 0.12) 0%, transparent 45%),
      radial-gradient(circle at 85% 80%, rgba(45, 94, 70, 0.25) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-stage {
    position: relative;
    z-index: 1;
    flex: 1;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: calc(var(--header-height) + var(--space-8)) var(--space-6) 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    text-align: center;
  }

  .hero-content {
    padding-top: var(--space-12);
  }

  .hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(4rem, 15vw, 11rem);
    font-weight: 600;
    line-height: 0.88;
    letter-spacing: -0.05em;
    margin: 0;
  }

  .hero-title-line {
    display: block;
  }

  .hero-title-line--accent {
    font-style: italic;
    color: var(--color-accent);
  }

  .hero-collage {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: flex-start;
    gap: var(--space-4);
    width: 100vw;
    max-width: none;
    margin-top: auto;
    padding-top: var(--space-8);
    padding-bottom: 0;
    position: relative;
    left: 50%;
    transform: translateX(-50%);
  }

  .collage-item {
    flex: 0 0 260px;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.3s ease;
  }

  /* Podio alignment using margin-top so GSAP y-animation does not fight it */
  .collage-item:nth-child(1),
  .collage-item:nth-child(5) {
    margin-top: 80px;
  }

  .collage-item:nth-child(2),
  .collage-item:nth-child(4) {
    margin-top: 40px;
  }

  .collage-item:nth-child(3) {
    margin-top: 0;
  }

  .collage-image {
    width: 260px;
    height: 260px;
    border-radius: var(--radius-md);
    object-fit: cover;
    display: block;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 1440px) {
    .hero-collage {
      gap: var(--space-6);
    }

    .collage-item {
      flex: 0 0 300px;
    }

    .collage-image {
      width: 300px;
      height: 300px;
    }

    .collage-item:nth-child(1),
    .collage-item:nth-child(5) {
      margin-top: 96px;
    }

    .collage-item:nth-child(2),
    .collage-item:nth-child(4) {
      margin-top: 48px;
    }
  }

  @media (max-width: 900px) {
    .collage-item {
      flex: 0 0 200px;
    }

    .collage-image {
      width: 200px;
      height: 200px;
    }

    .collage-item:nth-child(1),
    .collage-item:nth-child(2),
    .collage-item:nth-child(3),
    .collage-item:nth-child(4),
    .collage-item:nth-child(5) {
      margin-top: 0;
    }
  }

  @media (max-width: 768px) {
    .hero-stage {
      padding-bottom: calc(var(--space-8) + 40px);
    }

    .hero-collage {
      width: 100%;
      left: auto;
      transform: none;
      flex-wrap: wrap;
      gap: var(--space-4);
      padding-bottom: var(--space-4);
    }

    .collage-item {
      flex: 1 1 calc(33.333% - var(--space-4) * 2 / 3);
    }

    .collage-image {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
    }
  }

  @media (max-width: 380px) {
    .collage-image {
      border-radius: var(--radius-sm);
    }
  }

  .hero-scroll-hint {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    color: rgba(245, 245, 240, 0.55);
    z-index: 2;
    margin-top: var(--space-2);
  }

  .hero-scroll-mouse {
    width: 22px;
    height: 34px;
    border: 2px solid currentColor;
    border-radius: var(--radius-full);
    position: relative;
  }

  .hero-scroll-wheel {
    position: absolute;
    top: 7px;
    left: 50%;
    transform: translateX(-50%);
    width: 4px;
    height: 4px;
    background: currentColor;
    border-radius: var(--radius-full);
  }

  .hero-scroll-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
</style>

<script>
  import { gsap } from "../utils/animations.js";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!prefersReducedMotion) {
    const hero = document.querySelector(".hero");

    const entrance = gsap.timeline({ defaults: { ease: "power3.out" } });
    entrance
      .from(".hero-title-line", { y: 70, opacity: 0, duration: 1.1, stagger: 0.15 })
      .from(".hero-collage", { y: 60, duration: 1, clearProps: "transform" }, "-=0.8")
      .from(
        ".collage-item",
        { opacity: 0, duration: 1, stagger: 0.1, clearProps: "opacity" },
        "<"
      )
      .from(".hero-scroll-hint", { opacity: 0, duration: 0.6 }, "-=0.4");

    gsap.to(".hero-stage", {
      scrollTrigger: {
        trigger: hero,
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
      opacity: 0,
      scale: 0.98,
      y: -30,
      ease: "none",
    });
  }
</script>
