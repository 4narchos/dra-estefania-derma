---
import { getBaseUrl } from "../utils/baseUrl.js";
const base = getBaseUrl();

const conditions = [
  { label: "Acné", image: `${base}images/hero-acne.jpg?v=1` },
  { label: "Caspa", image: `${base}images/hero-caspa.jpg?v=1` },
  { label: "Melasma", image: `${base}images/hero-melasma.jpg?v=1` },
  { label: "Caída de cabello", image: `${base}images/hero-alopecia.jpg?v=1` },
  { label: "Arrugas", image: `${base}images/hero-arrugas.jpg?v=1` },
];
---

<section class="hero" id="inicio">
  <div class="hero-stage">
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-title-line">Tu piel</span>
        <span class="hero-title-line hero-title-line--accent">te habla</span>
      </h1>

      <div class="mouse-btn" aria-hidden="true">
        <span class="mouse-scroll"></span>
      </div>
    </div>
  </div>

  <div class="hero-collage" aria-label="Condiciones dermatológicas tratadas">
    {conditions.map((condition, index) => (
      <div class={`collage-item collage-item--${index + 1}`}>
        <img
          class="collage-image"
          src={condition.image}
          alt={condition.label}
          width="400"
          height="400"
          loading="eager"
        />
      </div>
    ))}
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--color-midnight);
    color: var(--color-text-on-dark);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 20%, rgba(196, 184, 150, 0.12) 0%, transparent 45%),
      radial-gradient(circle at 85% 80%, rgba(45, 94, 70, 0.25) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-stage {
    position: relative;
    z-index: 2;
    flex: 1;
    width: 100%;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: calc(var(--header-height) + var(--space-8)) var(--space-6) 340px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    text-align: center;
  }

  .hero-content {
    padding-top: var(--space-12);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-8);
  }

  .hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(4rem, 15vw, 11rem);
    font-weight: 600;
    line-height: 0.88;
    letter-spacing: -0.05em;
    margin: 0;
  }

  .hero-title-line {
    display: block;
  }

  .hero-title-line--accent {
    font-style: italic;
    color: var(--color-accent);
  }

  .hero-collage {
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 1;
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    align-items: flex-start;
    gap: var(--space-4);
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .collage-item {
    flex: 0 0 260px;
    display: flex;
    flex-direction: column;
    align-items: center;
    transition: transform 0.3s ease;
  }

  /* Podio alignment using margin-top so GSAP y-animation does not fight it */
  .collage-item:nth-child(1),
  .collage-item:nth-child(5) {
    margin-top: 80px;
  }

  .collage-item:nth-child(2),
  .collage-item:nth-child(4) {
    margin-top: 40px;
  }

  .collage-item:nth-child(3) {
    margin-top: 0;
  }

  .collage-image {
    width: 260px;
    height: 260px;
    border-radius: var(--radius-md);
    object-fit: cover;
    display: block;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
  }

  @media (min-width: 1440px) {
    .hero-stage {
      padding-bottom: 396px;
    }

    .hero-collage {
      gap: var(--space-6);
    }

    .collage-item {
      flex: 0 0 300px;
    }

    .collage-image {
      width: 300px;
      height: 300px;
    }

    .collage-item:nth-child(1),
    .collage-item:nth-child(5) {
      margin-top: 96px;
    }

    .collage-item:nth-child(2),
    .collage-item:nth-child(4) {
      margin-top: 48px;
    }
  }

  @media (max-width: 900px) {
    .hero-stage {
      padding-bottom: 220px;
    }

    .collage-item {
      flex: 0 0 200px;
    }

    .collage-image {
      width: 200px;
      height: 200px;
    }

    .collage-item:nth-child(1),
    .collage-item:nth-child(2),
    .collage-item:nth-child(3),
    .collage-item:nth-child(4),
    .collage-item:nth-child(5) {
      margin-top: 0;
    }
  }

  @media (max-width: 768px) {
    .hero-stage {
      padding-bottom: calc(var(--space-8) + 40px);
    }

    .hero-collage {
      position: relative;
      bottom: auto;
      left: auto;
      z-index: 1;
      flex-wrap: wrap;
      gap: var(--space-4);
      padding: var(--space-8) var(--space-6) var(--space-6);
    }

    .collage-item {
      flex: 1 1 calc(33.333% - var(--space-4) * 2 / 3);
    }

    .collage-image {
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
    }
  }

  @media (max-width: 380px) {
    .collage-image {
      border-radius: var(--radius-sm);
    }
  }

  .mouse-btn {
    margin: 0 auto;
    width: 40px;
    height: 80px;
    border: 3px solid rgba(245, 245, 240, 0.55);
    border-radius: 20px;
    display: flex;
  }

  .mouse-scroll {
    display: block;
    width: 20px;
    height: 20px;
    background: linear-gradient(170deg, rgba(245, 245, 240, 0.7), rgba(245, 245, 240, 0.9));
    border-radius: 50%;
    margin: auto;
    animation: scrolling13 2.5s linear infinite;
  }

  @keyframes scrolling13 {
    0% {
      opacity: 0;
      transform: translateY(-20px);
    }
    100% {
      opacity: 1;
      transform: translateY(20px);
    }
  }
</style>

<script>
  import { gsap } from "../utils/animations.js";

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (!prefersReducedMotion) {
    const hero = document.querySelector(".hero");

    const entrance = gsap.timeline({ defaults: { ease: "power3.out" } });
    entrance
      .from(".hero-title-line", { y: 70, opacity: 0, duration: 1.1, stagger: 0.15 })
      .from(".hero-collage", { y: 60, duration: 1, clearProps: "transform" }, "-=0.8")
      .from(
        ".collage-item",
        { opacity: 0, duration: 1, stagger: 0.1, clearProps: "opacity" },
        "<"
      )
      .from(".mouse-btn", { opacity: 0, duration: 0.6 }, "+=2");

    gsap.to(".hero-stage", {
      scrollTrigger: {
        trigger: hero,
        start: "top top",
        end: "bottom top",
        scrub: true,
      },
      opacity: 0,
      scale: 0.98,
      y: -30,
      ease: "none",
    });
  }
</script>
