---
import { Image } from "astro:assets";
import {
  agendaUrl,
  mapsLinkMain,
  mainAddressShort,
  consultationPrice,
} from "../data/site.js";

interface Props {
  imageSrc: ImageMetadata;
  imageAlt: string;
  title?: string;
  locationHref?: string;
  locationLabel?: string;
  price?: string;
  buttonText?: string;
  buttonHref?: string;
}

const {
  imageSrc,
  imageAlt,
  title = "Consulta dermatológica",
  locationHref = mapsLinkMain,
  locationLabel = mainAddressShort,
  price = consultationPrice,
  buttonText = "Agendar Ahora",
  buttonHref = agendaUrl,
} = Astro.props;
---

<div class="cta-card group">
  <a
    href={buttonHref}
    class="cta-card-main"
    target="_blank"
    rel="noopener noreferrer"
  >
    <Image
      src={imageSrc}
      alt={imageAlt}
      class="cta-card-img"
      width={220}
      height={220}
      densities={[1, 2]}
      loading="lazy"
      decoding="async"
    />
    <p class="cta-card-title">{title}</p>
  </a>

  <a
    href={locationHref}
    class="cta-card-subtitle"
    target="_blank"
    rel="noopener noreferrer"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="cta-card-location-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
      <circle cx="12" cy="10" r="3"></circle>
    </svg>
    {locationLabel}
  </a>

  <a
    href={buttonHref}
    class="cta-card-footer"
    target="_blank"
    rel="noopener noreferrer"
  >
    <p class="cta-card-price">{price}</p>
    <span class="cta-card-button">{buttonText}</span>
  </a>
</div>

<style>
  .cta-card {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin: 0.5rem;
    padding: 3rem;
    background: #1a2332;
    border-radius: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    z-index: 20;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 10px 10px -5px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .cta-card a {
    text-decoration: none;
  }

  .cta-card a.cta-card-subtitle {
    color: #ffffff;
  }

  .cta-card-main {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .cta-card::after {
    content: "";
    position: absolute;
    height: 100%;
    width: 100%;
    inset: 0;
    background: #243447;
    z-index: -20;
    border-radius: 0.75rem;
    transform: translateY(100%);
    transition: all 0.5s ease;
  }

  .cta-card-img {
    width: 220px;
    height: 220px;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 50%;
    display: block;
    transition: transform 0.3s ease;
  }

  .cta-card-title {
    font-weight: 600;
    color: #ffffff;
    letter-spacing: 0.05em;
    font-size: 1.5rem;
    margin: 0;
    transition: color 0.3s ease;
  }

  .cta-card-subtitle {
    font-weight: 600;
    color: #ffffff;
    font-size: 1rem;
    margin: 0;
    transition: color 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cta-card-location-icon {
    width: 1rem;
    height: 1rem;
    flex-shrink: 0;
  }

  .cta-card-footer {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    margin-top: 0.75rem;
    gap: 1rem;
  }

  .cta-card-price {
    color: #abd373;
    font-weight: 700;
    font-size: 1.125rem;
    margin: 0;
    transition: color 0.3s ease;
  }

  .cta-card-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #2D5E46;
    color: #ffffff;
    padding: 0.625rem 1.25rem;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.3s ease;
    white-space: nowrap;
  }

  @media (hover: hover) and (pointer: fine) {
    .cta-card:hover::after {
      transform: translateY(0);
    }

    .cta-card:hover .cta-card-img {
      transform: translateY(-0.25rem);
    }

    .cta-card:hover .cta-card-subtitle {
      color: #ffffff;
    }

    .cta-card:hover .cta-card-price {
      color: #ffffff;
    }

    .cta-card:hover .cta-card-button {
      background: #3a7a5a;
      color: #ffffff;
    }
  }

  @media (max-width: 767px) {
    .cta-card {
      width: auto;
      max-width: 340px;
      margin: 0;
      padding: 2rem 1.5rem;
      gap: 0.75rem;
    }

    .cta-card-img {
      width: 180px;
      height: 180px;
    }

    .cta-card-title {
      font-size: 1.25rem;
      text-align: center;
    }

    .cta-card-subtitle {
      font-size: 0.8125rem;
      text-align: center;
      white-space: nowrap;
    }

    .cta-card-footer {
      margin-top: 0.5rem;
      gap: 0.75rem;
    }

    .cta-card-price {
      font-size: 1rem;
      white-space: nowrap;
    }

    .cta-card-button {
      padding: 0.5rem 1rem;
      font-size: 0.875rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-card,
    .cta-card::after,
    .cta-card-img,
    .cta-card-title,
    .cta-card-subtitle,
    .cta-card-price,
    .cta-card-button {
      transition: none;
    }
  }
</style>
