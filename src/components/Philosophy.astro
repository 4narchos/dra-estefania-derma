---
const pillars = [
  {
    title: "CIENCIA",
    body: "Protocolos respaldados por la mejor evidencia científica para garantizar un tratamiento seguro y efectivo.",
  },
  {
    title: "EXPERIENCIA",
    body: "Años afinando el ojo clínico para entender tu piel y darte el tratamiento que tú necesitas.",
  },
  {
    title: "EXPECTATIVAS",
    body: "Te escucho para entender tus valores y tus preferencias. Juntos diseñamos un plan realista a tu medida.",
  },
];
---

<section class="philosophy" id="filosofia">
  <div class="container">
    <div class="philosophy-header">
      <h2 class="philosophy-title">
        <span class="philosophy-word">Creo</span>
        <span class="philosophy-word">en</span>
        <span class="philosophy-word">una</span>
        <span class="philosophy-word">dermatología</span>
        <span class="philosophy-word philosophy-word--accent">profesional</span>
        <span class="philosophy-word">y</span>
        <span class="philosophy-word philosophy-word--accent">humana</span>
      </h2>
    </div>

    <div class="philosophy-circles">
      <svg class="philosophy-connections" viewBox="-300 -300 600 600" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
        <path class="philosophy-connection" d="M -150 80 Q -90 25 -30 16" fill="none" stroke="#C4B896" stroke-width="2.5" stroke-linecap="round" opacity="0.5"></path>
        <path class="philosophy-connection" d="M 150 80 Q 90 25 30 16" fill="none" stroke="#C4B896" stroke-width="2.5" stroke-linecap="round" opacity="0.5"></path>
        <path class="philosophy-connection" d="M 0 -70 Q 0 -30 0 -16" fill="none" stroke="#C4B896" stroke-width="2.5" stroke-linecap="round" opacity="0.5"></path>
      </svg>

      {pillars.map((pillar, index) => {
        const styles = [
          { bg: "#152B52", text: "#FFFFFF", hover: "#1D3A6B", hoverText: "#FFFFFF" },
          { bg: "#2D5E46", text: "#FFFFFF", hover: "#3A7A5A", hoverText: "#FFFFFF" },
          { bg: "#C4B896", text: "#1A1A1A", hover: "#A8956E", hoverText: "#FFFFFF" },
        ][index];
        return (
          <article
            class="philosophy-circle"
            style={`--circle-bg: ${styles.bg}; --circle-text: ${styles.text}; --circle-hover: ${styles.hover}; --circle-hover-text: ${styles.hoverText};`}
            data-index={index}
          >
            <div class="philosophy-circle-inner">
              <h3 class="philosophy-circle-title">{pillar.title}</h3>
              <p class="philosophy-circle-body">{pillar.body}</p>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .philosophy {
    position: relative;
    padding: var(--space-20) 0 var(--space-12);
    background: #FFFFFF;
    color: #1A1A1A;
    overflow: hidden;
  }

  .container {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-6);
  }

  .philosophy-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 96px auto;
  }

  .philosophy-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(var(--text-4xl), 6vw, 4.5rem);
    font-weight: 600;
    color: #1A1A1A;
    line-height: var(--leading-tight);
    margin: 0;
    letter-spacing: -0.03em;
  }

  .philosophy-title-accent {
    display: block;
    font-family: 'Junicode', Georgia, serif;
    font-weight: 500;
    font-style: italic;
    color: var(--color-accent);
  }

  .philosophy-word {
    display: inline-block;
    opacity: 0;
    filter: blur(10px);
    transform: scale(1.02);
  }

  .philosophy-word--accent {
    font-family: 'Junicode', Georgia, serif;
    font-weight: 500;
    font-style: italic;
    color: var(--color-accent);
  }

  .philosophy-circles {
    position: relative;
    height: 680px;
    display: flex;
    justify-content: center;
    align-items: center;
    max-width: 1100px;
    margin: 0 auto;
  }

  .philosophy-connections {
    position: absolute;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    overflow: visible;
  }

  .philosophy-connection {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
  }

  .philosophy-circle {
    position: absolute;
    width: 330px;
    height: 330px;
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    background: var(--circle-bg);
    color: var(--circle-text);
    overflow: hidden;
    cursor: pointer;
    user-select: none;
    transition: color 0.5s ease-out, z-index 0s;
    will-change: transform;
    z-index: 2;
  }

  /* Efecto de expansión circular en hover (adaptado de Uiverse) */
  .philosophy-circle::before {
    content: '';
    position: absolute;
    top: -24px;
    right: -24px;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--circle-hover);
    transform: scale(1);
    transform-origin: 50% 50%;
    transition: transform 0.5s ease-out;
    z-index: 0;
  }

  .philosophy-circles .philosophy-circle:hover,
  .philosophy-circles .philosophy-circle.is-active {
    z-index: 100;
    color: var(--circle-hover-text);
  }

  .philosophy-circle:hover::before,
  .philosophy-circle.is-active::before {
    transform: scale(18);
  }

  .philosophy-circle-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: var(--space-8);
    transition: transform 0.35s ease;
  }

  .philosophy-circle:hover .philosophy-circle-inner,
  .philosophy-circle.is-active .philosophy-circle-inner {
    transform: scale(1.08);
  }

  .philosophy-circle-title {
    font-family: 'Junicode', Georgia, serif;
    font-size: var(--text-2xl);
    font-weight: 700;
    color: inherit;
    margin: 0;
    line-height: var(--leading-tight);
    transition: transform 0.35s ease;
  }

  .philosophy-circle-body {
    font-size: var(--text-sm);
    color: inherit;
    line-height: var(--leading-relaxed);
    margin: var(--space-3) 0 0;
    max-width: 220px;
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  /* Estado Venn: los contenidos permanecen visibles;
     al hacer hover el círculo se escala y sube al frente para leerse */

  /* En Venn los contenidos permanecen centrados;
     el hover escala y eleva el círculo activo */
  .philosophy-circles.is-venn .philosophy-circle[data-index="0"],
  .philosophy-circles.is-venn .philosophy-circle[data-index="1"] {
    z-index: 2;
  }

  .philosophy-circles.is-venn .philosophy-circle[data-index="2"] {
    z-index: 3;
  }

  /* En Venn el hover debe vencer los z-index base de cada círculo */
  .philosophy-circles.is-venn .philosophy-circle:hover,
  .philosophy-circles.is-venn .philosophy-circle.is-active {
    z-index: 100;
  }

  @media (prefers-reduced-motion: reduce) {
    .philosophy-circle,
    .philosophy-circle-inner,
    .philosophy-circle-title,
    .philosophy-circle-body {
      transition: none;
    }

    .philosophy-connection {
      transition: none;
    }
  }

  @media (max-width: 899px) {
    .philosophy {
      height: 100dvh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      padding: var(--space-6) 0;
    }

    .container {
      flex: 1;
      display: flex;
      flex-direction: column;
      width: 100%;
      margin: 0;
      padding: 0 var(--space-4);
    }

    .philosophy-header {
      padding: var(--space-10) 0 var(--space-4);
      margin-bottom: 0;
    }

    .philosophy-title {
      font-size: clamp(2.25rem, 9vw, 3.5rem);
    }

    .philosophy-circles {
      position: relative;
      width: 100%;
      max-width: 280px;
      height: 480px;
      margin: auto 0;
      align-self: center;
      display: block;
      overflow: visible;
    }

    .philosophy-connections {
      display: none;
    }

    .philosophy-circle {
      position: absolute;
      left: 50%;
      width: 240px;
      height: 240px;
      margin-left: -120px;
    }

    .philosophy-circle[data-index="0"] {
      top: 0;
      z-index: 1;
    }

    .philosophy-circle[data-index="1"] {
      top: 120px;
      z-index: 2;
    }

    .philosophy-circle[data-index="2"] {
      top: 240px;
      z-index: 3;
    }

    .philosophy-circle-inner {
      padding: var(--space-6);
    }

    .philosophy-circle-title {
      font-size: var(--text-xl);
    }

    .philosophy-circle-body {
      font-size: var(--text-xs);
      max-width: 160px;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from "../utils/animations.js";

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;
  const isMobile = window.matchMedia("(max-width: 899px)").matches;

  const circles = document.querySelectorAll(
    ".philosophy-circle"
  ) as NodeListOf<HTMLElement>;
  const circlesContainer = document.querySelector(".philosophy-circles");
  const connections = document.querySelectorAll(
    ".philosophy-connection"
  ) as NodeListOf<SVGPathElement>;
  const words = document.querySelectorAll(
    ".philosophy-word"
  ) as NodeListOf<HTMLElement>;

  // Tap para mostrar/ocultar descripción en móvil
  circles.forEach((circle) => {
    circle.addEventListener("click", () => {
      const isActive = circle.classList.contains("is-active");
      circles.forEach((c) => c.classList.remove("is-active"));
      if (!isActive) circle.classList.add("is-active");
    });
  });

  if (prefersReducedMotion) {
    gsap.set(words, { opacity: 1, filter: "blur(0px)", scale: 1 });
    gsap.set(circles, { opacity: 1, scale: 1 });
  } else {
    // Estado inicial del título
    gsap.set(words, { opacity: 0, filter: "blur(10px)", scale: 1.02 });

  // Timeline de entrada del título y círculos
  const entranceTl = gsap.timeline({ paused: true });

  // Texto base: "Creo en una dermatología"
  entranceTl
    .to(words[0], { opacity: 1, filter: "blur(0px)", scale: 1, duration: 0.6, ease: "power2.out" }, 0.1)
    .to(words[1], { opacity: 1, filter: "blur(0px)", scale: 1, duration: 0.6, ease: "power2.out" }, 0.2)
    .to(words[2], { opacity: 1, filter: "blur(0px)", scale: 1, duration: 0.6, ease: "power2.out" }, 0.3)
    .to(words[3], { opacity: 1, filter: "blur(0px)", scale: 1, duration: 0.6, ease: "power2.out" }, 0.4)
    // "profesional" + CIENCIA
    .to(words[4], { opacity: 1, filter: "blur(0px)", scale: 1, duration: 0.6, ease: "power2.out" }, 1.0)
    .to(circles[0], { opacity: 1, scale: 1, duration: 0.7, ease: "power2.out" }, 1.0)
    // "y"
    .to(words[5], { opacity: 1, filter: "blur(0px)", scale: 1, duration: 0.6, ease: "power2.out" }, 1.3)
    // EXPERIENCIA
    .to(circles[1], { opacity: 1, scale: 1, duration: 0.7, ease: "power2.out" }, 1.5)
    // "humana" + EXPECTATIVAS
    .to(words[6], { opacity: 1, filter: "blur(0px)", scale: 1, duration: 0.6, ease: "power2.out" }, 2.2)
    .to(circles[2], { opacity: 1, scale: 1, duration: 0.7, ease: "power2.out" }, 2.2);

  if (!isMobile && circles.length === 3 && circlesContainer) {
    // Estado inicial de los círculos en posiciones Venn
    gsap.set(circles[0], { x: -320, y: 180 });
    gsap.set(circles[1], { x: 320, y: 180 });
    gsap.set(circles[2], { x: 0, y: -180 });

    // Preparar trazos de conexión
    const connectionLengths = Array.from(connections).map((path) =>
      path.getTotalLength()
    );
    connections.forEach((path, i) => {
      path.style.strokeDasharray = `${connectionLengths[i]}`;
      path.style.strokeDashoffset = `${connectionLengths[i]}`;
    });

    // Timeline Venn: acercamiento a la posición final
    const vennTl = gsap.timeline({ paused: true });
    vennTl
      .to(
        circles[0],
        { x: -150, y: 80, rotation: 0, duration: 1.4, ease: "power2.inOut" },
        0
      )
      .to(
        circles[1],
        { x: 150, y: 80, rotation: 0, duration: 1.4, ease: "power2.inOut" },
        0
      )
      .to(
        circles[2],
        { x: 0, y: -70, rotation: 0, duration: 1.4, ease: "power2.inOut" },
        0
      )
      .add(() => circlesContainer.classList.add("is-venn"), 0.75)
      .to(
        connections,
        { strokeDashoffset: 0, duration: 1.4, ease: "power2.inOut" },
        0
      );

    // Timeline maestra: entrada + Venn
    const masterTl = gsap.timeline({ paused: true });
    masterTl.add(entranceTl).add(vennTl, "+=0.3");

    ScrollTrigger.create({
      trigger: ".philosophy",
      start: "top top",
      end: "+=80%",
      pin: true,
      scrub: false,
      anticipatePin: 1,
      onEnter: () => masterTl.play(),
      onEnterBack: () => masterTl.play(),
    });
  } else {
    // Mobile: círculos inician centrados y escalados
    gsap.set(circles, { x: 0, y: 0 });

    ScrollTrigger.create({
      trigger: ".philosophy",
      start: "top 80%",
      onEnter: () => entranceTl.play(),
    });
  }
  }
</script>
