---
import { Image } from "astro:assets";
import clinicImg from "../assets/images/clinic-2.webp";
import { getWhatsAppUrl, mapsLinkMain, doctoraliaUrl } from "../data/site.js";
import { getBaseUrl } from "../utils/baseUrl.js";
import CTACard from "./CTACard.astro";
import PillMenu from "./PillMenu.astro";
const base = getBaseUrl();

const menuItems = [
  { label: "Más ubicaciones", href: `${base}ubicaciones` },
  { label: "Enviar mensaje", href: getWhatsAppUrl({ medium: "contact_section" }), external: true },
  { label: "Preguntas", href: `${base}faqs` },
];
---

<div class="contact-content">
  <div class="contact-content-top">
    <CTACard
      imageSrc={clinicImg}
      imageAlt="Consultorio dermatológico en Mérida"
    />
  </div>

  <div class="contact-content-bottom">
    <PillMenu variant="contact" items={menuItems} ariaLabel="Acciones de contacto" />
  </div>
</div>

<style>
  .contact-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-6);
    width: 100%;
    height: 100%;
  }

  .contact-content-top {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .contact-content-bottom {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    background: transparent;
    border-top: none;
  }

  @media (max-width: 640px) {
    .contact-content {
      padding: var(--space-8) var(--space-5);
      gap: var(--space-3);
    }

    .contact-content-top,
    .contact-content-bottom {
      padding: 0;
    }
  }

  @media (max-width: 767px) {
    .contact-content {
      display: contents;
    }
  }
</style>
