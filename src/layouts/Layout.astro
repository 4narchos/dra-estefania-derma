---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppSticky from "../components/WhatsAppSticky.astro";
import ShareSticky from "../components/ShareSticky.astro";
import { faqs } from "../data/faq.js";
import { services } from "../data/services.js";
import { getBaseUrl } from "../utils/baseUrl.js";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  showWhatsApp?: boolean;
  showShare?: boolean;
  pageSchema?: "home" | "about" | "services" | "contact" | "none";
}

const {
  title,
  description = "Dra. Estefanía Borges - Dermatóloga en Mérida, Yucatán",
  ogImage,
  ogImageAlt = "Dra. Estefanía Borges - Dermatóloga en Mérida, Yucatán",
  showHeader = true,
  showFooter = true,
  showWhatsApp = true,
  showShare = true,
  pageSchema = "none",
} = Astro.props;

const baseUrl = getBaseUrl();
const siteUrl = "https://estefaniaderma.mx";
const canonicalPath = Astro.url.pathname.replace(new RegExp(`^${baseUrl.replace(/\/$/, '')}/?`), '/') || '/';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const ogImageUrl = ogImage ? `${siteUrl}${ogImage}` : `${siteUrl}/images/og-default-v5.jpg`;

// Global Open Graph metadata: same preview for every page
const globalOgTitle = "Dermatóloga en Mérida · Tu piel te habla, y yo te ayudo a entenderla ✨";
const globalOgDescription = "Enfermedades de la piel, el pelo y las uñas, dermatología estética y cirugía dermatológica menor";
const ogImageExt = ogImageUrl.split('.').pop()?.toLowerCase() || 'jpg';
const ogImageType = ogImageExt === 'png' ? 'image/png' : ogImageExt === 'webp' ? 'image/webp' : 'image/jpeg';

// Schemas for each page type
const physicianId = `${siteUrl}/#physician`;
const businessId = `${siteUrl}/#business`;

const physicianSchema = {
  "@context": "https://schema.org",
  "@type": "Physician",
  "@id": physicianId,
  "name": "Dra. Mariana Estefanía García Borges",
  "medicalSpecialty": "Dermatology",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "C. 20 No. 251, Calle 10 15-local 9, Morelos Oriente",
    "addressLocality": "Mérida",
    "addressRegion": "Yucatán",
    "postalCode": "97130",
    "addressCountry": "MX"
  },
  "telephone": "+52-999-221-3021",
  "url": siteUrl,
  "image": `${siteUrl}/images/dra-estefania.jpg`,
  "description": description,
  "priceRange": "$$",
  "paymentAccepted": ["Efectivo", "Tarjeta de crédito", "Tarjeta de débito"],
  "areaServed": [
    { "@type": "City", "name": "Mérida" },
    { "@type": "City", "name": "Izamal" },
    { "@type": "City", "name": "Valladolid" },
    { "@type": "City", "name": "Vaca" }
  ],
  "knowsLanguage": ["es", "en"],
  "sameAs": [
    "https://www.doctoralia.com.mx/mariana-estefania-garcia-borges-2/dermatologo/yucatan",
    "https://instagram.com/dra.estefaniaderma"
  ],
  "alumniOf": [
    { "@type": "EducationalOrganization", "name": "Universidad Autónoma de Yucatán" },
    { "@type": "EducationalOrganization", "name": "Instituto Dermatológico de Jalisco / UDG" }
  ],
  "worksFor": { "@id": businessId },
  "medicalCondition": [
    { "@type": "MedicalCondition", "name": "Acné" },
    { "@type": "MedicalCondition", "name": "Melasma" },
    { "@type": "MedicalCondition", "name": "Rosácea" },
    { "@type": "MedicalCondition", "name": "Queratosis pilar" },
    { "@type": "MedicalCondition", "name": "Alopecia" }
  ],
  "availableService": [
    { "@type": "MedicalProcedure", "name": "Tratamiento de acné" },
    { "@type": "MedicalProcedure", "name": "Tratamiento de melasma" },
    { "@type": "MedicalProcedure", "name": "Aplicación de Botox" },
    { "@type": "MedicalProcedure", "name": "Peeling químico" },
    { "@type": "MedicalProcedure", "name": "Hydrafacial" },
    { "@type": "MedicalProcedure", "name": "Depilación láser" },
    { "@type": "MedicalProcedure", "name": "Dermatoscopía" }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["MedicalBusiness", "LocalBusiness"],
  "@id": businessId,
  "name": "Evoke Aging Journey & Dermatology",
  "description": "Consultorio de dermatología en Mérida, Yucatán.",
  "url": siteUrl,
  "telephone": "+52-999-221-3021",
  "image": `${siteUrl}/images/dra-estefania.jpg`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "C. 20 No. 251, Calle 10 15-local 9, Morelos Oriente",
    "addressLocality": "Mérida",
    "addressRegion": "Yucatán",
    "postalCode": "97130",
    "addressCountry": "MX"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "21.020613550273655",
    "longitude": "-89.59418694315481"
  },
  "openingHours": ["Tu 16:00-19:30", "We 10:00-15:00", "Fr 16:00-19:30"],
  "priceRange": "$$",
  "paymentAccepted": ["Efectivo", "Tarjeta de crédito", "Tarjeta de débito"],
  "areaServed": { "@type": "City", "name": "Mérida" },
  "employee": { "@id": physicianId }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${siteUrl}/#faq`,
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
};

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "mainEntity": physicianSchema
};

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": title,
  "description": description,
  "url": canonicalUrl
};

const servicesListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${siteUrl}/servicios/#services`,
  "itemListElement": services.map((service, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "MedicalProcedure",
      "name": service.name,
      "description": service.description,
      "url": `${siteUrl}/servicios/#${service.slug}`
    }
  }))
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1D5A8F" />
    <link rel="icon" type="image/png" href={`${baseUrl}favicon.png`} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={globalOgTitle} />
    <meta property="og:description" content={globalOgDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Dra. Estefanía Borges" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:type" content={ogImageType} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="estefaniaderma.mx" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={globalOgTitle} />
    <meta name="twitter:description" content={globalOgDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

    <!-- Doctoralia widget resources -->
    <link rel="dns-prefetch" href="https://platform.docplanner.com" />
    <link rel="preconnect" href="https://www.doctoralia.com.mx" />
    <link rel="prefetch" href="https://platform.docplanner.com/js/widget.js" as="script" />

    <!-- Schema.org -->
    {(pageSchema === "home" || pageSchema === "about" || pageSchema === "services" || pageSchema === "contact") && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(physicianSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
      </>
    )}
    {pageSchema === "home" && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
    {pageSchema === "about" && (
      <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
    )}
    {pageSchema === "services" && (
      <script type="application/ld+json" set:html={JSON.stringify(servicesListSchema)} />
    )}
    {pageSchema === "contact" && (
      <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
    )}

    <title>{title}</title>

    <link rel="stylesheet" href={`${baseUrl}styles/tokens.css`} />

    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-size: 16px;
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-body);
        color: var(--color-text-primary);
        background: var(--color-background);
        line-height: var(--leading-normal);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: hidden;
      }

      main {
        flex: 1;
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      a {
        color: var(--color-primary);
        text-decoration: none;
      }

      a:hover {
        text-decoration: none;
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }

      /* Selection */
      ::selection {
        background: rgba(45, 94, 70, 0.2);
        color: var(--color-text-primary);
      }

      /* Focus visible */
      :focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: var(--space-3) var(--space-6);
        border-radius: var(--radius-md);
        font-weight: var(--weight-semibold);
        font-size: var(--text-base);
        transition: all var(--transition-fast);
        cursor: pointer;
        border: none;
        text-decoration: none;
      }

      .btn:hover {
        text-decoration: none;
      }

      .btn-primary {
        background: var(--color-primary);
        color: var(--color-text-on-primary);
      }

      .btn-primary:hover {
        background: var(--color-primary-hover);
      }

      .btn-secondary {
        background: transparent;
        color: var(--color-primary);
        border: 1px solid var(--color-border-strong);
      }

      .btn-secondary:hover {
        background: rgba(45, 94, 70, 0.06);
        border-color: var(--color-primary);
      }

      .btn-large {
        padding: var(--space-4) var(--space-8);
        font-size: var(--text-lg);
      }
    </style>

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {showHeader && <Header currentPath={Astro.url.pathname} />}
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}
    {showWhatsApp && <WhatsAppSticky />}
    {showShare && <ShareSticky />}
  </body>
</html>
