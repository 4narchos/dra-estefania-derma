---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppSticky from "../components/WhatsAppSticky.astro";
import ShareSticky from "../components/ShareSticky.astro";
import DoctoraliaModal from "../components/DoctoraliaModal.astro";
import { faqs } from "../data/faq.js";
import { services } from "../data/services.js";
import { socialLinks } from "../data/socialLinks.js";
import {
  numberMain,
  mainAddress,
  emailMain,
  doctoraliaUrl,
  googleProfile,
  mapsLinkMain,
} from "../data/site.js";
import { getBaseUrl } from "../utils/baseUrl.js";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  showWhatsApp?: boolean;
  showShare?: boolean;
  showPreloader?: boolean;
  pageSchema?: "home" | "about" | "services" | "contact" | "none";
  criticalPreloads?: Array<{
    href: string;
    as: string;
    type?: string;
    media?: string;
    fetchpriority?: string;
  }>;
}

const {
  title,
  description = "Dermatóloga en Mérida. Especialista en tricología, acné y dermatología estética. Tu salud con resultados estéticos y naturales. Agenda tu cita aquí.",
  ogImage,
  ogImageAlt = "Dra. Estefanía Borges - Dermatóloga en Mérida, Yucatán",
  showHeader = true,
  showFooter = true,
  showWhatsApp = true,
  showShare = true,
  showPreloader = false,
  pageSchema = "none",
  criticalPreloads = [],
} = Astro.props;

const baseUrl = getBaseUrl();
const siteUrl = "https://estefaniaderma.mx";
const canonicalPath = Astro.url.pathname.replace(new RegExp(`^${baseUrl.replace(/\/$/, '')}/?`), '/') || '/';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const ogImageUrl = ogImage ? `${siteUrl}${ogImage}` : `${siteUrl}/images/og-default-v6.jpg`;

// Global Open Graph metadata: same preview for every page
const globalOgTitle = "Dermatóloga en Mérida · Tu piel te habla, y yo te ayudo a entenderla ✨";
const globalOgDescription = "Dermatóloga en Mérida. Especialista en tricología, acné y dermatología estética. Tu salud con resultados estéticos y naturales.";
const ogImageExt = ogImageUrl.split('.').pop()?.toLowerCase() || 'jpg';
const ogImageType = ogImageExt === 'png' ? 'image/png' : ogImageExt === 'webp' ? 'image/webp' : 'image/jpeg';

// Schemas for each page type
const physicianId = `${siteUrl}/#physician`;
const businessId = `${siteUrl}/#business`;

const physicianSchema = {
  "@context": "https://schema.org",
  "@type": "Physician",
  "@id": physicianId,
  "name": "Dra. Mariana Estefanía García Borges",
  "medicalSpecialty": "Dermatology",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": mainAddress,
    "addressLocality": "Mérida",
    "addressRegion": "Yucatán",
    "postalCode": "97130",
    "addressCountry": "MX"
  },
  "telephone": `+52-${numberMain.replace(/\s/g, "")}`,
  "url": siteUrl,
  "image": `${siteUrl}/images/dra-estefania.jpg`,
  "description": description,
  "priceRange": "$$",
  "paymentAccepted": ["Efectivo", "Tarjeta de crédito", "Tarjeta de débito"],
  "areaServed": [
    { "@type": "City", "name": "Mérida" },
    { "@type": "City", "name": "Izamal" },
    { "@type": "City", "name": "Valladolid" },
    { "@type": "City", "name": "Baca" }
  ],
  "knowsLanguage": ["es", "en"],
  "sameAs": [
    doctoraliaUrl,
    googleProfile,
    ...socialLinks.filter((link) => link.active).map((link) => link.url)
  ],
  "alumniOf": [
    { "@type": "EducationalOrganization", "name": "Universidad Autónoma de Yucatán" },
    { "@type": "EducationalOrganization", "name": "Instituto Dermatológico de Jalisco / UDG" }
  ],
  "worksFor": { "@id": businessId },
  "medicalCondition": [
    { "@type": "MedicalCondition", "name": "Acné" },
    { "@type": "MedicalCondition", "name": "Melasma" },
    { "@type": "MedicalCondition", "name": "Rosácea" },
    { "@type": "MedicalCondition", "name": "Queratosis pilar" },
    { "@type": "MedicalCondition", "name": "Alopecia" }
  ],
  "availableService": [
    { "@type": "MedicalProcedure", "name": "Tratamiento de acné" },
    { "@type": "MedicalProcedure", "name": "Tratamiento de melasma" },
    { "@type": "MedicalProcedure", "name": "Aplicación de toxina botulínica" },
    { "@type": "MedicalProcedure", "name": "Peeling químico" },
    { "@type": "MedicalProcedure", "name": "Hydrafacial" },
    { "@type": "MedicalProcedure", "name": "Depilación láser" },
    { "@type": "MedicalProcedure", "name": "Dermatoscopía" }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["MedicalBusiness", "LocalBusiness"],
  "@id": businessId,
  "name": "Evoke Aging Journey & Dermatology",
  "description": "Consultorio de dermatología en Mérida, Yucatán.",
  "url": siteUrl,
  "telephone": `+52-${numberMain.replace(/\s/g, "")}`,
  "image": `${siteUrl}/images/dra-estefania.jpg`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": mainAddress,
    "addressLocality": "Mérida",
    "addressRegion": "Yucatán",
    "postalCode": "97130",
    "addressCountry": "MX"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "21.020613550273655",
    "longitude": "-89.59418694315481"
  },
  "openingHours": ["Tu 16:00-19:30", "We 10:00-15:00", "Fr 16:00-19:30"],
  "priceRange": "$$",
  "paymentAccepted": ["Efectivo", "Tarjeta de crédito", "Tarjeta de débito"],
  "areaServed": { "@type": "City", "name": "Mérida" },
  "employee": { "@id": physicianId }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${siteUrl}/#faq`,
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
};

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "mainEntity": physicianSchema
};

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": title,
  "description": description,
  "url": canonicalUrl
};

const servicesListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "@id": `${siteUrl}/servicios/#services`,
  "itemListElement": services.map((service, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": "MedicalProcedure",
      "name": service.name,
      "description": service.description,
      "url": `${siteUrl}/servicios/#${service.slug}`
    }
  }))
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1D5A8F" />
    <link rel="icon" type="image/png" sizes="192x192" href={`${siteUrl}/favicon.png`} />
    <link rel="shortcut icon" type="image/png" href={`${siteUrl}/favicon.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${siteUrl}/favicon.png`} />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={globalOgTitle} />
    <meta property="og:description" content={globalOgDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content="Dra. Estefanía Borges" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:type" content={ogImageType} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content="estefaniaderma.mx" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={globalOgTitle} />
    <meta name="twitter:description" content={globalOgDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Precargar fuentes críticas locales para evitar FOUT en el LCP -->
    <link
      rel="preload"
      href="/fonts/playfair-display/600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter/400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter/600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/junicode/JunicodeVF-Roman.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- Precargar recursos críticos above-the-fold (sólo si la página los define) -->
    {criticalPreloads.map((preload) => (
      <link
        rel="preload"
        href={preload.href}
        as={preload.as}
        type={preload.type}
        media={preload.media}
        fetchpriority={preload.fetchpriority}
        imagesrcset={preload.srcset}
        imagesizes={preload.sizes}
      />
    ))}

    <!-- Doctoralia widget resources (solo dns-prefetch; el script se carga bajo demanda) -->
    <link rel="dns-prefetch" href="https://platform.docplanner.com" />
    <link rel="dns-prefetch" href="https://www.doctoralia.com.mx" />
    <link rel="preconnect" href="https://www.doctoralia.com.mx" />

    <!-- Schema.org -->
    {(pageSchema === "home" || pageSchema === "about" || pageSchema === "services" || pageSchema === "contact") && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(physicianSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
      </>
    )}
    {pageSchema === "home" && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
    {pageSchema === "about" && (
      <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
    )}
    {pageSchema === "services" && (
      <script type="application/ld+json" set:html={JSON.stringify(servicesListSchema)} />
    )}
    {pageSchema === "contact" && (
      <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
    )}

    <title>{title}</title>

    <link rel="stylesheet" href={`${baseUrl}styles/tokens.css`} />

    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-size: 16px;
        scroll-behavior: smooth;
        overflow-x: clip;
        max-width: 100vw;
        --viewport-minus-header: calc(100dvh - var(--header-height, 72px));
      }

      @media (max-width: 768px) {
        :root {
          --header-height: 56px;
        }
      }

      body {
        font-family: var(--font-body);
        color: var(--color-text-primary);
        background: var(--color-background);
        line-height: var(--leading-normal);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        font-synthesis-weight: none;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        overflow-x: clip;
      }

      /* Evitar que cualquier sección desborde el viewport horizontalmente */
      main, section, header, footer {
        max-width: 100%;
        overflow-x: clip;
      }

      main {
        flex: 1;
        padding-top: var(--header-height);
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      a {
        color: var(--color-primary);
        text-decoration: none;
      }

      a:hover {
        text-decoration: none;
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }

      /* Selection */
      ::selection {
        background: rgba(45, 94, 70, 0.2);
        color: var(--color-text-primary);
      }

      /* Focus visible */
      :focus-visible {
        outline: 2px solid var(--color-primary);
        outline-offset: 2px;
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: var(--space-3) var(--space-6);
        border-radius: var(--radius-md);
        font-weight: var(--weight-semibold);
        font-size: var(--text-base);
        transition: all var(--transition-fast);
        cursor: pointer;
        border: none;
        text-decoration: none;
      }

      .btn:hover {
        text-decoration: none;
      }

      .btn-primary {
        background: var(--color-primary);
        color: var(--color-text-on-primary);
      }

      .btn-primary:hover {
        background: var(--color-primary-hover);
      }

      .btn-secondary {
        background: transparent;
        color: var(--color-primary);
        border: 1px solid var(--color-border-strong);
      }

      .btn-secondary:hover {
        background: rgba(45, 94, 70, 0.06);
        border-color: var(--color-primary);
      }

      .btn-large {
        padding: var(--space-4) var(--space-8);
        font-size: var(--text-lg);
      }
    </style>

    <style is:global>
      @font-face {
        font-family: 'Inter';
        src: url('/fonts/inter/400.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Inter';
        src: url('/fonts/inter/500.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Inter';
        src: url('/fonts/inter/600.woff2') format('woff2');
        font-weight: 600;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Inter';
        src: url('/fonts/inter/700.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Playfair Display';
        src: url('/fonts/playfair-display/400.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Playfair Display';
        src: url('/fonts/playfair-display/500.woff2') format('woff2');
        font-weight: 500;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Playfair Display';
        src: url('/fonts/playfair-display/600.woff2') format('woff2');
        font-weight: 600;
        font-style: normal;
        font-display: block;
      }
      @font-face {
        font-family: 'Playfair Display';
        src: url('/fonts/playfair-display/700.woff2') format('woff2');
        font-weight: 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Great Vibes';
        src: url('/fonts/great-vibes/400.woff2') format('woff2');
        font-weight: 400;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Junicode';
        src: url('/fonts/junicode/JunicodeVF-Roman.woff2') format('woff2');
        font-weight: 300 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: 'Junicode';
        src: url('/fonts/junicode/JunicodeVF-Italic.woff2') format('woff2');
        font-weight: 300 700;
        font-style: italic;
        font-display: swap;
      }
    </style>

    <style is:global>
      /* Preloader */
      .page-preloader {
        position: fixed;
        inset: 0;
        width: 100%;
        min-height: 100dvh;
        z-index: 9999;
        background: #000C1E;
        display: grid;
        place-items: center;
        transition: opacity 0.35s ease 0.2s, visibility 0s linear 0.55s;
      }

      .page-preloader__spinner {
        width: 40px;
        height: 40px;
        border: 3px solid rgba(245, 245, 240, 0.2);
        border-top-color: #C4B896;
        border-radius: 50%;
        animation: preloader-spin 1s linear infinite;
      }

      @keyframes preloader-spin {
        to { transform: rotate(360deg); }
      }

      html.is-loaded .page-preloader {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }

      html.is-preloading,
      html.is-preloading body {
        height: 100%;
        overflow: hidden;
      }

      /* Contenido se revela suavemente cuando el preloader termina */
      .page-wrapper {
        opacity: 0;
        transition: opacity 0.35s ease;
      }

      html.is-loaded .page-wrapper {
        opacity: 1;
      }

      @media (prefers-reduced-motion: reduce) {
        .page-preloader,
        .page-wrapper {
          transition: none;
        }
      }
    </style>

    <script is:inline define:vars={{ criticalPreloadsData: criticalPreloads, showPreloader }}>
      (function () {
        const html = document.documentElement;
        if (html.classList.contains('is-loaded') || html.classList.contains('is-preloading')) return;

        // Solo activar el preloader cuando la página lo pida explícitamente
        // (por ahora solo la homepage original con animaciones scrolly).
        if (!showPreloader) {
          html.classList.add('is-loaded');
          return;
        }

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) {
          html.classList.add('is-loaded');
          return;
        }

        html.classList.add('is-preloading');

        const promises = [];
        const perImageTimeout = 5000;
        const absoluteTimeout = 5500;

        // En la home, esperar a que el componente scrolly-driven mobile esté
        // completamente inicializado (GSAP + timeline + pines) antes de quitar
        // el preloader. Así la página es interactiva en cuanto desaparece el
        // spinner, no solo visible con fondos.
        const isHome = location.pathname === '/' || location.pathname === '/index.html';
        if (isHome) {
          promises.push(
            new Promise((resolve) => {
              window.__resolveScrollyReady = resolve;
            })
          );
        }

        // Esperar fuentes críticas
        if ('fonts' in document) {
          const criticalFonts = [
            { family: "'Playfair Display'", weight: '600' },
            { family: "'Great Vibes'", weight: '400' },
            { family: "'Inter'", weight: '400' },
            { family: "'Inter'", weight: '600' },
          ];
          criticalFonts.forEach((font) => {
            promises.push(document.fonts.load(font.weight + ' 16px ' + font.family).catch(() => {}));
          });
        }

        // Carga una imagen crítica con timeout individual, respetando srcset
        // para que el navegador descargue la densidad correcta (ej. 2x).
        function loadImage(item) {
          return new Promise((resolve) => {
            const timer = setTimeout(resolve, perImageTimeout);
            const img = new Image();
            img.onload = () => { clearTimeout(timer); resolve(); };
            img.onerror = () => { clearTimeout(timer); resolve(); };
            if (item.srcset) {
              img.srcset = item.srcset;
              img.sizes = item.sizes || '100vw';
            } else {
              img.src = item.href;
            }
          });
        }

        // Esperar imágenes críticas precargadas (respetando el media query)
        criticalPreloadsData.forEach((item) => {
          if (!item || !item.href || item.href.endsWith('.woff2')) return;
          if (item.media && !window.matchMedia(item.media).matches) return;
          promises.push(loadImage(item));
        });

        const timeout = new Promise((resolve) => setTimeout(resolve, absoluteTimeout));

        Promise.race([Promise.all(promises), timeout]).then(() => {
          requestAnimationFrame(() => {
            html.classList.remove('is-preloading');
            html.classList.add('is-loaded');
          });
        });
      })();
    </script>
  </head>
  <body>
    {showPreloader && (
      <div class="page-preloader" aria-hidden="true">
        <div class="page-preloader__spinner"></div>
      </div>
    )}

    <div class="page-wrapper">
      {showHeader && <Header currentPath={Astro.url.pathname} />}
      <main>
        <slot />
      </main>
      {showFooter && <Footer />}
      {showWhatsApp && <WhatsAppSticky />}
      {showShare && <ShareSticky />}
      <DoctoraliaModal />
    </div>
  </body>
</html>
