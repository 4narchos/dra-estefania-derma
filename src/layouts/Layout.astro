---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import WhatsAppSticky from "../components/WhatsAppSticky.astro";
import { faqs } from "../data/faq.js";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  showWhatsApp?: boolean;
  pageSchema?: "home" | "about" | "services" | "contact" | "none";
}

const {
  title,
  description = "Dra. Mariana Estefanía García Borges - Dermatóloga en Mérida, Yucatán",
  ogImage,
  showHeader = true,
  showFooter = true,
  showWhatsApp = true,
  pageSchema = "none",
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL || "/";
const siteUrl = "https://4narchos.github.io/dra-estefania-derma";
const canonicalUrl = `${siteUrl}${Astro.url.pathname.replace(baseUrl, "/")}`;
const ogImageUrl = ogImage ? `${siteUrl}${ogImage}` : `${siteUrl}/images/og-default.jpg`;

// Schemas for each page type
const physicianId = `${siteUrl}/#physician`;
const businessId = `${siteUrl}/#business`;

const physicianSchema = {
  "@context": "https://schema.org",
  "@type": "Physician",
  "@id": physicianId,
  "name": "Dra. Mariana Estefanía García Borges",
  "medicalSpecialty": "Dermatology",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "C. 20 No. 251, Calle 10 15-local 9, Morelos Oriente",
    "addressLocality": "Mérida",
    "addressRegion": "Yucatán",
    "postalCode": "97130",
    "addressCountry": "MX"
  },
  "telephone": "+52-999-221-3021",
  "url": siteUrl,
  "image": `${siteUrl}/images/dra-estefania.jpg`,
  "description": description,
  "priceRange": "$$",
  "paymentAccepted": ["Efectivo", "Tarjeta de crédito", "Tarjeta de débito"],
  "areaServed": [
    { "@type": "City", "name": "Mérida" },
    { "@type": "City", "name": "Izamal" },
    { "@type": "City", "name": "Valladolid" },
    { "@type": "City", "name": "Vaca" }
  ],
  "knowsLanguage": ["es", "en"],
  "sameAs": [
    "https://www.doctoralia.com.mx/mariana-estefania-garcia-borges-2/dermatologo/yucatan",
    "https://instagram.com/dra.estefaniaderma"
  ],
  "alumniOf": [
    { "@type": "EducationalOrganization", "name": "Universidad Autónoma de Yucatán" },
    { "@type": "EducationalOrganization", "name": "Instituto Dermatológico de Jalisco / UDG" }
  ],
  "worksFor": { "@id": businessId },
  "medicalCondition": [
    { "@type": "MedicalCondition", "name": "Acné" },
    { "@type": "MedicalCondition", "name": "Melasma" },
    { "@type": "MedicalCondition", "name": "Rosácea" },
    { "@type": "MedicalCondition", "name": "Queratosis pilar" },
    { "@type": "MedicalCondition", "name": "Alopecia" }
  ],
  "availableService": [
    { "@type": "MedicalProcedure", "name": "Tratamiento de acné" },
    { "@type": "MedicalProcedure", "name": "Tratamiento de melasma" },
    { "@type": "MedicalProcedure", "name": "Aplicación de Botox" },
    { "@type": "MedicalProcedure", "name": "Peeling químico" },
    { "@type": "MedicalProcedure", "name": "Hydrafacial" },
    { "@type": "MedicalProcedure", "name": "Depilación láser" },
    { "@type": "MedicalProcedure", "name": "Dermatoscopía" }
  ]
};

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["MedicalBusiness", "LocalBusiness"],
  "@id": businessId,
  "name": "Evoke Aging Journey & Dermatology",
  "description": "Consultorio de dermatología en Mérida, Yucatán.",
  "url": siteUrl,
  "telephone": "+52-999-221-3021",
  "image": `${siteUrl}/images/dra-estefania.jpg`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "C. 20 No. 251, Calle 10 15-local 9, Morelos Oriente",
    "addressLocality": "Mérida",
    "addressRegion": "Yucatán",
    "postalCode": "97130",
    "addressCountry": "MX"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "20.9674",
    "longitude": "-89.5926"
  },
  "openingHours": ["Tu 16:00-19:30", "We 10:00-15:00", "Fr 16:00-19:30"],
  "priceRange": "$$",
  "paymentAccepted": ["Efectivo", "Tarjeta de crédito", "Tarjeta de débito"],
  "areaServed": { "@type": "City", "name": "Mérida" },
  "employee": { "@id": physicianId }
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${siteUrl}/#faq`,
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer }
  }))
};

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": title,
  "description": description,
  "url": canonicalUrl,
  "mainEntity": physicianSchema
};

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": title,
  "description": description,
  "url": canonicalUrl
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2D5E46" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

    <!-- Schema.org -->
    {pageSchema === "home" && (
      <>
        <script type="application/ld+json" set:html={JSON.stringify(physicianSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
        <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
      </>
    )}
    {pageSchema === "about" && (
      <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
    )}
    {pageSchema === "contact" && (
      <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />
    )}

    <title>{title}</title>

    <link rel="stylesheet" href={`${baseUrl}styles/tokens.css`} />

    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-size: 16px;
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-body);
        color: var(--color-text-primary);
        background: var(--color-background);
        line-height: var(--leading-normal);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      main {
        flex: 1;
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      a {
        color: var(--color-accent);
        text-decoration: none;
      }

      a:hover {
        text-decoration: none;
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }

      /* Selection */
      ::selection {
        background: rgba(45, 94, 70, 0.4);
        color: var(--color-text-primary);
      }

      /* Focus visible */
      :focus-visible {
        outline: 2px solid var(--color-accent);
        outline-offset: 2px;
      }

      /* Buttons */
      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: var(--space-3) var(--space-6);
        border-radius: var(--radius-md);
        font-weight: var(--weight-semibold);
        font-size: var(--text-base);
        transition: all var(--transition-fast);
        cursor: pointer;
        border: none;
        text-decoration: none;
      }

      .btn:hover {
        text-decoration: none;
      }

      .btn-primary {
        background: var(--color-primary);
        color: var(--color-text-on-primary);
      }

      .btn-primary:hover {
        background: var(--color-primary-hover);
      }

      .btn-secondary {
        background: transparent;
        color: var(--color-accent);
        border: 1px solid var(--color-border-strong);
      }

      .btn-secondary:hover {
        background: rgba(216, 204, 155, 0.08);
        border-color: var(--color-accent);
      }

      .btn-large {
        padding: var(--space-4) var(--space-8);
        font-size: var(--text-lg);
      }
    </style>

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {showHeader && <Header />}
    <main>
      <slot />
    </main>
    {showFooter && <Footer />}
    {showWhatsApp && <WhatsAppSticky />}
  </body>
</html>
