const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": `${siteUrl}/#faq`,
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿Qué dermatóloga en Mérida atiende acné hormonal?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La Dra. Mariana Estefanía García Borges es especialista en dermatología en Mérida, Yucatán, con formación reciente (2026) del Instituto Dermatológico de Jalisco. Atiende acné, melasma, y otras condiciones de piel agravadas por el clima de Yucatán."
      }
    },
    {
      "@type": "Question",
      "name": "¿En dónde atiende la Dra. García Borges?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La Dra. García Borges atiende en 4 ubicaciones en Yucatán: (1) Evoke Aging Journey & Dermatology en Mérida — martes y viernes 4:00-7:30 p.m., miércoles 10:00 a.m.-3:00 p.m.; (2) Izamal — sábados (horarios variables); (3) Valladolid — sábados y domingos 10:00-16:00; (4) Vaca — sábados 9:30-16:00. Agenda tu cita por WhatsApp al 999 221 3021."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cuánto cuesta la primera consulta dermatológica en Mérida?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La primera consulta dermatológica con la Dra. García Borges tiene un costo accesible. Se recomienda contactar directamente por WhatsApp al 999 221 3021 para confirmar el precio actual y disponibilidad."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué es la queratosis pilar y cómo se trata en Mérida?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La queratosis pilar es una condición común donde la piel produce demasiada queratina, formando pequeños bultos ásperos. En el clima de Yucatán, la humedad puede agravarla. La Dra. García Borges ofrece tratamientos personalizados en Mérida para suavizar la textura de la piel."
      }
    },
    {
      "@type": "Question",
      "name": "¿Es seguro ponerse Botox en Mérida?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, la aplicación de Botox (toxina botulínica) es segura cuando la realiza un dermatólogo especialista. La Dra. García Borges, recién graduada del Instituto Dermatológico de Jalisco (2026), aplica los protocolos más actualizados en su consultorio de Mérida."
      }
    },
    {
      "@type": "Question",
      "name": "¿Cómo tratar el melasma en clima tropical como el de Yucatán?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El melasma se agrava con el sol intenso y la humedad del clima de Yucatán. El tratamiento incluye protector solar de amplio espectro, despigmentantes tópicos y procedimientos como peeling químico. La Dra. García Borges en Mérida diseña protocolos adaptados al clima local."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué dermatólogo en Mérida trata la alopecia o caída de cabello?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La Dra. Mariana Estefanía García Borges, dermatóloga en Mérida, ofrece evaluación y tratamiento para la alopecia y pérdida de cabello. El diagnóstico incluye dermatoscopía capilar para identificar la causa y definir el tratamiento adecuado."
      }
    },
    {
      "@type": "Question",
      "name": "¿La rosácea empeora con el calor y la humedad de Mérida?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, el calor extremo, la humedad alta y los cambios bruscos de temperatura (aire acondicionado a calor exterior) pueden desencadenar brotes de rosácea. En Mérida, es clave un plan de cuidado adaptado al clima local, que la Dra. García Borges personaliza para cada paciente."
      }
    },
    {
      "@type": "Question",
      "name": "¿Dónde puedo hacerme un Hydrafacial en Mérida?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "El Hydrafacial está disponible en el consultorio Evoke Aging Journey & Dermatology en Mérida, a cargo de la Dra. Mariana Estefanía García Borges. Es un tratamiento de limpieza facial profunda que hidrata y rejuvenece la piel."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué dermatólogo en Mérida habla inglés?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "La Dra. Mariana Estefanía García Borges atiende en español e inglés en su consultorio de dermatología en Mérida, Yucatán. Es ideal para pacientes locales y turistas de la Riviera Maya."
      }
    }
  ]
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1a5f4a" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:locale" content="es_MX" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Preconnect for performance -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="dns-prefetch" href="https://fonts.googleapis.com" />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(physicianSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

    <title>{title}</title>

    <style is:global>
      :root {
        --color-primary: #1a5f4a;
        --color-primary-dark: #124a39;
        --color-accent: #c9a96e;
        --color-bg: #fafaf9;
        --color-text: #1c1917;
        --color-text-muted: #78716c;
        --font-sans: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        --font-serif: Georgia, 'Times New Roman', serif;
      }

      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        font-size: 16px;
        scroll-behavior: smooth;
      }

      body {
        font-family: var(--font-sans);
        color: var(--color-text);
        background: var(--color-bg);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      img {
        max-width: 100%;
        height: auto;
        display: block;
      }

      a {
        color: var(--color-primary);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        html { scroll-behavior: auto; }
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
